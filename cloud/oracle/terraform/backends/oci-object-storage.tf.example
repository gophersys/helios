# -----------------------------------------------------------------------------
# Backend Configuration — OCI Object Storage
# -----------------------------------------------------------------------------
# Copy this file to the root as backend.tf and fill in values.
# Then run: terraform init -backend-config=backend.tf
# -----------------------------------------------------------------------------

terraform {
  backend "s3" {
    bucket   = "terraform-state"
    key      = "cloud/oracle/terraform.tfstate"
    region   = "us-phoenix-1"
    endpoint = "https://<namespace>.compat.objectstorage.<region>.oraclecloud.com"

    # OCI Object Storage uses S3-compatible API
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_requesting_account_id  = true
    use_path_style              = true
  }
}
