# -----------------------------------------------------------------------------
# Example terraform.tfvars — Copy to terraform.tfvars and fill in values
# -----------------------------------------------------------------------------
# All values can alternatively be set via TF_VAR_* environment variables.
# Example:  export TF_VAR_oci_tenancy_ocid="ocid1.tenancy.oc1..aaaa..."
# -----------------------------------------------------------------------------

# OCI Provider Credentials
oci_tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
oci_user_ocid        = "ocid1.user.oc1..aaaa..."
oci_fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
oci_private_key_path = "~/.oci/oci_api_key.pem"
oci_region           = "us-phoenix-1"
oci_compartment_ocid = "ocid1.compartment.oc1..aaaa..."

# Availability Domains
availability_domain_index         = 0
micro_availability_domain_indexes = [0, 1, 2]

# Cloudflare
cloudflare_api_token           = "your-cloudflare-api-token"
cloudflare_zone_id_codectl     = "your-codectl-dev-zone-id"
cloudflare_zone_id_mateosegura = "your-mateosegura-com-zone-id"

# Tailscale
tailscale_auth_key = "tskey-auth-..."

# Domains (defaults are fine for most cases)
# domain_codectl     = "codectl.dev"
# domain_mateosegura = "mateosegura.com"

# SSH Access — restrict to your IP in production
# ssh_allowed_cidrs = ["203.0.113.42/32"]

# Sizing overrides (defaults match the node spec)
# server_00_ocpus          = 2
# server_00_memory_gb      = 12
# server_00_boot_volume_gb = 50
# agent_00_ocpus           = 2
# agent_00_memory_gb       = 12
# agent_00_boot_volume_gb  = 50
# agent_01_ocpus           = 1
# agent_01_memory_gb       = 16
# agent_01_boot_volume_gb  = 50
# micro_boot_volume_gb     = 50
