{
  "name": "oracle",
  "targets": {
    "plan": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform plan",
        "cwd": "{projectRoot}/terraform"
      }
    },
    "apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "terraform apply",
        "cwd": "{projectRoot}/terraform"
      }
    },
    "configure": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ansible-playbook -i inventory site.yml",
        "cwd": "{projectRoot}/ansible"
      }
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bash {projectRoot}/scripts/bootstrap.sh"
        ]
      }
    }
  }
}
