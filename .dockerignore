# Keep the docker build context lean (the deploy/image Dockerfiles COPY the whole workspace so the
# go.work pins the sibling libs to in-repo source). Trim everything a Go build does not need — and
# NEVER ship a real env file into an image layer.
.git
**/node_modules
**/.svelte-kit
**/.nx
**/dist
**/build
**/test-results
**/playwright-report
docs/architecture/*.html
deploy/plane/local/.state

# SECRET SAFETY: never copy a real env file into a build context / image layer.
.env
.env.*
!.env.example
!.env.*.example
