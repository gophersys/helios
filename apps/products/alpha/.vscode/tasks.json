{
    "version": "2.0.0",
    "options": {
        "env": {
            // "APP_BOARD": "nucleo_h743zi"
            // "APP_BOARD": "nrf5340dk/nrf5340/cpuapp"
            "APP_BOARD": "theta_a0/nrf52840"
        }
    },
    "tasks": [
        {
            "label": "West Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "west",
            "args": [
                "build",
                "-p",
                "auto",
                "-b",
                "${APP_BOARD}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
        },
        {
            "label": "West Clean Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "west",
            "args": [
                "build",
                "-p",
                "always",
                "-b",
                "${APP_BOARD}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
        },
        {
            "label": "West Flash",
            "type": "shell",
            "command": "west",
            "args": [
                "flash",
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
    ],
}