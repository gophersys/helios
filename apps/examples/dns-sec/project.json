{
  "name": "motion-bed",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "west build -p always -b {args.board} ."
        ],
        "cwd": "embedded/cipher"
      }
    },
    "flash": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "west flash"
        ],
        "cwd": "embedded/cipher"
      }
    },
    "monitor": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "minicom -D {args.dev} -b 115200"
        ],
        "cwd": "embedded/cipher"
      }
    }
  }
}
