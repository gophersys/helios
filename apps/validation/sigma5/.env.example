# Sigma5 Validation Environment Variables

# MTIB Connection
MTIB_HOST=10.4.45.34
MTIB_PORT=50053

# Device Identity
DEVICE_ID=
DEVICE_SNR=
DEVICE_IMEI=
DEVICE_ICCIDS=

# Fixture Profile
FIXTURE_PROFILE_PATH=fixtures/sigma5_c0.json

# Firmware Paths (on MTIB or local)
FW_DEBUG_HEX=
FW_RELEASE_HEX=
FW_DEBUG_COMMS_HEX=
FW_RELEASE_COMMS_HEX=
FW_MODEM_ZIP=

# CoreCloud Database (DEV_1_0 or VAL_1_0 namespace)
CORECLOUD_DB_ENV=VAL_1_0

# Mock Mode (set to 1 for offline testing)
MOCK_CLOUD=0

# Test Artifacts
ARTIFACTS_DIR=/tmp/sigma5_artifacts

# Concord Reporter (optional - for CI integration)
# CONCORD_RUN_ID=
# CONCORD_API_URL=http://concord-api:9001
# CONCORD_API_KEY=
