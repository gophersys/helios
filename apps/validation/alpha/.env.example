# =============================================================================
# Concord Validation Alpha — Environment Variables
# =============================================================================
# Copy to .env and fill in values. Or export directly before running pytest.
#
# Usage:
#   cd apps/validation/alpha
#   PYTHONPATH=../../libs/python:../../libs:../../libs/protocols pytest -v -s
#
# Docker (from K8s pod):
#   pytest -v -s tests/
# =============================================================================

# ── MTIB Connection (required for hardware mode) ────────────────────────────
MTIB_HOST=10.4.45.33
MTIB_PORT=50053

# ── Device Identity (required for hardware mode) ────────────────────────────
DEVICE_ID=70B3D584C01E1FCC
DEVICE_SNR=0964

# ── Fixture Profile ─────────────────────────────────────────────────────────
FIXTURE_PROFILE_PATH=fixtures/alpha_b0.json

# ── Mock Mode (no hardware required) ────────────────────────────────────────
# Set to "1" to run with MockCloudClient + mock hardware stubs
# MOCK_CLOUD=1

# ── Firmware Paths (on MTIB filesystem, for firmware_build fixture) ─────────
# nRF52840 application firmware
FW_DEBUG_HEX=alpha_debug_nrf52840.hex
FW_RELEASE_HEX=alpha_release_nrf52840.hex

# nRF9151 comms coprocessor firmware (optional — skips comms flash if not set)
FW_DEBUG_COMMS_HEX=alpha_debug_nrf9151.hex
FW_RELEASE_COMMS_HEX=alpha_release_nrf9151.hex

# nRF9151 modem firmware (required if comms hex is set — chiperase wipes modem)
FW_MODEM_ZIP=mfw_nrf91x1_2.0.2.zip

# ── CoreOps Re-personalization ──────────────────────────────────────────────
# Required for re-personalization after firmware flash.
# CoreOps uses the same auth server as CoreCloud.
COREOPS_SERVER_URL=https://coreops.office.corekinect.cloud:2013
COREOPS_AUTH_SERVER_URL=https://auth.office.corekinect.cloud:2013
# COREOPS_API_KEY=                    # From Jared
# COREOPS_AUTH_USER=                  # From Jared
# COREOPS_AUTH_PASS=                  # From Jared

# Pre-known device identifiers (skips modem read if set)
# DEVICE_IMEI=355025931735979
# DEVICE_ICCIDS=89148000008770457338,89012230001000370694

# ── CoreCloud Database ────────────────────────────────────────────────────────
# Required for corecloud-marked tests (DB message queries)
#
# VAL_1_0 — Validation server (direct from K8s cluster, no SSH tunnel)
CORECLOUD_DB_ENV=VAL_1_0
# VAL_1_0_DB_DRIVER=postgresql+psycopg2
# VAL_1_0_DB_USER=
# VAL_1_0_DB_PASS=
# VAL_1_0_DB_HOST=validation.ad.corekinect.com
# VAL_1_0_DB_PORT=5432
# VAL_1_0_DB_NAME=test
#
# VAL_1_0 REST API
# VAL_1_0_API_KEY=
# VAL_1_0_API_AUTH_SERVER_HOST_NAME=https://auth.office.corekinect.cloud:2013
# VAL_1_0_API_REST_SERVER_HOST_NAME=https://val.office.corekinect.cloud:2018/api
#
# DEV_1_0 — Dev server (requires SSH tunnel to dmz-pg02.dmz.corekinect.com)
# Use this if device is personalized against dev.office.corekinect.cloud
# CORECLOUD_DB_ENV=DEV_1_0
# DEV_1_0_DB_DRIVER=postgresql+psycopg2
# DEV_1_0_DB_USERNAME=
# DEV_1_0_DB_PASSWORD=
# DEV_1_0_DB_HOST=127.0.0.1
# DEV_1_0_DB_PORT=5432
# DEV_1_0_DB_DATABASE_NAME=corecloud_office_prod
# DEV_1_0_SSH_HOST=dmz-pg02.dmz.corekinect.com
# DEV_1_0_SSH_PORT=22
# DEV_1_0_SSH_USERNAME=
# DEV_1_0_SSH_PASSWORD=

# ── Test Artifacts ──────────────────────────────────────────────────────────
ARTIFACTS_DIR=/var/log/validation

# ── Concord Reporter (Phase 6B — opt-in) ────────────────────────────────────
# When set, test results are streamed to Concord API in real-time.
# When NOT set, the reporter is completely inactive.
# CONCORD_RUN_ID=
# CONCORD_API_URL=http://concord-api:9001
# CONCORD_API_KEY=
