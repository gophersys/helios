{
  "name": "validation-alpha",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/validation/alpha",
  "projectType": "application",
  "tags": ["scope:validation", "type:app", "product:alpha"],
  "implicitDependencies": ["protocols"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "nx run validation-alpha:containerize -c development"
        },
        "staging": {
          "command": "nx run validation-alpha:containerize -c staging"
        },
        "production": {
          "command": "nx run validation-alpha:containerize -c production"
        }
      }
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/validation/alpha/deploy/Dockerfile",
        "push": false,
        "load": true,
        "build-args": [
          "APP_VERSION",
          "ENVIRONMENT",
          "GIT_COMMIT",
          "GIT_BRANCH",
          "BUILD_TIME"
        ]
      },
      "configurations": {
        "development": {
          "tags": ["concord/validation-alpha:development"],
          "platforms": []
        },
        "staging": {
          "tags": [
            "concord/validation-alpha:staging",
            "containers.ad.corekinect.com/concord-validation-alpha:staging"
          ]
        },
        "production": {
          "tags": [
            "concord/validation-alpha:production",
            "containers.ad.corekinect.com/concord-validation-alpha:production"
          ],
          "platforms": ["linux/amd64"]
        }
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "defaultConfiguration": "staging",
      "configurations": {
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-validation-alpha:staging"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-validation-alpha:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["push"],
      "defaultConfiguration": "staging",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "staging": {
          "commands": [
            "echo '✓ Image pushed: containers.ad.corekinect.com/concord-validation-alpha:staging'",
            "echo 'Trigger validation via POST /v2/validation/runs or Concord UI'"
          ],
          "parallel": false
        },
        "production": {
          "commands": [
            "echo '✓ Image pushed: containers.ad.corekinect.com/concord-validation-alpha:production'",
            "echo 'Trigger validation via POST /v2/validation/runs or Concord UI'"
          ],
          "parallel": false
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/validation/alpha",
        "command": "PYTHONPATH=$(pwd)/../../../libs/python:$(pwd)/../../../libs:$(pwd)/../../../libs/protocols:. pytest tests/ -v --collect-only"
      }
    },
    "test:mock": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/validation/alpha",
        "command": "PYTHONPATH=$(pwd)/../../../libs/python:$(pwd)/../../../libs:$(pwd)/../../../libs/protocols:. MOCK_CLOUD=1 pytest tests/ -v"
      }
    },
    "test:fuota": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/validation/alpha",
        "command": "PYTHONPATH=$(pwd)/../../../libs/python:$(pwd)/../../../libs:$(pwd)/../../../libs/protocols:. pytest tests/fuota/ -v -s --timeout=7200"
      }
    },
    "preflight": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/validation/alpha",
        "command": "PYTHONPATH=$(pwd)/../../../libs/python:$(pwd)/../../../libs:$(pwd)/../../../libs/protocols:. python3 run.py --stage fuota --preflight-only"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/validation/alpha",
        "command": "python3 -c \"import py_compile,glob;[py_compile.compile(f,doraise=True) for f in glob.glob('**/*.py',recursive=True)]\""
      }
    }
  }
}
