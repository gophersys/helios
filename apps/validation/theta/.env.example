# Theta validation environment config
# Copy this to .env and fill in values

# MTIB connection
MTIB_HOST=10.4.45.35
MTIB_PORT=50053

# Device under test
DEVICE_ID=
DEVICE_SNR=
DEVICE_IMEI=
DEVICE_ICCIDS=

# Fixture profile
FIXTURE_PROFILE_PATH=fixtures/theta_c0.json

# Firmware paths (optional - for flash tests)
FW_DEBUG_HEX=
FW_RELEASE_HEX=
FW_DEBUG_COMMS_HEX=
FW_RELEASE_COMMS_HEX=

# Test artifacts
ARTIFACTS_DIR=logs

# Mock mode (for local testing without hardware)
# MOCK_CLOUD=1

# Reporter config (for CI/CD integration)
# CONCORD_RUN_ID=
# CONCORD_API_URL=
# CONCORD_API_KEY=
