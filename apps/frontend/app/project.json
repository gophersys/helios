{
  "name": "app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/app/src",
  "projectType": "application",
  "tags": [
    "scope:frontend",
    "type:app"
  ],
  "targets": {
    "get-build-info": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "echo \"PUBLIC_APP_VERSION=$(git describe --tags --always 2>/dev/null || echo dev)\"",
          "echo \"GIT_COMMIT=$(git rev-parse --short=7 HEAD)\"",
          "echo \"GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)\"",
          "echo \"GIT_DIRTY=$([ -n \"$(git status --porcelain)\" ] && echo true || echo false)\"",
          "echo \"BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
          "echo \"BUILD_HOST=$(hostname)\""
        ]
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": true,
        "commands": [
          "cd apps/frontend/app && npx vite dev --port 4200",
          "python3 hooks/generate_role_manifest.py && PYTHONPATH=libs/python:libs:libs/protocols zensical serve -a 0.0.0.0:4000 2>&1 || true"
        ]
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          {
            "command": "nx typecheck app"
          },
          {
            "command": "nx test app"
          }
        ]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": [
        "get-build-info"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "cd apps/frontend/app && PUBLIC_APP_ENVIRONMENT=development npx vite build"
        },
        "staging": {
          "command": "nx run app:containerize -c staging"
        },
        "production": {
          "command": "nx run app:containerize -c production"
        }
      },
      "cache": false
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/frontend/app/deploy/Dockerfile",
        "push": false,
        "load": true
      },
      "configurations": {
        "development": {
          "tags": [
            "concord/frontend:development"
          ],
          "build-args": [
            "PUBLIC_APP_ENVIRONMENT=development",
            "PUBLIC_APP_VERSION=dev",
            "GIT_COMMIT",
            "GIT_BRANCH",
            "GIT_DIRTY",
            "BUILD_TIME",
            "BUILD_HOST"
          ],
          "platforms": []
        },
        "staging": {
          "tags": [
            "concord/frontend:staging",
            "containers.ad.corekinect.com/concord-frontend:staging"
          ],
          "build-args": [
            "PUBLIC_APP_ENVIRONMENT",
            "PUBLIC_APP_VERSION",
            "GIT_COMMIT",
            "GIT_BRANCH",
            "GIT_DIRTY",
            "BUILD_TIME",
            "BUILD_HOST"
          ]
        },
        "production": {
          "tags": [
            "concord/frontend:production",
            "containers.ad.corekinect.com/concord-frontend:production"
          ],
          "build-args": [
            "PUBLIC_APP_ENVIRONMENT",
            "PUBLIC_APP_VERSION",
            "GIT_COMMIT",
            "GIT_BRANCH",
            "GIT_DIRTY",
            "BUILD_TIME",
            "BUILD_HOST"
          ],
          "platforms": [
            "linux/amd64"
          ]
        }
      },
      "cache": false
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping push for development'"
        },
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-frontend:staging"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-frontend:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "push"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping deploy for development'"
        },
        "staging": {
          "command": "./deploy/ctl.sh staging deploy"
        },
        "production": {
          "command": "./deploy/ctl.sh production deploy"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/app",
        "command": "npx svelte-kit sync && npx tsc --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/app",
        "command": "npx vitest run"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/app",
        "command": "npx eslint ."
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/app",
        "command": "npx vitest run --coverage --coverage.thresholds.statements=9"
      }
    }
  }
}
