{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "docs",
  "root": "apps/frontend/docs",
  "targets": {
    "get-build-info": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "echo \"APP_VERSION=$(git describe --tags --always 2>/dev/null || echo dev)\"",
          "echo \"GIT_COMMIT=$(git rev-parse --short=7 HEAD)\"",
          "echo \"GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD)\"",
          "echo \"GIT_DIRTY=$([ -n \"$(git status --porcelain)\" ] && echo true || echo false)\"",
          "echo \"BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
          "echo \"BUILD_HOST=$(hostname)\""
        ]
      }
    },
    "serve": {
      "command": "python3 hooks/generate_role_manifest.py && PYTHONPATH=libs/python:libs:libs/protocols zensical serve -a 0.0.0.0:4000",
      "options": {
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": [
        "get-build-info"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "zensical build && python3 hooks/generate_role_manifest.py"
        },
        "staging": {
          "command": "nx run docs:containerize -c staging"
        },
        "production": {
          "command": "nx run docs:containerize -c production"
        }
      },
      "outputs": [
        "{workspaceRoot}/apps/docs/site"
      ],
      "cache": false
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/frontend/docs/deploy/Dockerfile",
        "push": false,
        "load": true,
        "build-args": [
          "APP_VERSION",
          "GIT_COMMIT",
          "GIT_BRANCH",
          "BUILD_TIME",
          "BUILD_HOST",
          "ENVIRONMENT"
        ]
      },
      "configurations": {
        "development": {
          "tags": [
            "concord/docs:development"
          ],
          "platforms": []
        },
        "staging": {
          "tags": [
            "concord/docs:staging",
            "containers.ad.corekinect.com/concord-docs:staging"
          ]
        },
        "production": {
          "tags": [
            "concord/docs:production",
            "containers.ad.corekinect.com/concord-docs:production"
          ],
          "platforms": [
            "linux/amd64"
          ]
        }
      },
      "cache": false
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping push for development'"
        },
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-docs:staging"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-docs:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "push"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping deploy for development'"
        },
        "staging": {
          "command": "./deploy/ctl.sh staging deploy"
        },
        "production": {
          "command": "./deploy/ctl.sh production deploy"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No tests for docs'"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "zensical build --strict 2>/dev/null || echo 'typecheck: build verification only'"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          {
            "command": "nx typecheck docs"
          },
          {
            "command": "nx test docs"
          }
        ]
      }
    }
  }
}
