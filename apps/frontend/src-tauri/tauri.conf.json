{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eden",
  "version": "0.0.0",
  "identifier": "dev.eden.desktop",
  "build": {
    "beforeDevCommand": "PUBLIC_EDEN_RUNTIME=desktop bash ./ctl.sh dev --port 5173 --strictPort",
    "beforeBuildCommand": "PUBLIC_EDEN_RUNTIME=desktop bash ./ctl.sh build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Eden",
        "width": 1280,
        "height": 832,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
