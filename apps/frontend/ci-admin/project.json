{
  "name": "ci-admin",
  "projectType": "application",
  "sourceRoot": "apps/frontend/ci-admin/src",
  "root": "apps/frontend/ci-admin",
  "tags": ["scope:ci", "type:app"],
  "targets": {
    "serve": {
      "command": "cd apps/frontend/ci-admin && npx vite dev --port 4300"
    },
    "build": {
      "command": "cd apps/frontend/ci-admin && npm run build"
    },
    "check": {
      "command": "cd apps/frontend/ci-admin && npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json"
    }
  }
}
