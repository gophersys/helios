node_modules
.svelte-kit
# Anchored to the SvelteKit adapter OUTPUT dir at the app root only — a leading slash keeps this
# from swallowing legitimate source paths named "build" (the Build view route
# src/routes/(app)/projects/[id]/build and the src/lib/buildview module).
/build
.eden
test-results
playwright-report

# The repo-root .gitignore excludes every `build/` directory (its SvelteKit-adapter-output rule).
# Re-include the Build VIEW source — a first-class product route/module, not a build artifact (the
# one-shell merge, doc 17 §5). Negations must name each source path under the excluded leaf.
!src/routes/**/build/
!src/routes/**/build/**
