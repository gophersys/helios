{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "tags": ["scope:apps", "type:svelte"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh dev", "cwd": "{projectRoot}" },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh build", "cwd": "{projectRoot}" },
      "cache": false
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh preview", "cwd": "{projectRoot}" },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh lint", "cwd": "{projectRoot}" },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh typecheck", "cwd": "{projectRoot}" },
      "cache": false
    }
  }
}
