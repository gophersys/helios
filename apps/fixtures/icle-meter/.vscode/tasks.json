{
    "version": "2.0.0",
    "options": {
        "env": {
            "APP_BOARD": "esp32_devkitc_wrover",
            "DEV_PORT": "/dev/ttyUSB0",
            "BAUDRATE": "115200"
        }
    },
    "tasks": [
        {
            "label": "West Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "west",
            "args": [
                "build",
                "-p",
                "auto",
                "-b",
                "${APP_BOARD}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
        },
        {
            "label": "West Clean Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "west",
            "args": [
                "build",
                "-p",
                "always",
                "-b",
                "${APP_BOARD}"
            ],
            "problemMatcher": [
                "$gcc"
            ],
        },
        {
            "label": "West Flash",
            "type": "shell",
            "command": "west",
            "args": [
                "-v",
                "flash",
                "--esp-baud-rate",
                "921600",
                "--esp-device",
                "${DEV_PORT}"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "West Monitor",
            "type": "shell",
            "command": "west",
            "args": [
                "espressif",
                "monitor",
                "-b",
                "${BAUDRATE}",
                "-p",
                "${DEV_PORT}"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "West Flash & Monitor",
            "type": "shell",
            "command": "west",
            "args": [
                "-v",
                "flash",
                "--esp-baud-rate",
                "921600",
                "--esp-device",
                "${DEV_PORT}",
                "&&",
                "west",
                "espressif",
                "monitor",
                "-b",
                "${BAUDRATE}",
                "-p",
                "${DEV_PORT}"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        }
    ],
}