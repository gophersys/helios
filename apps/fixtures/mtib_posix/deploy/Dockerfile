FROM ubuntu:22.04

# -----------------------------------------------------------------------------------------------------
#                                                                                                 JLink
# ---------------------------------------------------------------------------------------------------*/
WORKDIR /tmp

# Install common dependencies first
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y x11-common && \
    apt-get install -y \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-render0 \
        libxcb-shape0 \
        libxkbcommon-x11-0 \
        curl \
        udev \
        libice6 || apt-get --fix-broken install -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Download and install JLink package based on architecture, resolving any missing dependencies
RUN ARCH="$(uname -m)" && \
    case "${ARCH}" in \
        aarch64) \
            JLINK_DEB="JLink_Linux_arm64.deb" \
            ;; \
        x86_64) \
            JLINK_DEB="JLink_Linux_x86_64.deb" \
            ;; \
        *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    echo '#!/bin/sh\nexit 0' > /usr/bin/udevadm && \
    chmod +x /usr/bin/udevadm && \
    curl -fsSL -o ${JLINK_DEB} -d "accept_license_agreement=accepted&submit=Download+software" "https://www.segger.com/downloads/jlink/${JLINK_DEB}" && \
    dpkg -i ${JLINK_DEB} || true && \
    apt-get update && apt-get install -y -f && \
    rm -f ${JLINK_DEB}

# Setup config folder to avoid "Terms of Use" pop up window of JLink on every board flash
COPY .devcontainer/env/assets/segger /root/.config/SEGGER

# Remove udev mock
RUN rm /usr/bin/udevadm

# -----------------------------------------------------------------------------------------------------
#                                                                                           Other tools
# ---------------------------------------------------------------------------------------------------*/
WORKDIR /

# Update and install all necessary tools in one layer
RUN apt-get update && \
    apt-get install -y \
    python3 \
    python3-pip \
    screen \
    iputils-ping \
    usbutils \
    && apt-get clean \ 
    && rm -rf /var/lib/apt/lists/* 

# Image size up to here is ~/652MB

# -----------------------------------------------------------------------------------------------------
#                                                                                      App Dependencies
# ---------------------------------------------------------------------------------------------------*/

# By installing these first you save a lot of time when making changes to the source code
# and rebuilding the application
WORKDIR /app
COPY apps/fixtures/mtib-posix/setup.py setup.py
RUN pip install -e . && \
    pip cache purge

# Image size up to here is ~/825MB

# -----------------------------------------------------------------------------------------------------
#                                                                                          GPIO Control
# ---------------------------------------------------------------------------------------------------*/

WORKDIR /root

# Install git
RUN apt-get update && \
    apt-get install -y \
    git \
    swig \
    && apt-get clean \ 
    && rm -rf /var/lib/apt/lists/* 

# Clone and install wiringOP-Python
RUN git clone --recursive https://github.com/orangepi-xunlong/wiringOP-Python -b next && \
    cd wiringOP-Python && \
    git submodule update --init --remote && \
    python3 generate-bindings.py > bindings.i && \
    python3 setup.py install

# Mock /etc/orangepi-release
RUN mkdir -p /etc/orangepi && \
    echo "# PLEASE DO NOT EDIT THIS FILE\nBOARD=orangepizero3\nBOARD_NAME=\"OPI Zero3\"\nBOARDFAMILY=sun50iw9\nBUILD_REPOSITORY_URL=https://github.com/orangepi-xunlong/orangepi-build.git\nBUILD_REPOSITORY_COMMIT=2dbd451-dirty\nDISTRIBUTION_CODENAME=jammy\nDISTRIBUTION_STATUS=supported\nVERSION=1.0.2\nLINUXFAMILY=sun50iw9\nARCH=arm64\nIMAGE_TYPE=user-built\nBOARD_TYPE=conf\nINITRD_ARCH=arm64\nKERNEL_IMAGE_TYPE=Image\nBRANCH=next" > /etc/orangepi-release

RUN curl -LO https://nsscprodmedia.blob.core.windows.net/prod/software-and-other-downloads/desktop-software/nrf-command-line-tools/sw/versions-10-x-x/10-24-0/nrf-command-line-tools_10.24.0_arm64.deb && \
    dpkg -i nrf-command-line-tools_10.24.0_arm64.deb && \
    rm nrf-command-line-tools_10.24.0_arm64.deb
    
# -----------------------------------------------------------------------------------------------------
#                                                                                                   App  
# ---------------------------------------------------------------------------------------------------*/
WORKDIR /app

# Copy the libraries used by the app
COPY libs/python/iface-posix /libs/python/iface-posix
COPY libs/python/cipher-posix /libs/python/cipher-posix

# Copy the protocols used by the app
COPY libs/protos/mtib_cs_pi /libs/protos/mtib_cs_pi
COPY libs/protos/mtib_pi_stm /libs/protos/mtib_pi_stm

# Import the paths to the python path
ENV PYTHONPATH="/libs:${PYTHONPATH}"
ENV PYTHONPATH="/libs/python/iface-posix:${PYTHONPATH}"
ENV PYTHONPATH="/libs/python/cipher-posix:${PYTHONPATH}"

# Copy the app itself
COPY apps/fixtures/mtib-posix/config config
COPY apps/fixtures/mtib-posix/src src
COPY apps/fixtures/mtib-posix/.env .env

# Image size up to here is ~/875MB

# Keep the container running
CMD ["python3", "src/main.py"]