 */

/ {
    aliases {
        vsm-enable = &vsm_enable;
        i2c-gpio = &i2c_gpio;
    };

    /* GPIO I2C bus for MLX90614 IR temp sensor - P1.04 (SCL), P1.06 (SDA) */
    i2c_gpio: i2c-gpio {
        compatible = "gpio-i2c-fast";
        status = "okay";
        clock-frequency = <100000>;
        cpu-frequency = <64000000>;
        #address-cells = <1>;
        #size-cells = <0>;
        scl-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        sda-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        mlx90614: mlx90614@5a {
            status = "okay";
            compatible = "melexis,mlx90614";
            reg = <0x5a>;
            emissivity = <65535>;
        };
    };
};

&lsm6dso0 {
    spi-max-frequency = <10000000>;
};

&i2c1 {
    clock-frequency = <I2C_BITRATE_FAST>;

    pah8151: pah8151@15 {
        status = "okay";
        compatible = "pixart,pah8151";
        reg = <0x15>;
        irq-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;    /* PPG.INT1 - P0.20 */
        int1-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        int2-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;   /* Using same pin if only one INT connected */
        int-pin = <1>;
        led-current-ir = <255>;
        led-current-red = <255>;
        led-current-green = <255>;
    };
};
