{
  "name": "firmware-alpha",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:firmware", "type:app", "platform:nrf52"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/build.sh all"
      },
      "configurations": {
        "app": {
          "command": "bash scripts/build.sh app"
        },
        "mfg": {
          "command": "bash scripts/build.sh mfg"
        },
        "pristine": {
          "command": "bash scripts/build.sh all --pristine"
        }
      }
    },
    "build:docker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/..",
        "command": "bash ctl.sh build alpha --target all"
      },
      "configurations": {
        "app": {
          "command": "bash ctl.sh build alpha --target app"
        },
        "mfg": {
          "command": "bash ctl.sh build alpha --target mfg"
        }
      }
    },
    "build:all-variants": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/..",
        "command": "bash ctl.sh build-all alpha"
      }
    },
    "build:app-fw": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/build.sh app"
      },
      "configurations": {
        "alpha_a0": {
          "command": "bash scripts/build.sh app -b alpha_a0"
        },
        "alpha_b0": {
          "command": "bash scripts/build.sh app -b alpha_b0"
        }
      }
    },
    "build:mfg-fw": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash scripts/build.sh mfg"
      }
    },
    "collect": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/..",
        "command": "bash ctl.sh collect alpha"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/..",
        "command": "bash ctl.sh clean alpha"
      }
    },
    "artifacts": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}/..",
        "command": "bash ctl.sh artifacts alpha"
      }
    }
  }
}
