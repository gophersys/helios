/* MFG APP overlay: I2C sensors for manufacturing test.
 *
 * Defines GPIO-I2C bus for MLX90614 IR temp sensor and
 * hardware-I2C peripherals (BME280, LP5814, PAH8151).
 */
/ {
    aliases {
        ioexpander = &lp5814;
        vsm-enable = &vsm_enable;
        i2c-gpio = &ir_i2c;
    };

    ir_i2c: ir_i2c {
        compatible = "gpio-i2c-fast";
        status = "okay";
        clock-frequency = <100000>;
        cpu-frequency = <64000000>;
        #address-cells = <1>;
        #size-cells = <0>;
        scl-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        sda-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;

        mlx90614: mlx90614@5a {
            status = "okay";
            compatible = "melexis,mlx90614";
            reg = <0x5a>;
            emissivity = <65535>;
        };
    };
};

&i2c1 {
    clock-frequency = <I2C_BITRATE_FAST>;

    bme280: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
    };

    lp5814: lp5814@2c {
        compatible = "ti,lp5814";
        reg = <0x2C>;
    };

    pah8151: pah8151@15 {
        status = "okay";
        compatible = "pixart,pah8151";
        reg = <0x15>;
        irq-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        int1-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        int2-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        int-pin = <1>;
        led-current-ir = <255>;
        led-current-red = <255>;
        led-current-green = <255>;
    };
};
