FROM ubuntu:22.04

# Install common dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y x11-common && \
    apt-get install -y \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-render-util0 \
        libxcb-render0 \
        libxcb-shape0 \
        libxkbcommon-x11-0 \
        curl \
        udev \
        python3 \
        python3-pip \
        screen \
        git \
        swig \
        iputils-ping \
        usbutils \
        libice6 || apt-get --fix-broken install -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
# ----------------------------------------------------------------------------------
#                                                                              JLink
# --------------------------------------------------------------------------------*/
RUN ARCH="$(uname -m)" && \
    case "${ARCH}" in \
        aarch64) \
            JLINK_DEB="JLink_Linux_V796j_arm64.deb" \
            ;; \
        x86_64) \
            JLINK_DEB="JLink_Linux_V796j_x86_64.deb" \
            ;; \
        *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    echo '#!/bin/sh\nexit 0' > /usr/bin/udevadm && \
    chmod +x /usr/bin/udevadm && \
    curl -fsSL -o ${JLINK_DEB} -d "accept_license_agreement=accepted&submit=Download+software" "https://www.segger.com/downloads/jlink/${JLINK_DEB}" && \
    dpkg -i ${JLINK_DEB} || true && \
    apt-get update && apt-get install -y -f && \
    rm -f ${JLINK_DEB}

# Setup config folder to avoid "Terms of Use" pop up window of JLink on every board flash
COPY .devcontainer/env/assets/segger /root/.config/SEGGER

# Remove udev mock
RUN rm /usr/bin/udevadm

# ----------------------------------------------------------------------------------
#                                                                           nrfjprog
# --------------------------------------------------------------------------------*/
RUN ARCH="$(uname -m)" && \
    case "${ARCH}" in \
        aarch64) \
            NRF_CLI_DEB="nrf-command-line-tools_10.24.2_arm64.deb" \
            ;; \
        x86_64) \
            NRF_CLI_DEB="nrf-command-line-tools_10.24.2_amd64.deb" \
            ;; \
        *) echo "Unsupported architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    curl -o nrf-cli-tools.deb "https://nsscprodmedia.blob.core.windows.net/prod/software-and-other-downloads/desktop-software/nrf-command-line-tools/sw/versions-10-x-x/10-24-2/${NRF_CLI_DEB}" && \
    dpkg -i nrf-cli-tools.deb || true && \
    apt-get install -f -y && \
    rm nrf-cli-tools.deb

    WORKDIR /root

# ----------------------------------------------------------------------------------
#                                                            WiringPy (GPIO Control)
# --------------------------------------------------------------------------------*/
# Clone and install wiringOP-Python
RUN git clone --recursive https://github.com/orangepi-xunlong/wiringOP-Python -b next && \
    cd wiringOP-Python && \
    git submodule update --init --remote && \
    python3 generate-bindings.py > bindings.i && \
    python3 setup.py install

# Mock /etc/orangepi-release
RUN mkdir -p /etc/orangepi && \
    echo "# PLEASE DO NOT EDIT THIS FILE\nBOARD=orangepizero3\nBOARD_NAME=\"OPI Zero3\"\nBOARDFAMILY=sun50iw9\nBUILD_REPOSITORY_URL=https://github.com/orangepi-xunlong/orangepi-build.git\nBUILD_REPOSITORY_COMMIT=2dbd451-dirty\nDISTRIBUTION_CODENAME=jammy\nDISTRIBUTION_STATUS=supported\nVERSION=1.0.2\nLINUXFAMILY=sun50iw9\nARCH=arm64\nIMAGE_TYPE=user-built\nBOARD_TYPE=conf\nINITRD_ARCH=arm64\nKERNEL_IMAGE_TYPE=Image\nBRANCH=next" > /etc/orangepi-release

# ----------------------------------------------------------------------------------
#                                                            App python dependencies
# --------------------------------------------------------------------------------*/

WORKDIR /app

# By installing these first you save a lot of time when making changes to the source code
# and rebuilding the application
COPY apps/shared/runner/setup.py setup.py
RUN pip install -e . && \
    pip cache purge

# ----------------------------------------------------------------------------------
#                                                            App python dependencies
# --------------------------------------------------------------------------------*/
WORKDIR /app

# Copy the libraries used by the app
COPY libs/python/corekinect/iface /libs/python/corekinect/iface
COPY libs/python/corekinect/cipher /libs/python/corekinect/cipher

# Copy the protocols used by the app
COPY libs/protos/mtib_runner_zephyr /libs/protos/mtib_runner_zephyr
COPY libs/protos/mtib_runner /libs/protos/mtib_runner

# Set the PYTHONPATH to include the libs directory
ENV PYTHONPATH="/libs:${PYTHONPATH}"
ENV PYTHONPATH="/libs/python/:${PYTHONPATH}"

# Copy the app itself
COPY apps/shared/runner/config config
COPY apps/shared/runner/src src

# Keep the container running
CMD ["python3", "src/main.py"]