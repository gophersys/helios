{
  "name": "runner",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shared/runner",
  "projectType": "application",
  "targets": {
    "build": {
      "command": "nx run runner:containerize",
      "cwd": "{workspaceRoot}"
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "cwd": "{workspaceRoot}",
      "options": {
        "context": "{workspaceRoot}",
        "file": "apps/shared/runner/Dockerfile",
        "platforms": [
          "linux/arm64"
        ],
        "load": true,
        "push": false,
        "tags": [
          "ccr01.ad.corekinect.com/mtib-runner:log"
        ]
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "apt-get install -y swig python3-dev python3-setuptools"
          },
          {
            "command": "rm -rf .venv/wiringOP-Python"
          },
          {
            "command": "git clone -b next --recursive https://github.com/orangepi-xunlong/wiringOP-Python.git .venv/wiringOP-Python"
          },
          {
            "command": "bash -c 'cd .venv/wiringOP-Python && python3 generate-bindings.py > bindings.i'"
          },
          {
            "command": "bash -c 'cd .venv/wiringOP-Python && python3 setup.py install'"
          },
          {
            "command": "bash -c 'mkdir -p /etc/orangepi && echo \"# PLEASE DO NOT EDIT THIS FILE\nBOARD=orangepizero3\nBOARD_NAME=\"OPI Zero3\"\nBOARDFAMILY=sun50iw9\nBUILD_REPOSITORY_URL=https://github.com/orangepi-xunlong/orangepi-build.git\nBUILD_REPOSITORY_COMMIT=2dbd451-dirty\nDISTRIBUTION_CODENAME=jammy\nDISTRIBUTION_STATUS=supported\nVERSION=1.0.2\nLINUXFAMILY=sun50iw9\nARCH=arm64\nIMAGE_TYPE=user-built\nBOARD_TYPE=conf\nINITRD_ARCH=arm64\nKERNEL_IMAGE_TYPE=Image\nBRANCH=next\" > /etc/orangepi-release'"
          },
          {
            "command": "cp .env.example .env"
          }
        ],
        "parallel": false
      }
    }
  }
}