# =============================================================================
# http-api — Backend Service Config
# =============================================================================
# Matches AppConfig in config/env.py (1:1 with EnvConfig annotations).
# Plus DATABASE_URL/DIRECT_DATABASE_URL (read directly by Prisma client).
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=4
LOG_PATH=logs

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=9001
CORS_ORIGINS=http://localhost:4200

# ── Auth ─────────────────────────────────────────────────────────────────────
# Set AUTH_ENABLED=false for local dev. MUST be true in staging/production.
AUTH_ENABLED=false
# JWT_SECRET_KEY must be 32+ chars in staging/production (enforced at startup).
JWT_SECRET_KEY=concord-dev-jwt-secret-change-in-production
AUTH_SERVER_URL=https://auth.office.corekinect.cloud:2013
AUTH_SERVER_API_KEY=

# ── Assets ───────────────────────────────────────────────────────────────────
ASSETS_FOLDER=assets

# ── Storage (MinIO/S3) ───────────────────────────────────────────────────────
STORAGE_URL=http://localhost:8675
STORAGE_ACCESS_KEY=concord
STORAGE_SECRET_ACCESS_KEY=concordstorage!
STORAGE_BUCKET_NAME=concord

# ── Database (Prisma) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://concord:concord@localhost:5433/concord
DIRECT_DATABASE_URL=postgresql://concord:concord@localhost:5433/concord

# ── K8s Validation Jobs ──────────────────────────────────────────────────────
CONCORD_API_HOST=staging.concord.local
MTIB_PORT=50053
VALIDATION_NAMESPACE=validation

# ── Bitbucket Poller ─────────────────────────────────────────────────────────
BITBUCKET_POLLER_ENABLED=true
BITBUCKET_POLLER_INTERVAL_S=300
BITBUCKET_SSH_KEY=
BITBUCKET_API_TOKEN=
BITBUCKET_EMAIL=
BITBUCKET_WORKSPACE=corekinect

# ── CkBoards ─────────────────────────────────────────────────────────────────
CK_BOARDS_REPO_URL=git@bitbucket.org:corekinect/ck_boards.git
CK_BOARDS_FETCH_INTERVAL=60
