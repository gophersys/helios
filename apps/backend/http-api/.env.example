# Environment
ENVIRONMENT="development"

# Where we store templates, etc
ASSETS_FOLDER="assets"

# Permanently deletes records
DELETE_ALL_KEY=84262c29-3a8c-43e3-9d8e-51b65760c7e8

# Log level of the stdout logs. 4 = DEBUG, 1 = ERROR
LOG_LEVEL=4

# Path where the service will store its logs
LOG_PATH=logs

# Port where the proxy serves
SERVER_PORT=9001

# Prisma client ENV var
DATABASE_URL=postgresql://concord:concord@localhost:5432/concord

# Object storage
STORAGE_URL="http://localhost:8675"
STORAGE_ACCESS_KEY="concord"
STORAGE_SECRET_ACCESS_KEY="concordstorage!"
STORAGE_BUCKET_NAME="concord"

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200

# Auth
AUTH_ENABLED=false
JWT_SECRET_KEY=concord-dev-jwt-secret-change-in-production
AUTH_SERVER_URL=https://auth.office.corekinect.cloud:2013
AUTH_SERVER_API_KEY=

# CoreOps proxy (routes personalization requests to CoreOps server)
COREOPS_PROXY_URL="http://coreops-proxy:8001"

# Validation
MTIB_PORT=50053
VALIDATION_NAMESPACE=validation

# Git poller
GIT_POLLER_ENABLED=true
GIT_POLLER_INTERVAL_S=300
