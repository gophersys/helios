{
  "name": "http-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/http-api",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "nx run http-api:containerize -c development"
        },
        "staging": {
          "command": "nx run http-api:containerize -c staging"
        },
        "production": {
          "command": "nx run http-api:containerize -c production"
        }
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "defaultConfiguration": "staging",
      "configurations": {
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-http-api:latest"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-http-api:latest"
        }
      }
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/backend/http-api/deploy/Dockerfile",
        "push": false,
        "load": true
      },
      "configurations": {
        "development": {
          "tags": [
            "concord-http-api:development"
          ],
          "platforms": []
        },
        "staging": {
          "tags": [
            "containers.ad.corekinect.com/concord-http-api:staging"
          ]
        },
        "production": {
          "tags": [
            "containers.ad.corekinect.com/concord-http-api:latest"
          ],
          "platforms": [
            "linux/amd64"
          ]
        }
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "nx create protocols"
          },
          {
            "command": "nx generate-client database"
          },
          {
            "command": "bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "cp -n .env.example .env"
          }
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "bash -c 'source .venv/bin/activate && source .env && python3 src/main.py'"
          }
        ],
        "parallel": false
      }
    }
  }
}