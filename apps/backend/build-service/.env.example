# =============================================================================
# build-service — Firmware Build Worker
# =============================================================================
# Reads env vars directly (no EnvConfig). Vars are defined in src/worker/*.py
# and src/api/*.py modules. Polls the Concord API for pending build jobs and
# executes them in Docker-in-Docker builder containers.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Worker Identity ──────────────────────────────────────────────────────────
WORKER_ID=dev-builder-1

# ── Concord API (source of build jobs) ───────────────────────────────────────
CONCORD_API_URL=http://localhost:9001
CONCORD_API_KEY=

# ── Service ──────────────────────────────────────────────────────────────────
BUILD_SERVICE_PORT=9002
BUILD_SERVICE_DATABASE_URL=
POLL_INTERVAL=5
METRICS_ENABLED=false

# ── Builder (Docker-in-Docker) ───────────────────────────────────────────────
BUILDER_MODE=docker
BUILDER_NETWORK=host
BUILDER_TIMEOUT=1800
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_DIR=/tmp/builds
WORKSPACE_VOLUME=development_build_workspace
WORKSPACE_HOST_PATH=
CCACHE_VOLUME=development_ccache_data
CCACHE_HOST_PATH=

# ── Zephyr Toolchain ─────────────────────────────────────────────────────────
ZEPHYR_BASE=
ZEPHYR_SDK_INSTALL_DIR=

# ── Bitbucket SSH ────────────────────────────────────────────────────────────
BITBUCKET_SSH_KEY=
BITBUCKET_WORKSPACE=corekinect
SSH_KEY_PATH=/root/.ssh/keys/bitbucket

# ── Firmware Signing Keys (base64-encoded PEM) ───────────────────────────────
BENCH_SIGNING_KEY=
ENGINEERING_SIGNING_KEY=
PRODUCTION_SIGNING_KEY=
