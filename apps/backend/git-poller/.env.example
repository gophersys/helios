# =============================================================================
# git-poller — Bitbucket Commit Poller
# =============================================================================
# Matches GitPollerConfig in src/config.py.
# Polls configured repos via git ls-remote and triggers CI builds on new commits.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Concord API (target for build triggers) ──────────────────────────────────
CONCORD_API_URL=http://localhost:9001
CONCORD_API_KEY=

# ── Poll Settings ────────────────────────────────────────────────────────────
POLL_INTERVAL=30
SERVICE_PORT=9003

# ── Bitbucket SSH (inline key takes precedence over path) ────────────────────
# Base64-encoded private key (used in containers)
BITBUCKET_SSH_KEY=
# Path to key file on disk (used in local dev)
SSH_KEY_PATH=/root/.ssh/keys/bitbucket
