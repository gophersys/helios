# =============================================================================
# git-poller — Stage-Aware Bitbucket Poller
# =============================================================================
# Matches GitPollerConfig in src/config.py.
# Polls Bitbucket for branch changes and open PRs, then triggers builds.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Concord API (target for product discovery + build triggers) ───────────────
CONCORD_API_URL=http://localhost:9001
CONCORD_API_KEY=

# ── Poll Settings ────────────────────────────────────────────────────────────
POLL_INTERVAL=5               # seconds between each full poll cycle
PRODUCT_CACHE_TTL=60          # seconds before re-fetching product list from API

# ── Service ──────────────────────────────────────────────────────────────────
SERVICE_PORT=9003

# ── Bitbucket SSH (for git ls-remote) ────────────────────────────────────────
# Base64-encoded private key (used in containers — takes precedence over path)
BITBUCKET_SSH_KEY=
# Path to key file on disk (used in local dev)
SSH_KEY_PATH=/root/.ssh/id_rsa

# ── Bitbucket REST API (for PR polling) ──────────────────────────────────────
BITBUCKET_WORKSPACE=corekinect
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# ── State Persistence ────────────────────────────────────────────────────────
STATE_FILE=/tmp/git_poller_state.json
