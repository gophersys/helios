// Database configuration
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Generator for Prisma Client in Python
generator client {
    provider             = "prisma-client-py"
    recursive_type_depth = 5
    interface            = "sync"
}

// Model Definitions

/// Represents a type of board, which can have many board steppings
model BoardType {
    id             Int             @id @default(autoincrement()) // Primary key
    name           String // Name of the board type
    boardSteppings BoardStepping[] // One-to-many relationship with BoardStepping
}

/// Represents a revision or stepping of a board, which references a board type
model BoardStepping {
    id            Int            @id @default(autoincrement()) // Primary key
    name          String // Name of the stepping
    boardTypeId   Int // Foreign key to BoardType
    boardType     BoardType      @relation(fields: [boardTypeId], references: [id]) // BoardType relation
    boardVariants BoardVariant[] // One-to-many relationship with BoardVariant
}

/// Represents a variant of a board, including references to AppIDs and Chipsets
model BoardVariant {
    id              Int           @id @default(autoincrement()) // Primary key
    name            String // Name of the board variant
    appIds          AppId[]       @relation("BoardVariantAppIds") // Many-to-many relationship with AppId
    chipsets        Chipset[] // Many-to-many relationship with Chipset
    boardSteppingId Int // Foreign key to BoardStepping
    boardStepping   BoardStepping @relation(fields: [boardSteppingId], references: [id]) // BoardStepping relation
}

/// The `AppId` model uniquely identifies a combination of chipset and software feature set
model AppId {
    id               Int               @id @default(autoincrement()) // Primary key
    chipsetId        Int // Foreign key to the Chipset model
    chipset          Chipset           @relation(fields: [chipsetId], references: [id]) // Chipset relation
    firmwareVersions FirmwareVersion[] // Can have many firmware versions
    boardVariants    BoardVariant[]    @relation("BoardVariantAppIds") // Many-to-many relationship with BoardVariant

    @@map("app_ids")
}

/// The `Chipset` model represents the hardware configuration of a specific microcontroller
/// including its sensors, radios, and pin configuration.
model Chipset {
    id            Int            @id @default(autoincrement()) // Primary key
    name          String // Descriptive name of the chipset
    appIds        AppId[] // Relationship to AppId
    boardVariants BoardVariant[] // Many-to-many relationship with BoardVariant

    @@map("chipsets")
}

/// The `FirmwareVersion` model tracks individual firmware versions, tied to both an AppId 
/// It includes versioning information (major, minor, build & flags)
model FirmwareVersion {
    id           Int    @id @default(autoincrement()) // Primary key
    appId        Int // Foreign key to the AppId model
    app          AppId  @relation(fields: [appId], references: [id]) // AppId relation
    majorVersion Int // Major version of the firmware
    minorVersion Int // Minor version of the firmware
    buildNumber  Int // Build number (for hotfixes, incremental builds)
    flags        String // Bench, 

    @@map("firmware_versions")
}
