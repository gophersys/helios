{
  "name": "proxy",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/proxy",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 src/main.py"
          }
        ],
        "parallel": false
      }
    },
    "build": {
      "command": "nx run proxy:containerize",
      "cwd": "{workspaceRoot}"
    },
    "push": {
      "dependsOn": [
        "build"
      ],
      "command": "docker push ccr01.ad.corekinect.com/concord-proxy:latest"
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "cwd": "{workspaceRoot}",
      "options": {
        "context": "{workspaceRoot}",
        "file": "apps/backend/proxy/Dockerfile",
        "platforms": [
          "linux/amd64"
        ],
        "push": false,
        "tags": [
          "ccr01.ad.corekinect.com/concord-proxy:latest"
        ]
      }
    },
    "setup-dev": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "cp .env.example .env"
          }
        ],
        "parallel": false
      }
    },
    "generate-clients": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 docs/generate.py src/api/v1 -o docs/gen_api_v1.yaml"
          },
          {
            "command": "openapi-generator-cli generate -i docs/gen_api_v1.yaml -g python -o /workspaces/concord/libs/python/corekinect/proxy_client/v1\n"
          },
          {
            "command": "pip install -e /workspaces/concord/libs/python/corekinect/proxy_client/v1"
          }
        ],
        "parallel": false
      }
    },
    "setup-db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "supabase start"
          },
          {
            "command": "prisma db push"
          }
        ],
        "parallel": false
      }
    }
  }
}