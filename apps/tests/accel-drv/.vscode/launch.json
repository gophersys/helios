{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "device": "cortex-m7",
            "cwd": "${workspaceRoot}",
            "executable": "build/zephyr/zephyr.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "gdbPath": "/usr/home/zephyr-sdk-0.16.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg",
            ],
            "openOCDLaunchCommands": [
                "init",
                "reset init",
            ],
            "rtos": "Zephyr",
            "preLaunchTask": "West Flash",
            "svdFile": "./.vscode/STM32H750x.svd",
            "showDevDebugOutput": "raw"
        },
        {
            "name": "Attach",
            "device": "mimxrt1050_evk",
            "cwd": "${workspaceFolder}",
            "executable": "build/zephyr/zephyr.elf",
            "request": "attach",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "gdbPath": "/usr/home/zephyr-sdk-0.16.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb"
        },
    ]
}