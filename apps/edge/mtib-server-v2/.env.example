# =============================================================================
# MTIB Server V2 Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Hardware Revision Configuration
# -----------------------------------------------------------------------------
# The server auto-detects the hardware revision by probing I2C devices.
# You can override auto-detection by setting MTIB_HARDWARE_REVISION.
#
# Supported values: "1.1", "1.2", "REV1.1", "REV1.2"
# Leave unset or empty for auto-detection (recommended)
#
# MTIB_HARDWARE_REVISION=1.2

# Set to "false" to disable auto-detection and use default (REV 1.1)
# MTIB_AUTO_DETECT_REVISION=true

# Legacy support: HARDWARE_REVISION is also checked (for backwards compatibility)
# HARDWARE_REVISION=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: 10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR
LOG_LEVEL=20
LOG_PATH=logs

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port that the gRPC server listens on
SERVER_PORT=50052

# Path to the assets folder (firmware files, configs, etc.)
ASSETS_PATH=assets

# -----------------------------------------------------------------------------
# Metrics / Dashboard Configuration
# -----------------------------------------------------------------------------
# Enable MQTT metrics publishing for dashboard support
METRICS_ENABLED=false
METRICS_BROKER_URL="mqtt://kubecop.ad.corekinect.com:1883"

# -----------------------------------------------------------------------------
# Motion System Configuration
# -----------------------------------------------------------------------------
# Enable FluidNC motion controller support
MOTION_ENABLED=false

# -----------------------------------------------------------------------------
# Testing Configuration
# -----------------------------------------------------------------------------
# Used by integration tests
SERVER_HOST="localhost"
