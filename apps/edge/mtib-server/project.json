{
  "name": "mtib-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/edge/mtib-server",
  "projectType": "application",
  "tags": ["scope:edge", "type:app"],
  "implicitDependencies": ["protocols"],
  "targets": {
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "defaultConfiguration": "staging",
      "configurations": {
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-mtib-server:latest"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-mtib-server:latest"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "nx run mtib-server:containerize -c development"
        },
        "staging": {
          "command": "nx run mtib-server:containerize -c staging"
        },
        "production": {
          "command": "nx run mtib-server:containerize -c production"
        }
      }
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/edge/mtib-server/deploy/Dockerfile",
        "push": false,
        "builder": "concord-builder",
        "platforms": ["linux/arm64"]
      },
      "configurations": {
        "development": {
          "tags": [
            "concord-mtib-server:development"
          ],
          "load": true
        },
        "staging": {
          "tags": [
            "containers.ad.corekinect.com/concord-mtib-server:staging"
          ],
          "push": true
        },
        "production": {
          "tags": [
            "containers.ad.corekinect.com/concord-mtib-server:latest"
          ],
          "push": true
        }
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "/bin/bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "cp .env.example .env"
          },
          {
            "command": "cd assets && chmod +x ctl.sh && ./ctl.sh"
          },
          {
            "command": "apt install python3-tk -y"
          },
          {
            "command": "nx run protocols:create"
          }
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "PYTHONPATH=src:../../../libs/python:../../../libs/protocols:../../../libs python3 -m pytest tests/ -v --timeout=30"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 src/main.py"
          }
        ],
        "parallel": false
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "/bin/bash -c 'docker compose -f deploy/docker-compose.yaml up -d'"
          }
        ]
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "/bin/bash -c 'docker compose -f deploy/docker-compose.yaml down -v --remove-orphans'"
          }
        ]
      }
    }
  }
}