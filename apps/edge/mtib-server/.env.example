# Hardware configuration
HARDWARE_VERSION="REV1.1"

# Log level of the stdout logs. 4 = DEBUG, 1 = ERROR
LOG_LEVEL=4
LOG_PATH=logs

# Port that this app uses to serve its services
SERVER_PORT=50052

# Path to the assets folder
ASSETS_PATH=assets

# Enable dashboard support
METRICS_ENABLED=false
METRICS_BROKER_URL="mqtt://kubecop.ad.corekinect.com:1883"

# Motion
MOTION_ENABLED=false

# Tests
SERVER_HOST="localhost"