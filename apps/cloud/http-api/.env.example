# Environment
ENVIRONMENT="development"

# Permanently deletes records
DELETE_ALL_KEY=84262c29-3a8c-43e3-9d8e-51b65760c7e8

# Log level of the stdout logs. 4 = DEBUG, 1 = ERROR
LOG_LEVEL=4

# Path where the service will store its logs
LOG_PATH=logs

# Port where the proxy serves
SERVER_PORT=9001

# Path where the service will keep/read its filesystem database
DB_STORAGE_PATH=db
DB_STORAGE_LIMIT_GB=64

# Prisma client ENV var
DATABASE_URL=postgresql://concord:concord@localhost:5432/concord

# Where we expect developers to upload their release images to
SUPPORTED_REGISTRIES=ccr01.ad.corekinect.com,containers.ad.corekinect.com

# Authentication
AUTH_ENABLED=false
AUTH_SERVER_URL="https://auth.office.corekinect.cloud:2013/"
AUTH_SERVER_API_KEY="my-super-secret-api-key"
AUTH_SERVER_CREDENTIALS_USER="coreops-user"
AUTH_SERVER_CREDENTIALS_PASS="coreops-pass"

# Manufacturing
COREOPS_SERVER_URL="https://coreops.office.corekinect.cloud:2013"