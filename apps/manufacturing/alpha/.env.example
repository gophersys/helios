# =============================================================================
# Alpha Manufacturing — Environment Configuration
# =============================================================================
# Copy to .env and adjust for your environment.
# All values have sensible defaults for local development.
# =============================================================================

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CoreOps (device personalization) ─────────────────────────────────────────
COREOPS_SERVER_URL=https://coreops.office.corekinect.cloud:2013
COREOPS_AUTH_SERVER_URL=https://auth.office.corekinect.cloud:2013
COREOPS_API_KEY=
COREOPS_AUTH_USER=
COREOPS_AUTH_PASS=
COREOPS_VERIFY_SSL=false

# ── MTIB Hardware ────────────────────────────────────────────────────────────
# Multi-slot (manufacturing panel):
MTIB_HOSTS=
# Single-slot (validation / dev):
MTIB_HOST=
MTIB_PORT=50053

# ── Fixture Config (overrides MTIB_HOSTS/MTIB_HOST) ──────────────────────────
FIXTURE_CONFIG_PATH=

# ── Test Artifacts ───────────────────────────────────────────────────────────
ARTIFACTS_DIR=/tmp/manufacturing_artifacts

# ── Mock Mode (offline testing) ──────────────────────────────────────────────
MOCK_MODE=

# ── Product Catalog ──────────────────────────────────────────────────────────
PRODUCT_SLUG=alpha_b0
CONCORD_API_URL=http://localhost:9001
CONCORD_API_KEY=

# ── Concord Reporting (auto-activates reporter plugin) ───────────────────────
CONCORD_RUN_ID=
CONCORD_SESSION_ID=

# ── Build Run (firmware artifact resolution) ─────────────────────────────────
BUILD_RUN_ID=
