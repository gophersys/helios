# =============================================================================
# Alpha Manufacturing — Test Harness + Service Config
# =============================================================================
# Matches Config in config/config.py (service daemons — electrical/flash/post)
# and ManufacturingConfig in conftest.py (pytest harness).
# =============================================================================

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=4
LOG_PATH=logs

# ── Cluster Operator ─────────────────────────────────────────────────────────
OPERATOR_URL=10.4.45.7:50052

# ── CoreOps Proxy (personalization gateway) ──────────────────────────────────
PROXY_SERVER_URL=http://10.4.45.30:8001

# ── Test Service Ports + UUIDs ───────────────────────────────────────────────
ELECTRICAL_TEST_PORT=50060
ELECTRICAL_TEST_UUID=00000000-0000-0000-0000-000000000001

FW_FLASH_TEST_PORT=50061
FW_FLASH_TEST_UUID=00000000-0000-0000-0000-000000000002

POST_TEST_PORT=50062
POST_TEST_UUID=00000000-0000-0000-0000-000000000003

# ── Test Harness (pytest) ────────────────────────────────────────────────────
FIXTURE_CONFIG_PATH=
MTIB_HOSTS=
MTIB_HOST=10.4.45.33
MTIB_PORT=50053
ARTIFACTS_DIR=/tmp/manufacturing_artifacts
MOCK_MODE=

# ── Product Catalog Integration ──────────────────────────────────────────────
PRODUCT_SLUG=alpha_b0
CONCORD_API_URL=http://localhost:9001
CONCORD_API_KEY=
