{
  "name": "manufacturing-alpha",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/manufacturing/alpha",
  "projectType": "application",
  "tags": [
    "scope:manufacturing",
    "type:app",
    "product:alpha"
  ],
  "implicitDependencies": [
    "protocols"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "nx run manufacturing-alpha:containerize -c development"
        },
        "staging": {
          "command": "nx run manufacturing-alpha:containerize -c staging"
        },
        "production": {
          "command": "nx run manufacturing-alpha:containerize -c production"
        }
      },
      "cache": false
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/manufacturing/alpha/deploy/Dockerfile",
        "push": false,
        "load": true,
        "platforms": [
          "linux/amd64"
        ]
      },
      "configurations": {
        "development": {
          "tags": [
            "concord/manufacturing-alpha:development"
          ]
        },
        "staging": {
          "tags": [
            "concord/manufacturing-alpha:staging",
            "containers.ad.corekinect.com/concord-manufacturing-alpha:staging"
          ]
        },
        "production": {
          "tags": [
            "concord/manufacturing-alpha:production",
            "containers.ad.corekinect.com/concord-manufacturing-alpha:production"
          ]
        }
      },
      "cache": false
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping push for development'"
        },
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-manufacturing-alpha:staging"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-manufacturing-alpha:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "push"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping deploy for development'"
        },
        "staging": {
          "command": "./deploy/ctl.sh staging deploy"
        },
        "production": {
          "command": "./deploy/ctl.sh production deploy"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/manufacturing/alpha",
        "command": "echo 'Manufacturing tests require hardware (MTIB). Use: nx run manufacturing-alpha:test-hardware'"
      }
    },
    "test-hardware": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/manufacturing/alpha",
        "command": "PYTHONPATH=src:$(pwd)/../../../libs/python:$(pwd)/../../../libs:$(pwd)/../../../libs/protocols:. pytest tests/ -v"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/manufacturing/alpha",
        "command": "python3 -c \"import py_compile,glob;[py_compile.compile(f,doraise=True) for f in glob.glob('src/**/*.py',recursive=True)]\""
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "cp .env.example .env"
          }
        ],
        "parallel": false
      }
    }
  }
}
