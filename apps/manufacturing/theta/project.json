{
  "name": "manufacturing-theta",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/manufacturing/theta",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "/bin/bash -c 'docker compose -f deploy/docker-compose.yaml run --rm -it theta-manufacturing -remove-orphans'"
          }
        ]
      }
    },
    "build": {
      "command": "nx run manufacturing-theta:containerize",
      "cwd": "{workspaceRoot}"
    },
    "push": {
      "dependsOn": [
        "build"
      ],
      "command": "docker push containers.ad.corekinect.com/manufacturing-theta:latest"
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "cwd": "{workspaceRoot}",
      "options": {
        "context": "{workspaceRoot}",
        "file": "apps/manufacturing/theta/deploy/Dockerfile",
        "platforms": [
          "linux/amd64"
        ],
        "load": true,
        "push": false,
        "tags": [
          "containers.ad.corekinect.com/manufacturing-theta:latest"
        ]
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "cwd": "{projectRoot}",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "cp .env.example .env"
          }
        ],
        "parallel": false
      }
    }
  }
}