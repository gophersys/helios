{
    "name": "infra",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "deploy/infra",
    "projectType": "application",
    "targets": {
        "start": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "staging",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "staging": {
                    "command": "chmod +x ctl.sh && ./ctl.sh start --env=staging"
                },
                "production": {
                    "command": "chmod +x ctl.sh && ./ctl.sh start --env=production"
                }
            }
        },
        "update": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "staging",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "staging": {
                    "command": "chmod +x ctl.sh && ./ctl.sh update --env=staging"
                },
                "production": {
                    "command": "chmod +x ctl.sh && ./ctl.sh update --env=production"
                }
            }
        },
        "context": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "staging",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "staging": {
                    "command": "chmod +x ctl.sh && ./ctl.sh context --env=staging"
                },
                "production": {
                    "command": "chmod +x ctl.sh && ./ctl.sh context --env=production"
                }
            }
        },
        "status": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "staging",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "staging": {
                    "command": "chmod +x ctl.sh && ./ctl.sh status --env=staging"
                },
                "production": {
                    "command": "chmod +x ctl.sh && ./ctl.sh status --env=production"
                }
            }
        },
        "stop": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "staging",
            "options": {
                "cwd": "{projectRoot}"
            },
            "configurations": {
                "staging": {
                    "command": "chmod +x ctl.sh && ./ctl.sh stop --env=staging"
                },
                "production": {
                    "command": "chmod +x ctl.sh && ./ctl.sh stop --env=production"
                }
            }
        }
    },
    "tags": []
}