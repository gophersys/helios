{
  "name": "platform",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "deploy",
  "projectType": "application",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false
      },
      "configurations": {
        "development": {
          "commands": ["bash deploy/ctl.sh development start"]
        },
        "staging": {
          "commands": ["bash deploy/ctl.sh staging start"]
        },
        "production": {
          "commands": ["bash deploy/ctl.sh production start"]
        }
      }
    },

    "update": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false
      },
      "configurations": {
        "development": {
          "commands": ["bash deploy/ctl.sh development update"]
        },
        "staging": {
          "commands": ["bash deploy/ctl.sh staging update"]
        },
        "production": {
          "commands": ["bash deploy/ctl.sh production update"]
        }
      }
    },

    "stop": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": { "cwd": "{workspaceRoot}" },
      "configurations": {
        "development": {
          "commands": ["bash deploy/ctl.sh development stop"]
        },
        "staging": {
          "commands": ["bash deploy/ctl.sh staging stop"]
        },
        "production": {
          "commands": ["bash deploy/ctl.sh production stop"]
        }
      }
    },

    "ready": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "bash deploy/ctl.sh development ready"
        ]
      }
    },

    "status": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": { "cwd": "{workspaceRoot}" },
      "configurations": {
        "development": {
          "commands": ["bash deploy/ctl.sh development status"]
        },
        "staging": {
          "commands": ["bash deploy/ctl.sh staging status"]
        },
        "production": {
          "commands": ["bash deploy/ctl.sh production status"]
        }
      }
    },

    "logs": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": { "cwd": "{workspaceRoot}" },
      "configurations": {
        "development": {
          "commands": ["bash deploy/ctl.sh development logs"]
        },
        "staging": {
          "commands": ["bash deploy/ctl.sh staging logs"]
        },
        "production": {
          "commands": ["bash deploy/ctl.sh production logs"]
        }
      }
    },

    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "nx run-many -t test -p http-api corekinect app"
        ]
      }
    },

    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "PYTHONPATH=apps/backend/http-api/src:apps/backend/http-api:libs/python:libs:libs/protocols python3 -m pytest tests/integration/ -v --timeout=60"
        ]
      }
    },

    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "PYTHONPATH=apps/backend/http-api/src:libs/python:libs:libs/protocols python3 -m pytest tests/e2e/ -v --timeout=300 -x"
        ]
      }
    },

    "test:smoke": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "staging",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "staging": {
          "commands": [
            "python3 -m pytest tests/smoke/ -v --timeout=30 --target-url=https://staging.concord.local --api-key=ck_ci_admin_x8K2mP9vL4nQ7wR1tY6uI3oA5sD0fG"
          ]
        },
        "production": {
          "commands": [
            "python3 -m pytest tests/smoke/ -v --timeout=30 --target-url=https://concord.local --api-key=ck_ci_admin_x8K2mP9vL4nQ7wR1tY6uI3oA5sD0fG"
          ]
        }
      }
    },

    "diff": {
      "executor": "nx:run-commands",
      "options": { "cwd": "{workspaceRoot}" },
      "configurations": {
        "staging": {
          "commands": ["bash deploy/ctl.sh staging diff"]
        },
        "production": {
          "commands": ["bash deploy/ctl.sh production diff"]
        }
      }
    },

    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": true
      },
      "configurations": {
        "development": {
          "commands": [
            "nx run-many -t test -p http-api corekinect",
            "nx typecheck http-api",
            "nx typecheck app"
          ]
        },
        "staging": {
          "commands": [
            "nx run-many -t test -p http-api corekinect",
            "nx typecheck http-api",
            "nx typecheck app"
          ]
        }
      }
    },

    "release": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false
      },
      "configurations": {
        "staging": {
          "commands": [
            "echo '=== Concord Release → Staging ==='",
            "nx run platform:check -c staging",
            "bash deploy/ctl.sh staging update",
            "nx run platform:status -c staging",
            "nx run platform:test:smoke -c staging",
            "echo '=== Staging release complete ==='"
          ]
        },
        "production": {
          "commands": [
            "echo '=== Concord Release → Production ==='",
            "nx run platform:check -c staging",
            "bash deploy/ctl.sh production update",
            "nx run platform:status -c production",
            "nx run platform:test:smoke -c production",
            "echo '=== Production release complete ==='"
          ]
        }
      }
    }
  },
  "tags": []
}
