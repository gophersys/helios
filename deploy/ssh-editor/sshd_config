# deploy/ssh-editor/sshd_config — the restricted sshd posture for the read-only ssh-remote editor.
#
# This sshd exists for ONE purpose: let the user's native VS Code attach (ssh-remote) to a sandbox whose
# project worktree is mounted READ-ONLY. The posture is locked down to that need — public-key only, no
# root, no passwords, no agent/tcp forwarding, the eden user only.

# Listen on the standard SSH port inside the container; the host publishes it to 127.0.0.1:<port>.
Port 22
AddressFamily inet
ListenAddress 0.0.0.0

# Host keys live in the writable /etc/ssh (generated by the entrypoint at start, never baked).
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

# ── Authentication: PUBLIC KEY ONLY ───────────────────────────────────────────────────────────────.
# No root login, no passwords anywhere, no keyboard-interactive — a key or nothing.
PermitRootLogin no
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey

# Only the 'eden' user may ever log in (defence in depth on top of PermitRootLogin no).
AllowUsers eden

# The authorized key is provisioned at start into the eden user's home (entrypoint writes it from
# EDEN_SSH_EDITOR_AUTHORIZED_KEY). Keep the default AuthorizedKeysFile location.
AuthorizedKeysFile .ssh/authorized_keys

# ── Reduce the attack surface to the editor need ──────────────────────────────────────────────────.
# No forwarding of any kind — the editor needs none, and forwarding is a pivot surface.
AllowAgentForwarding no
AllowTcpForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no

# Keep idle sessions from lingering; a desktop editor reconnects cleanly.
ClientAliveInterval 120
ClientAliveCountMax 3
LoginGraceTime 30
MaxAuthTries 3
MaxSessions 10

# ── sftp: required for the VS Code Server bootstrap ───────────────────────────────────────────────.
# VS Code Server copies its server tarball to the remote home over the sftp subsystem before unpacking
# and launching it. Use the in-process sftp implementation (no external binary on alpine).
Subsystem sftp internal-sftp

# Quiet, predictable logging (no DNS reverse lookups → faster, no name-resolution dependency).
UseDNS no
PrintMotd no
LogLevel INFO
