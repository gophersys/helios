{
    "name": "cloud",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "deploy/cloud",
    "projectType": "application",
    "targets": {
        "build-vault": {
            "executor": "nx:run-commands",
            "options": {
                "command": "nx run cloud:containerize-vault",
                "cwd": "{workspaceRoot}"
            }
        },
        "containerize-vault": {
            "executor": "@nx-tools/nx-container:build",
            "options": {
                "file": "deploy/cloud/development/build/vault/Dockerfile",
                "context": "{workspaceRoot}",
                "cwd": "{projectRoot}",
                "push": false,
                "load": true,
                "tags": [
                    "concord-vault:latest"
                ],
                "platforms": []
            }
        },
        "push": {
            "executor": "nx:run-commands",
            "options": {
                "command": "",
                "cwd": "{workspaceRoot}"
            },
            "defaultConfiguration": "staging",
            "configurations": {
                "staging": {
                    "command": "nx run-many --target=push --projects=http-api -c staging --skip-nx-cache"
                },
                "production": {
                    "command": "nx run-many --target=push --projects=http-api -c production --skip-nx-cache"
                }
            }
        },
        "start": {
            "executor": "nx:run-commands",
            "options": {
                "parallel": false
            },
            "defaultConfiguration": "development",
            "configurations": {
                "development": {
                    "cwd": "{workspaceRoot}",
                    "commands": [
                        {
                            "command": "docker network create concord_network || true"
                        },
                        {
                            "command": "nx run cloud:build-vault"
                        },
                        {
                            "command": "bash -c 'cd deploy/cloud && docker compose -f development/docker-compose.yaml up -d'"
                        },
                        {
                            "command": "bash -c 'cd deploy/cloud/development && chmod +x ctl.sh && ./ctl.sh'"
                        }
                    ]
                },
                "staging": {
                    "commands": [
                        {
                            "command": "nx run infra:context:staging"
                        },
                        {
                            "command": "chmod +x ctl.sh && ./ctl.sh start --env=staging"
                        },
                        {
                            "command": "nx run lb-updater:update-engine"
                        }
                    ]
                },
                "production": {
                    "commands": [
                        {
                            "command": "nx run infra:context:production"
                        },
                        {
                            "command": "nx run-many --target=push --projects=http-api,runtime,orchestrator,collector -c production --skip-nx-cache"
                        },
                        {
                            "command": "chmod +x ctl.sh && ./ctl.sh start --env=production"
                        },
                        {
                            "command": "nx run lb-updater:update-engine"
                        }
                    ]
                }
            }
        },
        "update": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "{projectRoot}/production",
                "parallel": false
            },
            "defaultConfiguration": "development",
            "configurations": {
                "development": {
                    "cwd": "{workspaceRoot}",
                    "parallel": false,
                    "commands": [
                        {
                            "command": "nx run-many --target=build --projects=http-api -c development --skip-nx-cache"
                        },
                        {
                            "command": "bash -c 'cd deploy/cloud/development && chmod +x ctl.sh && ./ctl.sh'"
                        },
                        {
                            "command": "bash -c 'cd deploy/cloud && docker compose -f development/docker-compose.yaml up -d'"
                        }
                    ]
                },
                "staging": {
                    "commands": [
                        {
                            "command": "nx run infra:context:staging"
                        },
                        {
                            "command": "chmod +x ctl.sh && ./ctl.sh update --env=staging"
                        },
                        {
                            "command": "nx run lb-updater:update-engine"
                        },
                        {
                            "command": "nx build nodes -c staging --skip-nx-cache"
                        }
                    ]
                },
                "production": {
                    "commands": [
                        {
                            "command": "nx run infra:context:production"
                        },
                        {
                            "command": "nx run-many --target=push --projects=http-api,runtime,orchestrator,collector -c production --skip-nx-cache"
                        },
                        {
                            "command": "chmod +x ctl.sh && ./ctl.sh update --env=production"
                        },
                        {
                            "command": "nx run lb-updater:update-engine"
                        },
                        {
                            "command": "nx build nodes -c production --skip-nx-cache"
                        }
                    ]
                }
            }
        },
        "stop": {
            "executor": "nx:run-commands",
            "options": {
                "parallel": false
            },
            "defaultConfiguration": "development",
            "configurations": {
                "development": {
                    "cwd": "{workspaceRoot}",
                    "commands": [
                        {
                            "command": "bash -c 'cd deploy/cloud/development && docker compose -f docker-compose.yaml down -v --remove-orphans'"
                        }
                    ]
                },
                "staging": {
                    "commands": [
                        {
                            "command": "nx run infra:context:staging"
                        },
                        {
                            "command": "chmod +x ctl.sh && ./ctl.sh stop --env=staging"
                        }
                    ]
                },
                "production": {
                    "commands": [
                        {
                            "command": "nx run infra:context:production"
                        },
                        {
                            "command": "chmod +x ctl.sh && ./ctl.sh stop --env=production"
                        }
                    ]
                }
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "commands": []
            },
            "defaultConfiguration": "local",
            "configurations": {
                "local": {
                    "cwd": "{projectRoot}/test/stress",
                    "commands": [
                        {
                            "command": "bash -c 'chmod +x ctl.sh && ./ctl.sh start --env=local'"
                        }
                    ]
                },
                "staging": {
                    "commands": []
                },
                "production": {
                    "commands": []
                }
            }
        }
    },
    "tags": []
}