# Concord — Local Environment
# Copy to .env and adjust as needed:  cp .env.example .env

# App version (auto-set by ctl.sh, or override manually)
APP_VERSION=local

# Server
SERVER_PORT=9001
LOG_LEVEL=4
LOG_PATH=logs

# Database (points to Docker container)
DATABASE_URL=postgresql://concord:concord@db:5432/concord

# Storage (MinIO in Docker)
STORAGE_URL=minio:8675
STORAGE_ACCESS_KEY=concord
STORAGE_SECRET_ACCESS_KEY=concordstorage!
STORAGE_BUCKET_NAME=concord

# Auth (disabled for local development)
AUTH_ENABLED=false

# Filesystem DB (legacy)
DB_STORAGE_PATH=db
DB_STORAGE_LIMIT_GB=64
SUPPORTED_REGISTRIES=

# Assets
ASSETS_FOLDER=assets

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=concord-influxdb-dev-token
INFLUXDB_ORG=concord
INFLUXDB_BUCKET_TELEMETRY=telemetry_raw
INFLUXDB_BUCKET_METRICS=telemetry_metrics

# Manufacturing (optional)
COREOPS_SERVER_URL=
DELETE_ALL_KEY=local-dev-key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# MTIB gRPC port
MTIB_PORT=50053
