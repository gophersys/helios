{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "corekinect",
  "root": "libs/python",
  "sourceRoot": "libs/python/corekinect",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "libs/python",
        "commands": [
          "python3 -m build --wheel --outdir dist/"
        ]
      },
      "configurations": {
        "development": {},
        "staging": {},
        "production": {}
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "defaultConfiguration": "development",
      "options": { "cwd": "libs/python" },
      "configurations": {
        "development": { "commands": ["twine upload --repository-url http://localhost:8091 --username '' --password '' --disable-progress-bar dist/*.whl"] },
        "staging": { "commands": [
          "kubectl port-forward -n staging svc/concord-pypi 18080:8080 &",
          "sleep 2",
          "twine upload --repository-url http://localhost:18080 --username '' --password '' --disable-progress-bar dist/*.whl",
          "kill %1 2>/dev/null || true"
        ] },
        "production": { "commands": [
          "kubectl port-forward -n production svc/concord-pypi 18081:8080 &",
          "sleep 2",
          "twine upload --repository-url http://localhost:18081 --username '' --password '' --disable-progress-bar dist/*.whl",
          "kill %1 2>/dev/null || true"
        ] }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "PYTHONPATH=libs/python:libs:libs/protocols python3 -m pytest libs/python/corekinect/test/tests/ -v --timeout=30"
        ]
      }
    }
  }
}
