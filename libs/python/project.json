{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "corekinect",
  "root": "libs/python",
  "sourceRoot": "libs/python/corekinect",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "libs/python",
        "commands": [
          "rm -rf protocols && cp -r ../protocols protocols && python3 -m build --wheel --outdir dist/ && rm -rf protocols"
        ]
      },
      "configurations": {
        "development": {},
        "staging": {},
        "production": {}
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "libs/python"
      },
      "configurations": {
        "development": {
          "commands": [
            "twine upload --repository-url http://localhost:8091 --username '' --password '' --disable-progress-bar dist/*.whl"
          ]
        },
        "staging": {
          "commands": [
            "kubectl port-forward -n staging svc/concord-pypi 18080:8080 &",
            "sleep 2",
            "twine upload --repository-url http://localhost:18080 --username '' --password '' --disable-progress-bar dist/*.whl",
            "kill %1 2>/dev/null || true"
          ]
        },
        "production": {
          "commands": [
            "kubectl port-forward -n production svc/concord-pypi 18081:8080 &",
            "sleep 2",
            "twine upload --repository-url http://localhost:18081 --username '' --password '' --disable-progress-bar dist/*.whl",
            "kill %1 2>/dev/null || true"
          ]
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/python",
        "command": "python3 -m pytest"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/python",
        "command": "python3 -m pytest --cov=corekinect --cov-fail-under=60 --cov-report=term-missing -q --tb=no"
      }
    },
    "complexity": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "python3 .ci/lib/check_complexity.py libs/python/corekinect/ --allowlist=.ci/complexity-allowlist.json --avg-threshold=6"
      }
    },
    "security": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/python",
        "command": "python3 -m bandit -r corekinect/ -lll -iii -q --exclude corekinect/test/.venv"
      }
    }
  }
}
