meta {
  name: Create Fuota Plan
  type: http
  seq: 1
}

post {
  url: {{singletonHostname}}/firmwareupdates/plans
  body: json
  auth: inherit
}

body:json {
  {
    "stages": [
      {
        "targets": [
          "100.0.1.1-BM",
          "101.0.1.1-BM"
        ],
        "description": "Factory image",
        "isSkippable": true
      },
      {
        "targets": [
          "100.0.1.2-BM",
          "101.0.1.2-BM"
        ],
        "description": "Latest",
        "isSkippable": false
      }
    ],
    "description": "Test update plan",
    "deviceTypeId": 1,
    "deviceVariantId": 1,
    "ignoreTargetAppIds": false
  }
}
