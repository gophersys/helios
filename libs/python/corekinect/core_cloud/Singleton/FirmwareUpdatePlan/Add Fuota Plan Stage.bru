meta {
  name: Add Fuota Plan Stage
  type: http
  seq: 5
}

post {
  url: {{singletonHostname}}/firmwareupdates/plans/AddStage
  body: json
  auth: inherit
}

body:json {
  {
      "planId": 1,
      "stage": {
        "targets": [
          "101.0.1.4-BM",
          "100.0.1.4-BM"
        ],
        "description": "Release 4.0",
        "isSkippable": true
      }
  }
}
