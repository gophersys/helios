meta {
  name: Register Logins
  type: http
  seq: 1
}

post {
  url: {{restServerHostname}}/authentication/logins/register
  body: json
  auth: inherit
}

body:json {
  {
    "Logins": [
      {
        "LoginId": 1,
        "AccountId": 1,
        "IsPrivileged": true
      }
    ]
  }
}
