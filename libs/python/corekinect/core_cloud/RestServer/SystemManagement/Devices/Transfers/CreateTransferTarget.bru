meta {
  name: Create Transfer Target
  type: http
  seq: 1
}

post {
  url: {{restServerHostname}}/system/devices/transfers/targets/create
  body: json
  auth: inherit
}

body:json {
  {
    "Name": "Target name",
    "RequireDnssec": false,
    "ServerBaseUrl": "https://corecloud.com:1234",
    "DeviceRekeyPath": "/System/Devices/Create-Device-SSv1-Session",
    "SessionGenerationServerPort": 1234,
    "DataServerPort": 1234,
    "TimeServerPort": 1234,
    "TimeServerPublicKey": "public key"
  }
}
