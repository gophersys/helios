meta {
  name: Set Configs
  type: http
  seq: 1
}

put {
  url: {{restServerHostname}}/System/Devices/Configurations/GroundMode
  body: json
  auth: inherit
}

body:json {
  {
    "DeviceIds": [
      "70B3D584C0201234"
    ],
    "GpsHeartbeatPeriod": 1,
    "ContinuousMotionPeriod": 1,
    "StopMotionTimeout": 1,
    "HeartbeatAcquisitionTimeout": 1,
    "MotionAcquisitionTimeout": 1,
    "MotionAcquisitionOnTime": 1,
    "MotionInitialAcquisitionOnTime": 1,
    "XlrMotionThreshold": 1,
    "XlrMotionDuration": 1,
    "StartMotionWindowStart": 1,
    "StartMotionWindowEnd": 1
  }
}

settings {
  encodeUrl: true
}
