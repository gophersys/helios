meta {
  name: Update Login Roles
  type: http
  seq: 7
}

post {
  url: {{restServerHostname}}/Authorization/Grants/LoginRoles?loginId=1
  body: json
  auth: inherit
}

query {
  loginId: 1
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
      "roleKeysToGrant": [
          "Admin"
      ],
      "roleKeysToRevoke": [
          
      ]
  }
}
