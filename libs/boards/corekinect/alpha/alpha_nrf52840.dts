/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "alpha_nrf52840-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Corekinect Alpha NRF52840";
	compatible = "corekinect,alpha-nrf52840";

	chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
        zephyr,uart-mcumgr = &uart0;
        zephyr,bt-mon-uart = &uart0;
        zephyr,bt-c2h-uart = &uart0;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
    };

    zephyr,user {
        io-channels = <&adc 0>;
    };

    leds {
        compatible = "gpio-leds";
    };

    control_pins {
        compatible = "gpio-leds";
        chrg_en: chrg_en {
            gpios = <&gpio1 15 GPIO_PULL_UP>;
            label = "Battery Charger Enable";
        };
        qi_ctrl: qi_ctrl {
            gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
            label = "Qi Charger Enable";
        };
    };

    interrupts {
        compatible = "gpio-keys";
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>; /* P0.02 */
        zephyr,resolution = <10>;
    };
};

&gpiote {
    status = "okay";
    interrupts = <6 NRF_DEFAULT_IRQ_PRIORITY>;
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};

&uart1 {
    status = "okay";
    current-speed = <460800>;
    pinctrl-0 = <&lpuart_uart1_default>;
    pinctrl-1 = <&lpuart_uart1_sleep>;
    pinctrl-names = "default", "sleep";

    lpuart: nrf-sw-lpuart {
        compatible = "nordic,nrf-sw-lpuart";
        status = "okay";
        req-pin = <17>; // IPC_NRF91_RDY
        rdy-pin = <16>; // IPC_NRF91_REQ
    };
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    cs-gpios = <&gpio0 29 (GPIO_ACTIVE_LOW)>;

    ubx_m8: ubx-m8@0 {
        compatible = "u-blox,zoe-m8-spi";
        reg = <0>;
        reset-n-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
        ext-int-gpios = <&gpio1 14 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
        gps-en-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
        psm-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
        spi-max-frequency = <1000000>;
    };
};

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    lis2de12_i2c: lis2de12_i2c@0 {
        compatible = "st,lis2de12-i2c";
        reg = <0>;
        int-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>,
                    <&gpio1 6 GPIO_ACTIVE_HIGH>;
    };

    bmp388_i2c: bmp388_i2c@1 {
        compatible = "bosch,bmp388-i2c";
        reg = <1>;
        int-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
    };

    maxim_17055_i2c: maxim_17055_i2c@2 {
        compatible = "maxim,17055";
        reg = <2>;
        int-gpios = <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 0x0000C000>;
        };
        slot0_partition: partition@c000 {
            label = "image-0";
            reg = <0x0000C000 0x00072000>;
        };
        slot1_partition: partition@7e000 {
            label = "image-1";
            reg = <0x0007E000 0x00072000>;
        };
        storage_partition: partition@f0000 {
            label = "storage";
            reg = <0x000F0000 0x00006000>;
        };

        /* Add a new reserved partition for the pre-compiled library */
        psp_rom_partition: partition@e0000 {
            label = "psp_rom";
            reg = <0x000E0000 0x00012FDE>; /* Reserve the required address range */
        };
    };
};
