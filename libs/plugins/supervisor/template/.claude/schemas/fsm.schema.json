{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eden.gophersys.dev/supervisor/fsm.schema.json",
  "title": "Supervisor lifecycle FSM",
  "description": "The structure of state/fsm.json. The supervisor's deterministic transition table.",
  "type": "object",
  "required": ["version", "current_state", "states", "transitions"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "current_state": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "terminal"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "terminal": { "type": "boolean" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transition", "command", "from", "artifact", "schema", "guard"],
        "additionalProperties": true,
        "properties": {
          "transition": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "pattern": "^/[a-z][a-z-]*$" },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "to": { "type": "string" },
          "to_when": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["to", "git_predicate", "path"],
              "properties": {
                "to": { "type": "string" },
                "git_predicate": { "enum": ["present", "absent", "any-under", "none-under"] },
                "path": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "artifact": { "type": "string", "minLength": 1 },
          "schema": { "type": "string", "minLength": 1 },
          "guard": {
            "type": "object",
            "required": ["id", "git_predicate", "path"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "git_predicate": { "enum": ["present", "absent", "any-under", "none-under"] },
              "path": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
