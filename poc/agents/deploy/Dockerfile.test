FROM oven/bun:1.3 AS omp-base
RUN bun add -g @oh-my-pi/pi-coding-agent@15.9.67

FROM golang:1.26 AS go-build
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go test -c -o /build/agent.test ./pkg/agent/

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl procps && rm -rf /var/lib/apt/lists/*
COPY --from=omp-base /root/.bun /root/.bun
RUN ln -s /root/.bun/bin/omp /usr/local/bin/omp
COPY --from=go-build /build/agent.test /usr/local/bin/agent.test
COPY deploy/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/usr/local/bin/agent.test", "-test.v", "-test.timeout=300s"]