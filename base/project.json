{
  "name": "images-base",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:shared", "type:container-image"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh build",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "build-multi-arch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh build-multi-arch",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh push",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh pull",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "inspect": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh inspect",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
