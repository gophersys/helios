# -------- docker cli-plugins (version + release-asset digest) --------
# The vocabulary is the PLATFORM spelling and not the asset spelling: these 2
# rows were _X86_64 and _AMD64 for the same platform, which read as 2
# vocabularies. The values did not change. The _AARCH64 and _ARM64 rows went
# with the `linux/arm64)` case arms they fed — SANCTIONED_PLATFORMS is
# linux/amd64 alone, and a digest nothing compares is a check that cannot fail.
DOCKER_COMPOSE_VERSION=5.1.3                                           # latest LTS as of 2026-04-19
DOCKER_COMPOSE_SHA256_AMD64=a0298760c9772d2c06888fc8703a487c94c3c3b0134adeef830742a2fc7647b4  # upstream-published: https://github.com/docker/compose/releases/download/v5.1.3/checksums.txt
DOCKER_BUILDX_VERSION=0.36.1                                           # latest stable as of 2026-08-13
DOCKER_BUILDX_SHA256_AMD64=48af8a397ebd60178778bf63611dbcebe5f5e7a9be90eb9147b24b9587455778  # upstream-published: https://github.com/docker/buildx/releases/download/v0.36.1/checksums.txt

