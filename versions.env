KIND_VERSION=0.32.0                                                    # latest LTS as of 2026-06-13
TAILSCALE_VERSION=1.96.4                                               # latest LTS as of 2026-04-19
BW_VERSION=2026.3.0                                                    # latest LTS as of 2026-04-19
GH_VERSION=2.90.0                                                      # latest LTS as of 2026-04-19
NATS_VERSION=0.3.2                                                     # latest LTS as of 2026-04-19

