# versions.env — the ONE home for every tool version of the cloud image family.
#
# One line per pin, shell-sourceable `NAME=value`, exact versions, no ranges.
# The build generates `--build-arg NAME=value` for every line of this file
# (`versions_env_build_args` in _ctl/lib.sh; the cloud CI job reads it the same
# way), and cloud/Dockerfile declares each name as a value-less ARG at the top.
# No Dockerfile of the new mechanism carries a hand-written pin: to change a
# version you edit 1 line HERE and nothing else. A missing pin FAILS the build
# and names the variable.
#
# The harness pins (claude/omp/codex) mirror eden harnesses/versions.env
# (ADR-0021). Until the consumer migration lands, the 2 files MUST move
# together — the same debt runner/Dockerfile carries today, recorded in
# gophersys/infrastructure docs/debt-register.md.

# -------- base OS --------
# The ubuntu:24.04 INDEX digest, not a per-platform one: buildx still has to
# choose the manifest for the platform it builds. Under the moving tag, 2 builds
# of 1 commit produce 2 different operating systems. base/Dockerfile holds the
# same value as an ARG default, and _ctl/tests/scheduled-workflows.test.sh holds
# the 2 homes to 1 digest. `bash ./ctl.sh base-currency` reports a move; the
# nightly runs it every night.
UBUNTU_BASE_REF=sha256:561618e2c15bf2397621dd04f96926663a3b5616c189cf7e38db7e82f5c538ea   # ubuntu:24.04 index digest as of 2026-08-16

# -------- shell --------
ZSH_VERSION=5.9                                                        # latest LTS as of 2026-04-19

# -------- node toolchain --------
# The nvm digest covers the INSTALLER SCRIPT only: node itself is fetched by
# that script, and node's own download is out of scope. _NOARCH says the 1
# asset serves every platform.
NVM_VERSION=0.40.4                                                     # latest LTS as of 2026-04-19
NVM_SHA256_NOARCH=4b7412c49960c7d31e8df72da90c1fb5b8cccb419ac99537b737028d497aba4f  # computed-at-pin: 2026-08-17
NODE_VERSION=24.15.0                                                   # latest LTS as of 2026-04-19 (Krypton)
NPM_VERSION=11.19.0                                                    # latest LTS as of 2026-08-17
PNPM_VERSION=11.22.0                                                   # what corepack pnpm@latest resolved on 2026-08-16
BUN_VERSION=1.3.14                                                     # latest stable as of 2026-06-13
BUN_SHA256_AMD64=951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f  # upstream-published: https://github.com/oven-sh/bun/releases/download/bun-v1.3.14/SHASUMS256.txt

# -------- python --------
# The uv digest covers the INSTALLER SCRIPT only, for the reason the nvm row gives.
PYTHON_PACKAGE=python3.12                                              # latest LTS as of 2026-04-19
UV_VERSION=0.11.7                                                      # latest LTS as of 2026-04-19
UV_SHA256_NOARCH=efed99618cb5c31e4e36a700ab7c3698e83c0ae0f3c336714043d0f932c8d32c  # computed-at-pin: 2026-08-17

# -------- go + gate tools (ADR-0018 + ADR-0020) --------
