CLAUDE_CODE_VERSION=2.1.212                                            # MUST match eden harnesses/versions.env
OMP_VERSION=17.2.5                                                     # MUST match eden harnesses/versions.env
CODEX_VERSION=0.146.0                                                  # MUST match eden harnesses/versions.env

# -------- ready components, consumed by NO image today (extension points) ----
TERRAFORM_VERSION=1.14.8                                               # latest LTS as of 2026-04-19
AWS_CLI_VERSION=2.34.32                                                # latest LTS as of 2026-04-20
# The aws digest lives here because base/Dockerfile installs the aws cli and
# declares AWS_CLI_VERSION in BOTH homes; a digest has to follow its version, or
# a bump edits one home and misses the other. No cloud-family image fetches it:
# _delta/components/aws.sh is a ready component nothing calls (ledger #103), and
# its download carries the not-installed-today exemption instead.
AWS_CLI_SHA256_AMD64=ad983363b8286928b37bec605348255ddc39e73ba2e79a969ed1c034fe2dc8b3  # computed-at-pin: 2026-08-17
OCI_CLI_VERSION=3.79.0                                                 # latest LTS as of 2026-04-20
ANSIBLE_VERSION=13.5.0                                                 # latest LTS as of 2026-04-19
ANSIBLE_CORE_VERSION=2.20.4                                            # latest LTS as of 2026-04-20
