GO_SHA256_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053  # upstream-published: https://go.dev/dl/?mode=json
GOFUMPT_VERSION=0.10.0                                                 # latest LTS as of 2026-06-13
GOLANGCI_LINT_VERSION=2.12.2                                           # latest LTS as of 2026-06-13
GOVULNCHECK_VERSION=1.1.4                                              # latest LTS as of 2026-06-13
GOSEC_VERSION=2.28.0                                                   # latest LTS as of 2026-08-17
HNSLINT_VERSION=0.1.0                                                  # latest as of 2026-08-11 - gophersys/hnslint
GREMLINS_VERSION=0.6.0                                                 # latest LTS as of 2026-06-13 - needs >=0.6.0 for unleash --exclude-files
BENCHSTAT_REF=latest                                                   # x/perf is untagged; track @latest
DELVE_VERSION=1.27.1                                                   # latest stable as of 2026-08-16

# -------- parsing + QA --------
# A digest sits beside its version, in this same file, so a bump is 2 adjacent
# lines. 2 homes apart means the bump misses one, and a stale digest FAILS the
# build at the download naming the pin.
YQ_VERSION=4.53.3                                                      # latest LTS as of 2026-08-17
YQ_SHA256_AMD64=fa52a4e758c63d38299163fbdd1edfb4c4963247918bf9c1c5d31d84789eded4  # upstream-published: https://github.com/mikefarah/yq/releases/download/v4.53.3/checksums
