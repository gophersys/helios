{
  "name": "env",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/env",
  "projectType": "application",
  "tags": ["type:tool"],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/env/setup.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/env/setup.sh --validate",
        "cwd": "{workspaceRoot}"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "staging",
      "configurations": {
        "staging": {
          "command": "bash tools/env/setup.sh --check staging"
        },
        "production": {
          "command": "bash tools/env/setup.sh --check production"
        }
      },
      "options": {
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
