{
  "name": "corectl",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/corectl",
  "projectType": "application",
  "tags": ["scope:tools", "type:cli"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "tools/corectl",
        "command": "pip install build && python -m build"
      },
      "configurations": {
        "development": {},
        "staging": {},
        "production": {}
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "defaultConfiguration": "development",
      "options": { "cwd": "tools/corectl" },
      "configurations": {
        "development": { "command": "twine upload --repository-url http://localhost:8091 --username '' --password '' --disable-progress-bar dist/*.whl" },
        "staging": { "commands": [
          "kubectl port-forward -n staging svc/concord-pypi 18080:8080 &",
          "sleep 2",
          "twine upload --repository-url http://localhost:18080 --username '' --password '' --disable-progress-bar dist/*.whl",
          "kill %1 2>/dev/null || true"
        ] },
        "production": { "commands": [
          "kubectl port-forward -n production svc/concord-pypi 18081:8080 &",
          "sleep 2",
          "twine upload --repository-url http://localhost:18081 --username '' --password '' --disable-progress-bar dist/*.whl",
          "kill %1 2>/dev/null || true"
        ] }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/corectl",
        "command": "pip install -e . && corectl --version && corectl auth status"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/corectl",
        "command": "pip install -e ."
      }
    },
    "publish-wheel": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "defaultConfiguration": "staging",
      "options": { "cwd": "tools/corectl" },
      "configurations": {
        "staging": {
          "commands": [
            "pip install --quiet --upgrade twine",
            "kubectl port-forward -n staging svc/concord-pypi 18080:8080 >/dev/null 2>&1 & PF=$!; sleep 2; twine upload --repository-url http://localhost:18080 --username '' --password '' --disable-progress-bar --skip-existing dist/*.whl; rc=$?; kill $PF 2>/dev/null || true; wait $PF 2>/dev/null || true; exit $rc"
          ],
          "parallel": false
        },
        "production": {
          "commands": [
            "pip install --quiet --upgrade twine",
            "kubectl port-forward -n production svc/concord-pypi 18081:8080 >/dev/null 2>&1 & PF=$!; sleep 2; twine upload --repository-url http://localhost:18081 --username '' --password '' --disable-progress-bar --skip-existing dist/*.whl; rc=$?; kill $PF 2>/dev/null || true; wait $PF 2>/dev/null || true; exit $rc"
          ],
          "parallel": false
        }
      }
    }
  }
}
