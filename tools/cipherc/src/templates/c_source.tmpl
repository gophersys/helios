#include "{{ .ProtoFileName }}.cipher.h"

// Zephyr includes
#include <zephyr/kernel.h>
#include <zephyr/logging/log.h>

// Corekinect includes
#include <corekinect/iface/iface.h>
#include <corekinect/cipher/cipher.h>

// Protobuf includes
#include "{{ .ProtoFileName }}.pb.h"

LOG_MODULE_REGISTER({{ .ServiceNameLowerCase }});

#define {{ .ServiceName | ToUpper }}_SERVICE_ID {{ .ServiceID }}

typedef enum
{
    {{- range .RPCs }}
    rpc_{{ .Name }} = {{ .ID }},
    {{- end }}
} {{ .ServiceName }}_rpc;

{{- range .RPCs }}

// Server side
static bool {{ .ServiceName }}_{{ .Name }}HandlerImplemented = true;
__attribute__((weak)) {{ .ReturnsType  }} {{ .ServiceName }}_{{ .Name }}Handler({{ .RequestType }} request)
{
    LOG_WRN("%s default implementation called", __func__);
    {{ .ServiceName }}_{{ .Name }}HandlerImplemented = false;
    {{ .ReturnsType  }} response  = {0};
    return response ;
}

cipher_rpc_err_t {{ .Name }}RpcPrvHandler(void *request, void *response)
{
    // Call the actual handler function
    *(({{ .ReturnsType  }} *)response ) = {{ .ServiceName }}_{{ .Name }}Handler(*(({{ .RequestType }} *)request));
    return {{ .ServiceName }}_{{ .Name }}HandlerImplemented ? CIPHER_RPC_ERR_OK : CIPHER_RPC_ERR_NOT_IMPLEMENTED;
}
{{- end }}

// Client side
{{- range .RPCs }}
{{ .ReturnsType  }} {{ .ServiceName }}_{{ .Name }}Rpc(cipher_unary_rpc_user_info_t *info, {{ .RequestType }} request)
{
    {{ .ReturnsType  }} response  = {0};

    cipher_daemon_rpc_context_t context =
    {
        .local = true,
        .user_info = info,
        .service_id = {{ .ServiceName | ToUpper }}_SERVICE_ID,
        .rpc_id = rpc_{{ .Name }},
        .request_struct = &request,
        .request_struct_size = sizeof(request),
        .response_struct = &response ,
        .response_struct_size = sizeof(response)
    };

    cipher_daemon_execute_remote_rpc(&context);
    return response;
}
{{- end }}

static cipher_rpc_info_t {{ .ServiceNameLowerCase }}_rpcs[] =
{
    {{- range .RPCs }}
    {
        .id = rpc_{{ .Name }},
        .type = CIPHER_RPC_TYPE_UNARY,
        .name = "{{ .Name }}",
        .handler = {{ .Name }}RpcPrvHandler,
        .request_info = {
            .fields = {{ .RequestType }}_fields,
            .encoded_size = {{ .RequestType }}_size,
            .decoded_size = sizeof({{ .RequestType }})
        },
        .response_info = {
            .fields = {{ .ReturnsType  }}_fields,
            .encoded_size = {{ .ReturnsType  }}_size,
            .decoded_size = sizeof({{ .ReturnsType  }})
        },
        .supports_parallelism = true,
    },
    {{- end }}
};

static cipher_service_info_t {{ .ServiceNameLowerCase }}_service =
{
    .id = {{ .ServiceName | ToUpper }}_SERVICE_ID,
    .name = "{{ .ServiceName }}",
    .max_hops = 1,
    .rpcs = {{ .ServiceNameLowerCase }}_rpcs,
    .num_rpcs = ARRAY_SIZE({{ .ServiceNameLowerCase }}_rpcs),
};

cipher_service_info_t *get_{{ .ServiceNameLowerCase }}service_info(void)
{
    return &{{ .ServiceNameLowerCase }}_service;
}
