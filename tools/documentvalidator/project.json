{
  "name": "documentvalidator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:tools", "type:go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh build", "cwd": "{projectRoot}" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh test", "cwd": "{projectRoot}" },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh lint", "cwd": "{projectRoot}" },
      "cache": false
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh validate", "cwd": "{projectRoot}" },
      "cache": false
    }
  }
}
