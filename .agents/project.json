{
  "name": "agents",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": ".agents",
  "targets": {
    "check": { "command": "./ctl.sh check", "options": { "cwd": "{projectRoot}" }, "cache": false },
    "sync": { "command": "./ctl.sh sync", "options": { "cwd": "{projectRoot}" }, "cache": false },
    "status": { "command": "./ctl.sh status", "options": { "cwd": "{projectRoot}" }, "cache": false },
    "review": { "command": "./ctl.sh review", "options": { "cwd": "{projectRoot}" }, "cache": false }
  }
}
