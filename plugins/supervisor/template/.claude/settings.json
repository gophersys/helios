{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git ls-files:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(bash ./.claude/commands/state-show.sh:*)",
      "Bash(bash ./.claude/commands/propose-questionnaire.sh:*)",
      "Bash(bash ./.claude/commands/record-answer.sh:*)",
      "Bash(bash ./.claude/commands/propose-charter.sh:*)",
      "Bash(bash ./.claude/commands/ratify-charter.sh:*)",
      "Bash(bash ./.claude/commands/propose-work-item.sh:*)",
      "Bash(bash ./.claude/commands/open-decision.sh:*)",
      "Bash(bash ./.claude/commands/rule-decision.sh:*)",
      "Bash(bash ./.claude/commands/plan.sh:*)",
      "Bash(bash ./.claude/commands/advance.sh:*)",
      "mcp__eden__eden_commit_transition"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-tool.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-commit.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
