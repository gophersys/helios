{
  "$description": "Eden design tokens v0 — the F6 design-system artifact (05 §2, doc 11 §2). DTCG-shaped. Source of truth: documents/intake/2026-06-12-design-assets.pdf (intake C21). Consumed by apps/frontend and the docs/tools renderers; photosphere absorbs this as its seed theme (ADR-0005).",
  "color": {
    "deep-forest": { "$type": "color", "$value": "#243D2C", "$description": "Primary surface" },
    "moss": { "$type": "color", "$value": "#5C7F5C", "$description": "Signature accent" },
    "sage": { "$type": "color", "$value": "#A8B89C", "$description": "Soft support" },
    "bone": { "$type": "color", "$value": "#F4F1E8", "$description": "Background / text on dark" },
    "ink": { "$type": "color", "$value": "#1A1A1A", "$description": "Text on light" }
  },
  "semantic": {
    "background": { "$type": "color", "$value": "{color.bone}" },
    "text": { "$type": "color", "$value": "{color.ink}" },
    "surface-primary": { "$type": "color", "$value": "{color.deep-forest}" },
    "text-on-surface": { "$type": "color", "$value": "{color.bone}" },
    "accent": { "$type": "color", "$value": "{color.moss}" },
    "support": { "$type": "color", "$value": "{color.sage}" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"], "$description": "Display role — headings" },
    "text": { "$type": "fontFamily", "$value": ["Inter", "-apple-system", "Segoe UI", "sans-serif"], "$description": "Text role — body" },
    "code": { "$type": "fontFamily", "$value": ["JetBrains Mono", "SF Mono", "ui-monospace", "monospace"], "$description": "Code role" }
  },
  "typography": {
    "display-1": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "96px", "fontWeight": 900 } },
    "display-2": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "64px", "fontWeight": 600 } },
    "heading-1": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "40px", "fontWeight": 600 } },
    "heading-2": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "28px", "fontWeight": 400 } },
    "lead": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "24px", "fontWeight": 400 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "18px", "fontWeight": 400 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "14px", "fontWeight": 500 } },
    "micro": { "$type": "typography", "$value": { "fontFamily": "{font.text}", "fontSize": "12px", "fontWeight": 600, "letterSpacing": "0.08em", "textTransform": "uppercase" } },
    "code": { "$type": "typography", "$value": { "fontFamily": "{font.code}", "fontSize": "16px", "fontWeight": 400 } }
  }
}
