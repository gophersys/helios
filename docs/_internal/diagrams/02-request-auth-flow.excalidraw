    {
      "type": "text",
      "id": "api_key_section",
      "x": 880,
      "y": 225,
      "width": 300,
      "height": 55,
      "text": "API Key Format: ck_run_<token> or ck_ci_*\nStored: SHA-256(key) in apikey table\nHeader: Authorization: ApiKey ck_run_*",
      "originalText": "API Key Format: ck_run_<token> or ck_ci_*\nStored: SHA-256(key) in apikey table\nHeader: Authorization: ApiKey ck_run_*",
      "fontSize": 12,
