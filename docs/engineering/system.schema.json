{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eden.gophersys.dev/schemas/engineering-system/v1",
  "title": "Eden engineering system",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "homes", "harnesses", "processes"],
  "properties": {
    "schemaVersion": { "const": "eden.engineering/v1" },
    "name": { "const": "eden" },
    "homes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "architecture", "engineering", "agentExecution"],
      "properties": {
        "product": { "type": "string" },
        "architecture": { "type": "string" },
        "engineering": { "type": "string" },
        "agentExecution": { "type": "string" }
      }
    },
    "harnesses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entrypoint"],
        "properties": {
          "id": { "enum": ["claude", "codex"] },
          "entrypoint": { "type": "string" }
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "status"],
        "properties": {
          "id": { "enum": ["feature", "ci", "parallel", "review", "release"] },
          "path": { "type": "string" },
          "status": { "enum": ["planned", "active"] }
        }
      }
    }
  }
}
