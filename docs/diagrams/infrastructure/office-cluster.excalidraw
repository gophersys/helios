    {
      "type": "text",
      "id": "rbac_table_txt",
      "x": 70,
      "y": 1095,
      "width": 880,
      "height": 120,
      "text": "Role              ClusterRole                  Staging       Production    Dev           Validation\n\u2500\u2500\u2500\u2500              \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500                  \u2500\u2500\u2500\u2500\u2500\u2500\u2500       \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500    \u2500\u2500\u2500           \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nADMIN             concord-super-admin          Full          Full          Full          Full\nMAINTAINER        concord-namespace-admin      Full          Read-only     Full          Full\nDEVELOPER         concord-namespace-admin      Full          Read-only     Full          Read-only\nOPERATOR          concord-namespace-readonly   Read-only     None          None          None",
