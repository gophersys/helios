{
  "name": "devcontainer",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "root": ".",
  "sourceRoot": ".",
  "projectType": "application",
  "tags": ["scope:shared", "type:container-images"],
  "targets": {
    "list": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh list",
        "cwd": "."
      },
      "cache": false
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "."
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/ctl.sh",
        "{projectRoot}/project.json",
        "{projectRoot}/images/*/ctl.sh",
        "{projectRoot}/images/*/Dockerfile",
        "{projectRoot}/images/*/project.json"
      ]
    },
    "propagate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh propagate",
        "cwd": "."
      },
      "cache": false
    },
    "release": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh release",
        "cwd": "."
      },
      "cache": false
    }
  }
}
