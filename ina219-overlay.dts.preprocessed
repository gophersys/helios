# 20 "meta-corekinect/recipes-kernel/linux/device-tree-overlays/ina219-overlay.dts"
# 1 "/workspaces/concord-os-yocto/linux-toradex/include/dt-bindings/gpio/gpio.h" 1
# 21 "meta-corekinect/recipes-kernel/linux/device-tree-overlays/ina219-overlay.dts" 2
