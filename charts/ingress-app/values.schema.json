{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ingress-app values",
  "description": "Public-facing stateless-app. Ingress block is mandatory (enabled must be true) + ingress.host required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "image", "env", "resources", "ingress"],
  "properties": {
    "app":                 { "type": "object", "required": ["name"], "additionalProperties": false,
                              "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }, "partOf": { "type": "string" } } },
    "image":               { "type": "object", "required": ["repository", "tag"], "additionalProperties": false,
                              "properties": { "repository": { "type": "string" }, "tag": { "type": "string" }, "pullPolicy": { "type": "string" }, "pullSecrets": { "type": "array" } } },
    "tenant":              { "type": "string" },
    "env":                 { "type": "string", "enum": ["prod", "staging", "dev", "lab"] },
    "nodeRole":            { "type": "string", "enum": ["apps", "data", "devops", "build", "batch"] },
    "dataClassification":  { "type": "string", "enum": ["public", "internal", "confidential", "pii"] },
    "replicas":            { "type": "integer", "minimum": 1, "maximum": 100, "default": 2 },

    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } } },
        "limits":   { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } } }
      }
    },

    "securityContext": { "type": "object", "additionalProperties": true },
    "tmpfs":           { "type": "array", "items": { "type": "object" } },
    "probes":          { "type": "object", "additionalProperties": true },
    "service":         { "type": "object", "additionalProperties": true },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host"],
      "properties": {
        "enabled":          { "type": "boolean", "const": true, "description": "Must be true — use stateless-app for internal-only apps." },
        "ingressClassName": { "type": "string" },
        "host":             { "type": "string", "minLength": 1,
                              "description": "Fully-qualified hostname. Must resolve to the cluster's public ingress LB or a CNAME to it." },
        "canonicalHost":    { "type": "boolean" },
        "paths":            { "type": "array", "items": { "type": "object" }, "maxItems": 16 },
        "tls": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled":       { "type": "boolean" },
            "clusterIssuer": { "type": "string", "enum": ["letsencrypt-prod", "letsencrypt-staging", "internal-ca"] },
            "secretSuffix":  { "type": "string" }
          }
        },
        "redirectToHttps": { "type": "boolean" },
        "headers": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "stsSeconds":              { "type": "integer", "minimum": 0 },
            "stsIncludeSubdomains":    { "type": "boolean" },
            "stsPreload":              { "type": "boolean" },
            "contentTypeNosniff":      { "type": "boolean" },
            "browserXssFilter":        { "type": "boolean" },
            "frameDeny":               { "type": "boolean" },
            "referrerPolicy":          { "type": "string" },
            "permissionsPolicy":       { "type": "string" },
            "customResponseHeaders":   { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "rateLimit": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "average": { "type": "integer", "minimum": 1 },
            "burst":   { "type": "integer", "minimum": 1 },
            "period":  { "type": "string" }
          }
        },
        "sso": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled":        { "type": "boolean" },
            "requiredGroups": { "type": "array", "items": { "type": "string" }, "maxItems": 16 }
          }
        }
      }
    },

    "autoscale":       { "type": "object", "additionalProperties": true },
    "pdb":             { "type": "object", "additionalProperties": true },
    "observability":   { "type": "object", "additionalProperties": true },
    "secrets":         { "type": "array", "items": { "type": "object" }, "maxItems": 32 },
    "networkPolicy":   { "type": "object", "additionalProperties": true },
    "slo":             { "type": "object", "additionalProperties": true },
    "rollout":         { "type": "object", "additionalProperties": true },
    "serviceAccount":  { "type": "object", "additionalProperties": true },
    "rbac":            { "type": "object", "additionalProperties": true },
    "scheduling":      { "type": "object", "additionalProperties": true },
    "env":             { "type": "array" },
    "envFrom":         { "type": "array" },
    "volumes":         { "type": "array" },
    "volumeMounts":    { "type": "array" },
    "initContainers":  { "type": "array" },
    "sidecars":        { "type": "array" }
  }
}
