{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cronjob values",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "env", "app", "image", "schedule", "jobSpec", "resources"],
  "properties": {
    "project":             { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,20}$", "description": "Project this cronjob belongs to. Namespace is <project>-<env>." },
    "app":                 { "type": "object", "required": ["name"], "additionalProperties": false,
                              "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$", "description": "Sub-app within the project." } } },
    "image":               { "type": "object", "required": ["repository", "tag"], "additionalProperties": false,
                              "properties": { "repository": { "type": "string" }, "tag": { "type": "string" }, "pullPolicy": { "type": "string" }, "pullSecrets": { "type": "array" } } },
    "tenant":              { "type": "string" },
    "env":                 { "type": "string", "enum": ["prod", "staging", "dev", "lab"] },
    "nodeRole":            { "type": "string", "enum": ["apps", "data", "devops", "build", "batch"] },
    "dataClassification":  { "type": "string", "enum": ["public", "internal", "confidential", "pii"] },

    "schedule":                   { "type": "string", "minLength": 1, "description": "Cron expression. UTC." },
    "timeZone":                   { "type": "string", "default": "UTC" },
    "concurrencyPolicy":          { "type": "string", "enum": ["Forbid", "Allow", "Replace"], "default": "Forbid" },
    "startingDeadlineSeconds":    { "type": "integer", "minimum": 10 },
    "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0, "maximum": 20 },
    "failedJobsHistoryLimit":     { "type": "integer", "minimum": 0, "maximum": 20 },
    "suspend":                    { "type": "boolean", "default": false },

    "jobSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "args":    { "type": "array", "items": { "type": "string" } }
      }
    },

    "activeDeadlineSeconds":   { "type": "integer", "minimum": 1, "maximum": 86400 },
    "backoffLimit":            { "type": "integer", "minimum": 0, "maximum": 10 },
    "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
    "completions":             { "type": "integer", "minimum": 1 },
    "parallelism":             { "type": "integer", "minimum": 1 },
    "completionMode":          { "type": "string", "enum": ["NonIndexed", "Indexed"] },

    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } } },
        "limits":   { "type": "object", "required": ["cpu", "memory"], "additionalProperties": false, "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } } }
      }
    },

    "securityContext": { "type": "object", "additionalProperties": true },
    "tmpfs":           { "type": "array", "items": { "type": "object" } },
    "observability":   { "type": "object", "additionalProperties": true },
    "secrets":         { "type": "array", "items": { "type": "object" }, "maxItems": 32 },
    "networkPolicy":   { "type": "object", "additionalProperties": true },
    "slo":             { "type": "object", "additionalProperties": true },
    "serviceAccount":  { "type": "object", "additionalProperties": true },
    "rbac":            { "type": "object", "additionalProperties": true },
    "scheduling":      { "type": "object", "additionalProperties": true },
    "env":             { "type": "array" },
    "envFrom":         { "type": "array" },
    "volumes":         { "type": "array" },
    "volumeMounts":    { "type": "array" },
    "initContainers":  { "type": "array" }
  }
}
