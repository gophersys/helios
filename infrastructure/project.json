{
  "name": "infrastructure",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "scope:infrastructure",
    "type:meta"
  ],
  "targets": {
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh status",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/project.json",
        "{projectRoot}/**/*.sh",
        "{projectRoot}/**/*.yml",
        "{projectRoot}/**/*.yaml"
      ]
    },
    "generate-index": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh generate-index",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
