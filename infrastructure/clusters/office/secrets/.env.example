# infrastructure/clusters/office/secrets/.env.example
# Copy to .env and fill in real values. NEVER commit .env to version control.
#
# Usage:
#   npx nx run infrastructure:secrets -c office
#   OR: bash infrastructure/clusters/office/secrets/create-all.sh [--dry-run]
#
# These values create ALL Kubernetes secrets required for Concord app deployment.
# Each variable maps to a specific K8s secret + key.

# ─── Bitbucket SSH Key ───────────────────────────────────────────
# Path to the SSH private key for Bitbucket repo access.
# Used by: build-service (clones repos), git-poller (polls for changes)
# K8s secret: bitbucket-ssh-key / ssh-private-key
BITBUCKET_SSH_KEY_PATH=/root/.ssh/keys/bitbucket

# ─── Build Service + Git Poller ──────────────────────────────────
# API key for build-service and git-poller to authenticate with http-api.
# Must be a valid API key (create via /v2/api-keys or use seed key).
# K8s secret: concord-build-service-secrets / api-key
BUILD_SERVICE_API_KEY=ck_ci_admin_x8K2mP9vL4nQ7wR1tY6uI3oA5sD0fG

# Bitbucket REST API credentials (optional — needed for PR monitoring).
# Used by: git-poller to detect open PRs and new pushes.
# K8s secret: concord-build-service-secrets / bitbucket-email, bitbucket-api-token
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# ─── CoreCloud Validation ────────────────────────────────────────
# API key for CoreCloud validation API (FUOTA, device management).
# Used by: validation-runner jobs
# K8s secret: corecloud-validation / api-key
CORECLOUD_VALIDATION_API_KEY=

# ─── MCUboot Encryption Keys ────────────────────────────────────
# Paths to MCUboot encryption keys for firmware signing (FUOTA).
# Used by: validation-runner, build-service
# K8s secret: theta-mcuboot-keys / encryption_key.pem, comms_encryption_key.pem
MCUBOOT_APP_KEY_PATH=
MCUBOOT_COMMS_KEY_PATH=

# ─── CI MinIO Upload (devops namespace only) ─────────────────────
# Credentials for CI CronJobs to upload test results to cluster MinIO.
# Must match the MinIO root credentials used by the Helm deployment.
# K8s secret: ci-minio-upload / MINIO_ACCESS_KEY, MINIO_SECRET_KEY
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
