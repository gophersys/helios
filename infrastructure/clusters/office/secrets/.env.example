# infrastructure/clusters/office/secrets/.env.example
#
# Secrets are split into TWO files:
#
#   shared.env      — Same across all environments (SSH keys, API tokens, CoreOps)
#   {namespace}.env  — Per-environment (staging.env, production.env)
#
# Setup:
#   1. Create shared.env with the shared values from this file
#   2. Create staging.env with the per-environment values from this file
#   3. Create production.env with different per-environment values
#
# Usage:
#   nx run platform:sync-secrets -c staging
#   nx run platform:sync-secrets -c production
#   bash infrastructure/clusters/office/secrets/create-all.sh [namespace] [--dry-run]
#
# NEVER commit shared.env, staging.env, or production.env to version control.

# ═══════════════════════════════════════════════════════════════
# shared.env — Secrets common across staging + production
# ═══════════════════════════════════════════════════════════════

# ── Bitbucket SSH Key ────────────────────────────────────────
# Path to the SSH private key for Bitbucket repo access.
# Used by: build-service, git-poller, http-api
# K8s secret: bitbucket-ssh-key / ssh-private-key
BITBUCKET_SSH_KEY_PATH=/root/.ssh/keys/bitbucket

# ── Build Service + Git Poller ───────────────────────────────
# API key for build-service and git-poller to authenticate with http-api.
# K8s secret: concord-build-service-secrets / api-key, bitbucket-email, bitbucket-api-token
BUILD_SERVICE_API_KEY=ck_ci_admin_x8K2mP9vL4nQ7wR1tY6uI3oA5sD0fG
BITBUCKET_EMAIL=mateo@corekinect.com
BITBUCKET_API_TOKEN=

# ── CoreOps — Device Personalization ─────────────────────────
# Service account credentials for CoreOps API.
# Used by: http-api (device provisioning), manufacturing runners, validation runners
# K8s secret: concord-secrets / COREOPS_API_KEY, COREOPS_AUTH_USER, COREOPS_AUTH_PASS
COREOPS_API_KEY=
COREOPS_AUTH_USER=
COREOPS_AUTH_PASS=

# ── CoreCloud Validation (optional) ─────────────────────────
# K8s secret: corecloud-validation / api-key
CORECLOUD_VALIDATION_API_KEY=

# ── MCUboot Encryption Keys (optional) ──────────────────────
# Paths to MCUboot encryption keys for firmware signing (FUOTA).
# K8s secret: theta-mcuboot-keys / encryption_key.pem, comms_encryption_key.pem
MCUBOOT_APP_KEY_PATH=
MCUBOOT_COMMS_KEY_PATH=

# ── PyPI htpasswd (optional) ────────────────────────────────
# Content of the htpasswd file for PyPI package upload auth.
# Generate: htpasswd -nb <user> <password>
# K8s secret: concord-pypi-htpasswd / .htpasswd
PYPI_HTPASSWD=

# ── CI MinIO (devops namespace only) ────────────────────────
# Credentials for CI CronJobs to upload test results.
# K8s secret: ci-minio-upload / MINIO_ACCESS_KEY, MINIO_SECRET_KEY
CI_MINIO_USER=
CI_MINIO_PASSWORD=

# ── Claude Code OAuth (devops namespace only) ───────────────
# Path to Claude Code OAuth credentials file.
# K8s secret: claude-code-oauth / credentials.json
CLAUDE_CREDENTIALS_PATH=~/.claude/.credentials.json


# ═══════════════════════════════════════════════════════════════
# {namespace}.env — Per-environment secrets
# ═══════════════════════════════════════════════════════════════
# Create staging.env and production.env with the values below.
# These MUST be different between staging and production.

# ── Infrastructure ───────────────────────────────────────────
# K8s secret: concord-infra-credentials
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Application ──────────────────────────────────────────────
# K8s secret: concord-secrets
DATABASE_URL=postgresql://concord:<POSTGRES_PASSWORD>@concord-postgres:5432/concord
DIRECT_DATABASE_URL=postgresql://concord:<POSTGRES_PASSWORD>@concord-postgres:5432/concord
STORAGE_ACCESS_KEY=
STORAGE_SECRET_ACCESS_KEY=
JWT_SECRET_KEY=
AUTH_SERVER_API_KEY=
DELETE_ALL_KEY=
BITBUCKET_WEBHOOK_SECRET=
