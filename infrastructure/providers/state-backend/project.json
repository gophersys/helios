{
  "name": "providers-state-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:infrastructure", "type:provider", "layer:providers", "provider:state-backend"],
  "targets": {
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh status",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "info": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh info",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/ctl.sh",
        "{projectRoot}/backend.hcl",
        "{projectRoot}/README.md"
      ]
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh fmt",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh bootstrap",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh destroy",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
