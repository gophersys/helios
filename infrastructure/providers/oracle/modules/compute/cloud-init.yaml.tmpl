#cloud-config
# Rendered by providers/oracle/modules/compute/main.tf. Seeds hostname,
# authorized_keys, and optionally kicks off a Tailscale join on first
# boot. Safe to re-render — OCI only applies user_data on first boot.

hostname: ${hostname}

%{ if ssh_public_key != "" ~}
ssh_authorized_keys:
  - ${ssh_public_key}
%{ endif ~}

%{ if tailnet_auth_key != "" ~}
runcmd:
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key=${tailnet_auth_key} --hostname=${hostname} --ssh
%{ endif ~}
