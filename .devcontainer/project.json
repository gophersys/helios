{
  "name": "devcontainer",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "check": {
      "command": "./ctl.sh check",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "configure": {
      "command": "./ctl.sh configure",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "status": {
      "command": "./ctl.sh status",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./ctl.sh test",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
