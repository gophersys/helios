{
  "name": "devcontainer",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "check": {
      "dependsOn": ["test"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ctl.sh test",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
