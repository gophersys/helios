{
    "name": "devcontainer",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": ".devcontainer",
    "projectType": "application",
    "targets": {
        "create-platform-builder": {
            "executor": "nx:run-commands",
            "options": {
                "command": "mkdir -p ~/.docker/buildx && cp .devcontainer/assets/buildkitd.toml ~/.docker/buildx/ && (docker buildx ls | grep concord-builder || docker buildx create --name concord-builder --use --driver docker-container --config .devcontainer/assets/buildkitd.toml --driver-opt network=host) && docker buildx inspect --bootstrap"
            }
        },
        "build-all": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "devcontainer-base:build"
            ],
            "options": {
                "commands": [
                    "nx run devcontainer-mtib:build",
                    "nx run devcontainer-ncs:build",
                    "nx run devcontainer-ui:build"
                ]
            }
        },
        "push-all": {
            "executor": "nx:run-commands",
            "dependsOn": [
                "devcontainer-base:push"
            ],
            "options": {
                "commands": [
                    "nx run devcontainer-mtib:push",
                    "nx run devcontainer-ncs:push",
                    "nx run devcontainer-ui:push"
                ]
            }
        }
    }
}