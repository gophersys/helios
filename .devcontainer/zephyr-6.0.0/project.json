{
    "name": "devcontainer-zephyr-6.0.0",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": ".devcontainer/zephyr-6.0.0",
    "projectType": "application",
    "targets": {
        "build": {
            "command": "nx run devcontainer-zephyr-6.0.0:containerize"
        },
        "push": {
            "command": "docker push containers.ad.corekinect.com/concord-zephyr-6.0.0:latest"
        },
        "containerize": {
            "executor": "@nx-tools/nx-container:build",
            "cwd": "{projectRoot}",
            "options": {
                "context": "{projectRoot}",
                "file": ".devcontainer/zephyr-6.0.0/Dockerfile",
                "platforms": [],
                "load": true,
                "push": false,
                "tags": [
                    "containers.ad.corekinect.com/concord-zephyr-6.0.0:latest"
                ]
            }
        }
    }
}