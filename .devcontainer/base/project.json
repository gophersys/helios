{
  "name": "devcontainer-base",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".devcontainer/base",
  "projectType": "application",
  "tags": ["type:devcontainer"],
  "targets": {
    "build": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "context": ".devcontainer/base",
        "file": ".devcontainer/base/Dockerfile",
        "platforms": [],
        "load": true,
        "push": false,
        "tags": ["containers.ad.corekinect.com/concord-devcontainer-base:latest"]
      }
    },
    "push": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "context": ".devcontainer/base",
        "file": ".devcontainer/base/Dockerfile",
        "platforms": ["linux/amd64", "linux/arm64"],
        "load": false,
        "push": true,
        "tags": ["containers.ad.corekinect.com/concord-devcontainer-base:latest"],
        "cache-from": ["type=registry,ref=containers.ad.corekinect.com/concord-devcontainer-base:cache"],
        "cache-to": ["type=registry,ref=containers.ad.corekinect.com/concord-devcontainer-base:cache,mode=max"]
      }
    }
  }
}
