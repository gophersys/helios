{
    "name": "devcontainer-base",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": ".devcontainer/base",
    "projectType": "application",
    "targets": {
        "build": {
            "command": "nx run devcontainer-base:containerize"
        },
        "push": {
            "command": "docker push containers.ad.corekinect.com/concord-base:latest && docker push kubecop.ad.corekinect.com:5000/concord-base:latest"
        },
        "containerize": {
            "executor": "@nx-tools/nx-container:build",
            "cwd": "{projectRoot}",
            "options": {
                "context": "{projectRoot}",
                "file": ".devcontainer/base/Dockerfile",
                "platforms": [
                    "linux/arm64"
                ],
                "load": true,
                "push": false,
                "tags": [
                    "containers.ad.corekinect.com/concord-base:latest",
                    "kubecop.ad.corekinect.com:5000/concord-base:latest"
                ]
            }
        }
    }
}