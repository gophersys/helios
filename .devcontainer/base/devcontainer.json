{
  "name": "Base Dev Environment",
  "image": "containers.ad.corekinect.com/concord-base:latest",
  "postCreateCommand": "npm install && npm fund && npm audit fix && NX_NO_CLOUD=true",
  "runArgs": [
    "--privileged",
    "--network=host"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/dev,target=/dev,type=bind",
    "source=${localEnv:HOME}/.ssh-devcontainer,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.oh-my-zsh/custom/themes,target=/root/.oh-my-zsh/custom/themes,type=bind,readonly",
    "source=${localEnv:HOME}/.zshrc,target=/root/.zshrc,type=bind,readonly"
  ],
  // Vs Code Customizations
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/usr/bin/zsh",
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          },
          "editor.rulers": [
            119
          ],
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.args": [
          "--line-length",
          "119"
        ],
        "isort.args": [
          "--profile",
          "black"
        ]
      },
      "extensions": [
        "mutantdino.resourcemonitor",
        "ms-python.isort",
        "ms-python.black-formatter",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "zxh404.vscode-proto3",
        "nrwl.angular-console",
        "hediet.vscode-drawio",
        "IronGeek.vscode-env",
        "golang.go"
      ]
    }
  }
}