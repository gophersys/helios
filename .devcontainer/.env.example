# ── infrastructure devcontainer environment ───────────────────────────────────
#
# PREFERRED: Use Bitwarden CLI (no plaintext secrets on disk)
#   1. bw unlock              # on your host machine
#   2. export BW_SESSION="..."  # paste the session key
#   3. .devcontainer/ctl.sh create
#   Secrets are pulled from Bitwarden item "env:infrastructure" at container start.
#
# LEGACY FALLBACK: Copy this file to .env and fill in values
#   cp .devcontainer/.env.example .devcontainer/.env
#   .env is gitignored — never commit it.
#
# CI: Secrets are injected as environment variables by the CI system.
#     No .env or Bitwarden needed.

# GitHub personal access token
# Scopes needed: repo, packages:write (for ghcr.io push), read:org
GITHUB_TOKEN=

# ── OCI (Oracle Cloud Infrastructure) ─────────────────────────────────────
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_B64=
OCI_REGION=us-phoenix-1
OCI_COMPARTMENT_OCID=

# ── SSH (Infrastructure access) ──────────────────────────────────────────
SSH_PRIVATE_KEY_B64=

# ── Cloudflare ─────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Tailscale ──────────────────────────────────────────────────────────────
TAILSCALE_AUTH_KEY=

# ── git-crypt ──────────────────────────────────────────────────────────────
GIT_CRYPT_KEY_B64=
