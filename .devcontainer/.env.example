# ── infrastructure devcontainer environment ───────────────────────────────────
#
# Copy this file to .devcontainer/.env and fill in your values.
# .env is gitignored — it never leaves your machine.
#
#   cp .devcontainer/.env.example .devcontainer/.env
#
# The ctl.sh script reads this file before creating or starting the container.

# GitHub personal access token
# Scopes needed: repo, packages:write (for ghcr.io push), read:org
GITHUB_TOKEN=

# Allow Claude Code to run as root inside the container.
# Must be set to 1 — Claude refuses to run as root without this.
IS_SANDBOX=1

# ── OCI (Oracle Cloud Infrastructure) ─────────────────────────────────────
# Required for Terraform and OCI CLI inside the container.
# Get OCID values from OCI Console → Identity → Users → API Keys.
#
# Key setup:
#   base64 -w 0 ~/.oci/oci_api_key.pem   # copy output into OCI_PRIVATE_KEY_B64
#
# ctl.sh post-create auto-writes ~/.oci/config from these vars.
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_B64=
OCI_REGION=us-phoenix-1
OCI_COMPARTMENT_OCID=

# ── SSH (Infrastructure access) ──────────────────────────────────────────
# SSH private key for accessing OCI compute instances.
# Base64-encode the private key:
#   base64 -w 0 ~/.ssh/infra-bastion   # copy output into SSH_PRIVATE_KEY_B64
#
# ctl.sh post-create decodes it to ~/.ssh/infra-bastion and derives the
# public key automatically.
SSH_PRIVATE_KEY_B64=

# ── Cloudflare ─────────────────────────────────────────────────────────────
# Required for DNS records. Create an API token with Zone:DNS:Edit permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CODECTL_ZONE_ID=
CLOUDFLARE_MATEOSEGURA_ZONE_ID=

# ── Tailscale ──────────────────────────────────────────────────────────────
# Required for inter-node mesh VPN.
# Generate a reusable, ephemeral auth key at https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=
