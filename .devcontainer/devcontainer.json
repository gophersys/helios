{
  "name": "Concord Dev",
  // Build from a Dockerfile for now
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      // None for now
    }
  },
  // Pass all USB devices
  "runArgs": [
    "--device=/dev/bus/usb",
    "--device=/dev/ttyACM0", // Sigma
    // "--device=/dev/ttyACM1", // Fixture
    // "--device=/dev/ttyACM2", // Runner
    "--network=host"
  ],
  // Vs Code Customizations
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "settings": {
        "C_Cpp.clang_format_fallbackStyle": "Google",
        "C_Cpp.clang_format_style": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0, KeepEmptyLinesAtTheStartOfBlocks: true, AllowShortIfStatementsOnASingleLine: false }",

        "terminal.integrated.shell.linux": "/usr/bin/zsh",
        // Disable RTOS window
        "mcu-debug.rtos-views.showRTOS": false
      },
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "ms-azuretools.vscode-docker",
        "nrwl.angular-console",
        "golang.go",
        "ms-vscode.cpptools-extension-pack",
        "mcu-debug.debug-tracker-vscode",
        "marus25.cortex-debug",
        "mcu-debug.peripheral-viewer",
        "ms-vscode.vscode-serial-monitor",
        "plorefice.devicetree",
        "cschlosser.doxdocgen",
        "hediet.vscode-drawio"
      ]
    }
  }
}