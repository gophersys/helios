{
    "name": "Yocto Build Environment",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "runArgs": [
        "--rm",
        "--env-file",
        ".devcontainer/.env"
    ],
    "remoteUser": "usersetup",
    "remoteEnv": {
        "WORKDIR": "${containerWorkspaceFolder}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "yocto-project.yocto-bitbake"
            ]
        }
    },
    "postStartCommand": "chmod +x .devcontainer/start.sh && .devcontainer/start.sh"
}