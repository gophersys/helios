{
  "name": "infrastructure",
  "image": "ghcr.io/mateosegura/dev-env:latest",
  "postCreateCommand": "chmod +x .devcontainer/ctl.sh && .devcontainer/ctl.sh post-create && npm install",
  "postStartCommand": "chmod +x .devcontainer/ctl.sh && .devcontainer/ctl.sh post-start",
  "containerEnv": {
    "KUBECONFIG": "/workspaces/infrastructure/cloud/oracle/kubeconfig",
    "IS_SANDBOX": "1",
    "BW_SERVER": "https://secrets.mateosegura.com"
  },
  "remoteEnv": {
    "BW_SESSION": "${localEnv:BW_SESSION}"
  },
  "runArgs": [
    "--init"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/Bitwarden CLI,target=/root/.config/Bitwarden CLI,type=bind,consistency=cached",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true
      },
      "extensions": [
        "hashicorp.terraform",
        "redhat.ansible",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "timonwong.shellcheck",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ]
    }
  }
}
