#!/usr/bin/env bash
#
# _ctl/tests/stubs/entrypoint/runuser — the stub `runuser` the entrypoint test
# puts first on PATH.
#
# `runuser` is util-linux and exists on no mac, so a host run of the entrypoint
# would die on "command not found" at the exact line the test is about. It is
# also the line that MUST NOT be reached at a non-zero euid: the real binary
# refuses there, naming the caller, and that refusal is the failure the euid
# test in the entrypoint exists to prevent.
#
# So this stub does 2 things and nothing else: it RECORDS that it was called,
# with its whole argv, and it EXECS the command after `--`. Recording is what
# lets a case assert which arm ran; exec is what lets the case then read the
# status and the output of the command the entrypoint chose to run.
#
#   STUB_ENTRYPOINT_LOG   the file every stub of this group appends its argv to
#
# It parses only the 2 shapes the entrypoint writes — `runuser -u <user> --
# <cmd>...` and the same with `--preserve-environment` — and exits 64 on
# anything else. A stub that shrugged at an unmodelled argv would hand a
# cheerful 0 back to a caller it did not understand.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_ENTRYPOINT_LOG:-}" ]]; then
  ( IFS=' '; printf 'runuser %s\n' "$*" ) >> "${STUB_ENTRYPOINT_LOG}"
fi

user=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    -u)
      user="${2:-}"
      shift 2
      ;;
    --preserve-environment)
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      printf 'stub runuser: unhandled argument: %s\n' "$1" >&2
      exit 64
      ;;
  esac
done

if [[ -z "$user" ]]; then
  printf 'stub runuser: no -u <user> in the argv\n' >&2
  exit 64
fi

if [[ "$#" -eq 0 ]]; then
  printf 'stub runuser: nothing to run after --\n' >&2
  exit 64
fi

# The real runuser sets HOME, USER and LOGNAME for the target user and keeps
# PATH — measured on ubuntu:24.04 and recorded in the entrypoint's own comment.
# The exported names are what a case can read out of the command it exec'd.
export HOME="/home/${user}"
export USER="$user"
export LOGNAME="$user"

exec "$@"
