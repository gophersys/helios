#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/kicad-cli — the stub ECAD driver for the
# content-hardware group.
#
# The group runs `kicad-cli version`, which is a SUBCOMMAND and not a flag: kicad
# ships a GUI package and the headless driver is the thing the hardware image
# exists to provide, so the case that drives it has to call it the way the guest
# does.
#
#   STUB_FAIL_KICAD_CLI   exit 1 instead of answering   (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${STUB_FAIL_KICAD_CLI:-}" == "1" ]]; then
  printf 'stub kicad-cli: this run was told to fail (STUB_FAIL_KICAD_CLI)\n' >&2
  exit 1
fi

case "${1:-}" in
  version)
    printf '10.0.5\n'
    exit 0
    ;;
  *)
    printf 'stub kicad-cli: unhandled subcommand: %s\n' "${1:-}" >&2
    exit 64
    ;;
esac
