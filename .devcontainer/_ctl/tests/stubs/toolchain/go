#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/go — the stub `go` the functional-group tests put
# first on PATH.
#
# It compiles nothing. `go build -o <path>` writes an EXECUTABLE file at that
# path, because the debugger group refuses to run without one and a stub that
# skipped the write would make that group unreachable — a group that never runs
# is a check that cannot fail.
#
#   STUB_FAIL_GO   exit 1 instead of answering   (unset)
#
# An unhandled subcommand exits 64 and says so, the shape stubs/docker uses: a
# group that starts calling `go` in a way this stub does not model must stop
# loudly instead of collecting a cheerful 0 from a stub that understood nothing.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${STUB_FAIL_GO:-}" == "1" ]]; then
  printf 'stub go: this build was told to fail (STUB_FAIL_GO)\n' >&2
  exit 1
fi

case "${1:-}" in
  build)
    output=""
    previous=""
    for argument in "$@"; do
      if [[ "$previous" == "-o" ]]; then
        output="$argument"
        break
      fi
      previous="$argument"
    done
    if [[ -z "$output" ]]; then
      printf 'stub go: build with no -o <path>\n' >&2
      exit 64
    fi
    printf '#!/usr/bin/env bash\nprintf "smoke fixture\\n"\n' > "$output"
    chmod +x "$output"
    exit 0
    ;;
  vet)
    exit 0
    ;;
  version)
    printf 'go version go1.26.5 linux/amd64\n'
    exit 0
    ;;
  *)
    printf 'stub go: unhandled subcommand: %s\n' "${1:-}" >&2
    exit 64
    ;;
esac
