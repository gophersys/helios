#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/sudo — the stub privilege escalator for the
# content-ui group.
#
# It exists to model ONE property of the real sudo, which is the whole property
# the ui image's toolchain-exposure layer answers: **sudo REPLACES $PATH with
# sudoers' secure_path**. A root shell therefore does not see what the `dev`
# profile put on PATH, and node/npm/uv resolve for one user and not the other
# unless something puts them somewhere secure_path already names —
# /usr/local/bin, which is what ui/Dockerfile symlinks into.
#
#   STUB_SUDO_SECURE_PATH   the PATH the command runs with, as secure_path
#                           (default: /usr/bin:/bin — the exposure DROPPED)
#
# The default is the broken world on purpose. A stub whose default was the
# healthy one would make the case that drives the breakage the one that has to
# remember a knob, and a forgotten knob there reads as a passing image.
#
# It is a stub and NOT the host's sudo, which the case must never reach: the real
# /usr/bin/sudo asks this laptop for a password, exits 1 on a non-tty, and would
# make the check green for a reason no case here chose. It wins over /usr/bin
# because the stub toolchain is first on the guest's PATH.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "$#" -eq 0 ]]; then
  printf 'stub sudo: no command to run\n' >&2
  exit 64
fi

exec env PATH="${STUB_SUDO_SECURE_PATH:-/usr/bin:/bin}" "$@"
