# Fixture world for _ctl/tests/resolve-upstream.test.sh — the value home of a
# miniature repository whose governed file is WRONG.
#
# It is a world of its own and not a row added to fixtures/upstreams/resolver/,
# because the defect it carries makes every aggregate run over it fail. The
# resolver cases that assert a clean --dry-run and a clean --apply must keep a
# world in which every row resolves.
#
# 1 pin, 1 digest row, and 2 case arms that both claim it — see
# mobile/Dockerfile beside this file.

STUBONEROW_VERSION=1.2.2                                               # the stub upstream publishes 1.2.3
STUBONEROW_SHA256_NOARCH=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd  # computed-at-pin: 2026-08-01
