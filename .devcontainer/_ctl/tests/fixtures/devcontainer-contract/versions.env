# The pin home of the staged repository root that
# _ctl/tests/devcontainer-contract.test.sh builds.
#
# `validate` reads 2 rows of it before it judges anything, and refuses to lint at
# all when either is absent: SHELLCHECK_VERSION and HADOLINT_VERSION. Each value
# is the version the matching stub under _ctl/tests/stubs/validate/ reports about
# itself — which is what makes the shellcheck gate take its matching branch and
# hadolint_resolve choose its `host` route, and what keeps the staged run on this
# machine whatever the host's own linters are.
#
# NEITHER is the repository's pin, and neither may be edited to follow one. A
# bump of the real SHELLCHECK_VERSION or HADOLINT_VERSION changes what CI judges
# with; these rows are a handshake between the files of this test and reach no
# image.
SHELLCHECK_VERSION=0.9.0
HADOLINT_VERSION=2.15.1

# Read only on the fallback route of manifest_yq — yq 4.x on PATH answers first.
# It is here because a fixture root that could not name its parser would fail
# for a reason that says nothing about the devcontainer contract.
YQ_VERSION=4.53.3
