# Counter-stimulus fixture for _ctl/tests/download-coverage.test.sh, the SECOND
# home of the dual-home rule.
#
# Nothing sources this file. It stands in for versions.env against
# home-good.Dockerfile: ~17 tools of the real tree carry their version in both
# homes, so the same tool at the same version must carry the same digest in
# both. One home moved and the other not is the drift that a single wrong
# digest in a single image is made of.

# AGREES. Same version, same digest. The detector must be quiet about it.
PAIRTOOL_VERSION=9.9.9
PAIRTOOL_SHA256_AMD64=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc   # computed-at-pin: 2026-08-17

# DISAGREES ON PURPOSE. The same version as home-good.Dockerfile declares, and
# a different digest. One of the 2 images then verifies bytes the other rejects.
GOODTOOL_VERSION=1.2.3
GOODTOOL_SHA256_AMD64=9999999999999999999999999999999999999999999999999999999999999999   # computed-at-pin: 2026-08-17
