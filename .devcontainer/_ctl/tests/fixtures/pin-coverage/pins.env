# _ctl/tests/fixtures/pin-coverage/pins.env — a versions.env-shaped pin file.
#
# The counter-stimulus of version-coverage.test.sh. It is small on purpose: the
# test mutates a COPY of this file to make each defect, so 5 rows show every
# shape the real file holds.
#
#   2 rows a smoke test asserts   (a tool runs, and it reports a version)
#   1 row  no image installs      (a ready pin, an extension point)
#   1 row  that is a digest       (a version-shaped name it is not)
#   1 row  that is a package name (apt names the package, not the version)
#
# A comment row and a blank row are here too. The reader must skip both.

# -------- tools an image asserts --------
GH_VERSION=2.90.0                                                      # latest LTS as of 2026-04-19
HNSLINT_VERSION=0.1.0                                                  # latest as of 2026-08-11

# -------- ready, and consumed by no image --------
TERRAFORM_VERSION=1.14.8                                               # latest LTS as of 2026-04-19

# -------- pins that are not versions --------
DOCKER_COMPOSE_SHA256_AMD64=a0298760c9772d2c06888fc8703a487c94c3c3b0134adeef830742a2fc7647b4
PYTHON_PACKAGE=python3.12                                              # an apt package name
