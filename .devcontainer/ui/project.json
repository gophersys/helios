{
    "name": "devcontainer-ui",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": ".devcontainer/ui",
    "projectType": "application",
    "targets": {
        "build": {
            "command": "nx run devcontainer-ui:containerize"
        },
        "push": {
            "command": "nx run devcontainer-ui:containerize-push"
        },
        "containerize": {
            "executor": "@nx-tools/nx-container:build",
            "cwd": "{projectRoot}",
            "options": {
                "context": "{projectRoot}",
                "file": ".devcontainer/ui/Dockerfile",
                "platforms": [
                    "linux/amd64"
                ],
                "load": true,
                "push": false,
                "tags": [
                    "containers.ad.corekinect.com/concord-devcontainer-ui:latest"
                ]
            }
        },
        "containerize-push": {
            "executor": "@nx-tools/nx-container:build",
            "cwd": "{projectRoot}",
            "options": {
                "context": "{projectRoot}",
                "file": ".devcontainer/ui/Dockerfile",
                "platforms": [
                    "linux/amd64"
                ],
                "load": false,
                "push": true,
                "tags": [
                    "containers.ad.corekinect.com/concord-devcontainer-ui:latest"
                ]
            }
        }
    }
}