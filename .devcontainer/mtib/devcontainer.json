{
  "name": "MTIB Dev Environment",
  "image": "kubecop.ad.corekinect.com:5000/concord-mtib:dev",
  "postCreateCommand": "npm install && npm fund && npm audit fix && NX_NO_CLOUD=true",
  "postStartCommand": "chmod +x .devcontainer/start.sh && ./.devcontainer/start.sh",
  "runArgs": [
    "--privileged",
    "--network=host",
    "--group-add=dialout"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/dev,target=/dev,type=bind"
  ],
  // Vs Code Customizations
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/usr/bin/zsh",
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          },
          "editor.rulers": [
            119
          ],
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.args": [
          "--line-length",
          "119"
        ],
        "isort.args": [
          "--profile",
          "black"
        ]
      },
      "extensions": [
        "ms-python.isort",
        "ms-python.black-formatter",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "zxh404.vscode-proto3",
        "IronGeek.vscode-env",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}