{
  "name": "MTIB Dev Environment",
  "image": "containers.ad.corekinect.com/concord-devcontainer-mtib:latest",
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.ssh-devcontainer ${localEnv:HOME}/.claude",
  "postCreateCommand": "chmod +x .devcontainer/ctl.sh && ./.devcontainer/ctl.sh create",
  "postStartCommand": "chmod +x .devcontainer/ctl.sh && ./.devcontainer/ctl.sh start",
  "runArgs": [
    "--privileged",
    "--net=host",
    "--add-host=host.docker.internal:host-gateway",
    "--env-file=.env"
  ],
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/dev,target=/dev,type=bind",
    "source=/sys,target=/sys,type=bind",
    "source=/mnt,target=/mnt,type=bind",
    "source=${localEnv:HOME}/.ssh-devcontainer,target=/root/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/usr/bin/zsh",
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          },
          "editor.rulers": [119],
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.formatOnSave": true
        },
        "black-formatter.args": ["--line-length", "119"],
        "isort.args": ["--profile", "black"]
      },
      "extensions": [
        "ms-python.isort",
        "ms-python.black-formatter",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "zxh404.vscode-proto3",
        "IronGeek.vscode-env"
      ]
    }
  }
}
