# West workspace — everything under ws/ is fetched; the manifest lives
# in manifest/ (a sibling, so zephyr is never nested inside the manifest
# repo dir — that nesting made Zephyr's module scan recurse).
.west/
ws/

# Go build output
tools/sfd/sfd

# macOS Finder droppings — catalogScan flags any stray in catalog/, and a
# .DS_Store must not be able to turn the gate red
.DS_Store
