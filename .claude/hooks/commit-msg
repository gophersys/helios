#!/usr/bin/env bash
# commit-msg hook — enforce that code changes ship with matching
# .claude/knowledge/ updates. Bypass with [no-arch-change] in the message.
#
# Installed by: .claude/hooks/install.sh (sets core.hooksPath=.claude/hooks).
# Map source:   .claude/hooks/knowledge-map.txt
#
# Algorithm:
#   1. Read commit message from $1; if it contains [no-arch-change], pass.
#   2. List staged files (`git diff --cached --name-only`).
#   3. For each staged file, find the longest-prefix match in the map.
#      That match's "knowledge target" is required in the staged set.
#   4. For each required target, verify it is staged (exact file or any
#      file under a directory target). Missing targets → reject.
#
# Assumes: no whitespace in repo paths or knowledge targets.

set -e

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Bypass marker — for typos, formatting, version bumps, lockfile syncs.
# Matches anywhere in the message (subject or body).
if grep -qE '\[no-arch-change\]' "$msg_file"; then
    exit 0
fi

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

map_file=".claude/hooks/knowledge-map.txt"
if [ ! -f "$map_file" ]; then
    {
        echo ""
        echo "[knowledge-freshness] FATAL: .claude/hooks/knowledge-map.txt is missing."
        echo ""
        echo "The freshness gate is installed (core.hooksPath=.claude/hooks) but the"
        echo "map it depends on has been deleted. Either restore the map or run"
        echo "  git config --unset core.hooksPath"
        echo "to disable the gate entirely."
        echo ""
    } >&2
    exit 1
fi

# Load map rows into parallel arrays.
declare -a PREFIXES KNOWLEDGE
while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    stripped="${line#"${line%%[![:space:]]*}"}"
    [ -z "$stripped" ] && continue
    p=$(echo "$stripped" | awk '{print $1}')
    k=$(echo "$stripped" | awk '{print $2}')
    [ -z "$p" ] || [ -z "$k" ] && continue
    PREFIXES+=("$p")
    KNOWLEDGE+=("$k")
done < "$map_file"

# For each staged file, find the longest matching code prefix and
# record both the knowledge target it requires AND the staged file
# that triggered the requirement (for a helpful error message).
declare -A REQUIRED          # knowledge target → 1
declare -A TRIGGER_FOR       # knowledge target → list of triggering paths (newline-separated)
while IFS= read -r f; do
    [ -z "$f" ] && continue
    best_len=-1
    best_k=""
    for i in "${!PREFIXES[@]}"; do
        p="${PREFIXES[$i]}"
        if [[ "$f" == "$p"* ]]; then
            if [ "${#p}" -gt "$best_len" ]; then
                best_len="${#p}"
                best_k="${KNOWLEDGE[$i]}"
            fi
        fi
    done
    if [ -n "$best_k" ]; then
        REQUIRED["$best_k"]=1
        if [ -z "${TRIGGER_FOR[$best_k]:-}" ]; then
            TRIGGER_FOR["$best_k"]="$f"
        else
            TRIGGER_FOR["$best_k"]="${TRIGGER_FOR[$best_k]}"$'\n'"$f"
        fi
    fi
done <<< "$staged"

# Verify each required knowledge target is in the staged set.
# Use literal-string match (grep -F) to avoid regex injection from the target path.
violations=()
for k in "${!REQUIRED[@]}"; do
    if [[ "$k" == */ ]]; then
        # Directory target — any staged file with this exact prefix satisfies.
        # We do a literal prefix check via cut + compare to avoid regex.
        found=0
        while IFS= read -r f; do
            case "$f" in
                "$k"*) found=1; break ;;
            esac
        done <<< "$staged"
        [ "$found" -eq 0 ] && violations+=("$k")
    else
        # Exact file target.
        if ! echo "$staged" | grep -qFx "$k"; then
            violations+=("$k")
        fi
    fi
done

if [ "${#violations[@]}" -gt 0 ]; then
    {
        echo ""
        echo "[knowledge-freshness] commit refused"
        echo ""
        echo "You changed code in tracked paths without updating the matching"
        echo ".claude/knowledge/ files in the same commit:"
        echo ""
        for v in "${violations[@]}"; do
            echo "  needs update: $v"
            triggers="${TRIGGER_FOR[$v]:-}"
            if [ -n "$triggers" ]; then
                while IFS= read -r t; do
                    echo "    triggered by: $t"
                done <<< "$triggers"
            fi
            echo ""
        done
        echo "Either:"
        echo "  • update the knowledge file(s) above, re-stage, and re-commit, or"
        echo "  • add [no-arch-change] to your commit message if the change is"
        echo "    purely cosmetic (typo, formatting, version bump, lockfile sync)."
        echo ""
        echo "Map: .claude/hooks/knowledge-map.txt"
        echo "Policy: .claude/rules/update-knowledge-on-change.md"
        echo ""
    } >&2
    exit 1
fi

exit 0
