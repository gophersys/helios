{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(bash scripts/check_pilot_pins.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(kubectl --context homelab get:*)",
      "Bash(kubectl --context homelab describe:*)",
      "Bash(kubectl --context homelab logs:*)"
    ],
    "deny": [
      "Read(./.devcontainer/.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  }
}
