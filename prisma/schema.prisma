generator python {
    provider             = "prisma-client-py"
    output               = "../libs/python/corekinect/database"
    interface            = "sync"
    previewFeatures      = ["fullTextSearch", "multiSchema"]
    recursive_type_depth = 5
    binaryTargets        = ["debian-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
    schemas   = ["app"]
}

// -------------------------------------------------
//                                          Firmware
// -------------------------------------------------
model AppId {
    appId     Int      @id // The numeric application ID (100, 101, 102, etc.) - used as primary key
    name      String // Application name (Comms, Sigma5 V2, etc.)
    chipset   String // Chipset (Sigma5 Cx, Alpha Ax, etc.)
    target    String // Target microcontroller (nRF9160, nRF52840, etc.)
    notes     String? // Optional notes field
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    mtibMappings MtibAppIdMapping[]

    @@map("app_ids")
    @@schema("app")
}

// -------------------------------------------------
//                                              MTIB
// -------------------------------------------------

enum MtibType {
    VALIDATION
    MANUFACTURING

    @@schema("app")
}

enum MtibFeature {
    JOULESCOPE
    MOTION

    @@schema("app")
}

model Mtib {
    id        String        @id // The hostname of the MTIB (verdin-imx8mm-150006879) - used as primary key
    name      String // The display name of the MTIB
    type      MtibType // The type of MTIB (validation, manufacturing)
    features  MtibFeature[] // The features supported by the MTIB (Joulescope, Motion, etc.)
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    // Relations
    appIdMappings MtibAppIdMapping[]

    @@map("mtib")
    @@schema("app")
}

model MtibAppIdMapping {
    id        String   @id @default(cuid())
    mtibId    String // Reference to the MTIB
    jlink     Int // JLINK number (0, 1, etc.)
    appId     Int // Reference to the AppId
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    mtib Mtib  @relation(fields: [mtibId], references: [id], onDelete: Cascade)
    app  AppId @relation(fields: [appId], references: [appId], onDelete: Cascade)

    @@unique([mtibId, jlink]) // Each MTIB can only have one mapping per JLINK
    @@map("mtib_app_id_mappings")
    @@schema("app")
}
