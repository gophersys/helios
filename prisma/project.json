{
    "name": "database",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "prisma",
    "projectType": "application",
    "targets": {
        "setup": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "nx run database:generate-client"
                    },
                    {
                        "command": "nx run database:push"
                    },
                    // {
                    //     "command": "nx run database:seed"
                    // }
                ],
                "cwd": "{workspaceRoot}",
                "parallel": false
            }
        },
        "generate-client": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "yarn prisma generate"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        },
        "push": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "yarn prisma db push --skip-generate"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        },
        "seed": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "docker",
            "options": {
                "cwd": "{projectRoot}/seed",
                "parallel": false,
                "commands": [
                    {
                        "command": "/bin/zsh -c 'echo \"Seeding database...\"'"
                    }
                ]
            }
        }
    },
    "tags": []
}