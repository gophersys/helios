{
    "name": "database",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "prisma",
    "projectType": "application",
    "targets": {
        "generate-client": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "yarn prisma generate"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        },
        "push": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "yarn prisma db push --skip-generate"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        },
        "setup": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "nx run database:generate-client"
                    },
                    {
                        "command": "nx run database:push"
                    }
                ],
                "cwd": "{workspaceRoot}",
                "parallel": false
            }
        },
        "reset": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "yarn prisma db push --force-reset"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        },
        "seed": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "python3 seed.py"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        },
        "studio": {
            "executor": "nx:run-commands",
            "options": {
                "commands": [
                    {
                        "command": "yarn prisma studio"
                    }
                ],
                "cwd": "{projectRoot}",
                "parallel": false
            }
        }
    },
    "tags": []
}
