# =============================================================================
# Concord Dev Stack — External Inputs
# =============================================================================
# Variables that must be set externally for `nx start platform` to work.
# Docker Compose interpolates these into docker-compose.yaml via ${VAR:-default}.
#
# Most service config (DB creds, storage creds, ports, service URLs) is
# hardcoded with dev-friendly defaults directly in docker-compose.yaml and
# does NOT belong here. This file is for secrets and per-developer overrides.
#
# Copy to .env:  cp deploy/development/.env.example deploy/development/.env
#
# Services configured from this file:
#   http-api, git-poller, build-service
# =============================================================================

# ── Concord API Key ──────────────────────────────────────────────────────────
# Used by git-poller and build-service to authenticate with http-api.
# Not needed for dev (AUTH_ENABLED=false), but required in staging/production.
CONCORD_API_KEY=

# ── Bitbucket SSH (base64-encoded private key) ───────────────────────────────
# Used by http-api, git-poller, build-service to clone firmware repos.
# Generate: cat ~/.ssh/keys/bitbucket | base64 -w0
BITBUCKET_SSH_KEY=

# ── Bitbucket API (PR polling, repo operations) ──────────────────────────────
# Used by http-api and git-poller for Bitbucket REST API calls.
BITBUCKET_API_TOKEN=
BITBUCKET_EMAIL=you@corekinect.com

# ── Firmware Signing Keys (base64-encoded PEM) ───────────────────────────────
# Used by build-service to sign firmware artifacts.
# Leave empty to use bench keys seeded from prisma/seed.py.
BENCH_SIGNING_KEY=
ENGINEERING_SIGNING_KEY=
PRODUCTION_SIGNING_KEY=
