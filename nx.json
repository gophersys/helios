{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "parallel": 10,
  "cacheDirectory": ".nx/cache",
  "defaultBase": "main",
  "tui": {
    "enabled": false,
    "autoExit": true
  },
  "targetDefaults": {
    "check": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    }
  },
  "analytics": false
}
