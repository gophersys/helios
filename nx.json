{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "terraform": [
      "{projectRoot}/terraform/**/*",
      "{projectRoot}/ansible/**/*",
      "{projectRoot}/scripts/**/*"
    ],
    "kubernetes": [
      "kubernetes/**/*"
    ]
  },
  "targetDefaults": {
    "plan": {
      "cache": false
    },
    "apply": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    }
  }
}
