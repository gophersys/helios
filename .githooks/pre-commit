#!/usr/bin/env bash
#
# .githooks/pre-commit — Eden client-side gate (ADR-0018 Layer 1, "the teeth").
#
# Runs on the STAGED change only, fast and fail-clear:
#   1. gofumpt -l            on the staged *.go files            (formatting, zero tolerance)
#   2. golangci-lint (fast)  per staged file's owning Go module  (interfacebloat/ireturn/
#                                                                 forbidigo/errcheck/...)
#   3. hnslint               on any touched libs/go/<lib>         (structural HNS-1 naming)
#
# Any violation blocks the commit. Bypass (discouraged) with `git commit --no-verify`;
# CI re-runs the identical gate so a bypass only defers the failure (10 §8).
#
set -Eeuo pipefail
IFS=$'\n\t'

# shellcheck source-path=SCRIPTDIR
# shellcheck disable=SC1091
source "$(git rev-parse --show-toplevel)/.githooks/lib/common.sh"

hook_read_lines STAGED_GO < <(hook_staged_go_files)

if [[ ${#STAGED_GO[@]} -eq 0 ]]; then
  exit 0   # no Go in this commit — nothing for this gate to do
fi

hook_info "pre-commit: ${#STAGED_GO[@]} staged Go file(s)"
FAILED=0

# --- 1. gofumpt formatting -----------------------------------------------------------
# Resolve to absolute paths so gofumpt reports stable locations.
ABS_GO=()
for f in "${STAGED_GO[@]}"; do ABS_GO+=("$REPO_ROOT/$f"); done
hook_gofumpt_check "${ABS_GO[@]}" || FAILED=1

# --- 2. golangci-lint per touched module ---------------------------------------------
hook_read_lines MODULES < <(printf '%s\n' "${STAGED_GO[@]}" | hook_unique_modules)
if [[ ${#MODULES[@]} -eq 0 ]]; then
  hook_warn "staged Go files belong to no Go module (no go.mod found) — skipping golangci-lint"
else
  for md in "${MODULES[@]}"; do
    hook_info "golangci-lint (fast) → ${md#"$REPO_ROOT"/}"
    if ! hook_golangci_module "$md"; then
      hook_fail "golangci-lint reported issues in ${md#"$REPO_ROOT"/}"
      FAILED=1
    fi
  done
fi

# --- 3. hnslint on touched libs/go/<lib> ---------------------------------------------
hook_read_lines LIBS < <(printf '%s\n' "${STAGED_GO[@]}" | hook_touched_libs_go)
if [[ ${#LIBS[@]} -gt 0 ]]; then
  for lib in "${LIBS[@]}"; do
    hook_info "hnslint → $lib"
    if ! hook_hnslint_lib "$lib"; then
      FAILED=1
    fi
  done
fi

if [[ $FAILED -ne 0 ]]; then
  hook_fail "commit blocked — fix the violations above, then re-stage and commit."
  hook_dim  "(emergency bypass: git commit --no-verify — but CI runs the same gate)"
  exit 1
fi

hook_ok "pre-commit gate passed"
exit 0
