/*
 * tracker virtual-board contract — Route 2 on esp32c6_devkitc.
 * Every node below cites a catalog record (all D2 @ zephyr 413b789d):
 *   modem   -> catalog/components/quectel,bg95.yaml   (cellular + GNSS module)
 *   imu     -> catalog/components/bosch,bmi270.yaml   (wake-on-motion)
 *   charger -> catalog/components/ti,bq25180.yaml     (USB-C 1-cell Li-ion)
 * Pin choices are provisional (P5 owns final pin/RF placement).
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-gpio-sigmap.h>

&pinctrl {
	uart1_modem: uart1_modem {
		group1 {
			pinmux = <UART1_TX_GPIO4>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO5>;
			bias-pull-up;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_modem>;
	pinctrl-names = "default";

	modem: modem {
		compatible = "quectel,bg95";
		mdm-power-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
	};
};

&i2c0 {
	status = "okay";

	imu: bmi270@68 {
		compatible = "bosch,bmi270";
		reg = <0x68>;
	};

	charger: bq25180@6a {
		compatible = "ti,bq25180";
		reg = <0x6a>;
		constant-charge-current-max-microamp = <500000>;
	};
};
