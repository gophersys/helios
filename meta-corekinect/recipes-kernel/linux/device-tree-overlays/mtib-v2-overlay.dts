/dts-v1/;
/plugin/;

/*
 * MTIB V2 - CoreKinect Embedded Test Bench
 *
 * Additional I2C devices on i2c4 (Verdin I2C_1) not covered by
 * the existing ina219-overlay.dts.
 *
 * Full MTIB V2 Rev 1.2 I2C device map:
 *
 *   0x19 - LIS2DE12   (ina219-overlay.dts)
 *   0x2F - MCP4017    (userspace I2C - no DTS node needed)
 *   0x38 - TCA9534A   (this overlay, REV 1.2 only)
 *   0x40 - INA219     (ina219-overlay.dts)
 *   0x41 - INA219     (ina219-overlay.dts)
 *   0x48 - ADS1115    (ina219-overlay.dts)
 *   0x49 - ADS1115    (ina219-overlay.dts)
 *   0x50 - AT24C02C   (this overlay, REV 1.2 only)
 *   0x76 - BMP390L    (userspace I2C - no DTS node needed)
 *   0x77 - BME280     (this overlay)
 */

/ {
	compatible = "toradex,verdin-imx8mm";
};

&i2c4 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	/* BME280 - pressure / humidity / temperature */
	bme280: pressure@77 {
		compatible = "bosch,bme280";
		reg = <0x77>;
		status = "okay";
	};

	/* TCA9534A 8-bit GPIO expander (REV 1.2 only)
	 * P0 = JLINK_MUL (J-Link mux select)
	 * P1 = EEPROM WP
	 * P2 = VMM_EN (motor power enable)
	 * P3-P7 = reserved
	 *
	 * On REV 1.1 this device is absent; the probe will
	 * fail gracefully and the node is ignored.
	 */
	tca9534a: gpio@38 {
		compatible = "nxp,pca9534";
		reg = <0x38>;
		gpio-controller;
		#gpio-cells = <2>;
		status = "okay";
	};

	/* AT24C02C 2Kbit EEPROM - board ID (REV 1.2 only)
	 *
	 * NOTE: 0x50 is also used by the Mallow display-adapter
	 * EEPROM. On MTIB builds the display adapter is not
	 * populated, so the address is available for the
	 * on-board EEPROM.
	 */
	eeprom: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <8>;
		status = "okay";
	};
};
