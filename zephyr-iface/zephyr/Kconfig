config CK_IFACE_LIB_UART
    bool "Enable UART support for interface library"
    select SERIAL
    select SERIAL_SUPPORT_ASYNC
    select UART_ASYNC_API
    # select NOCACHE_MEMORY
    select RING_BUFFER
    select POLL

config CK_IFACE_LIB_UART_NOCACHE_MEMORY
    bool "Suggest No-Cache Memory for CK_IFACE_LIB_UART"
    depends on ARCH_HAS_NOCACHE_MEMORY_SUPPORT
    help
      Selecting this option suggests that NOCACHE_MEMORY should be
      enabled if your architecture supports non-cacheable memory regions.
      This is useful for DMA operations or other scenarios where cache
      effects should be avoided. Please ensure to manually select
      NOCACHE_MEMORY in your configuration if required by your application.

config CK_IFACE_LIB_SOCKETS
    bool "Enable Sockets support for interface library"
    select NETWORKING
    select NET_IPV4
    select NET_TCP
    select NET_SOCKETS
    select NET_CONTEXT_SNDTIMEO
    select NET_CONTEXT_RCVTIMEO
    # NET_SOCKETS_POSIX_NAMES was removed in Zephyr 4.0 (bare BSD names now come
    # from the POSIX layer / zsock_ wrappers). The old `select CONFIG_NOCACHE_MEMORY`
    # referenced an undefined symbol (CONFIG_ prefix is illegal inside Kconfig);
    # the STM32 ethernet driver manages its own DMA memory attributes.

# Set to level DBG to see useful output regarding UART sockets, such as state
# register/unregister events, etc
config CK_IFACE_LIB_STACK_DEBUG_LEVEL
    int "Log level for UART transport stack"
    default 3

# Set to level DBG to see useful output regarding the raw data being received
# on the UART device
config CK_IFACE_LIB_ASSEMBLER_DEBUG_LEVEL
    int "Log level for UART packet assembler"
    default 3

# How many UART devices we expect in the stack
config CK_IFACE_NUM_UART_SOCKETS
    int "Number of UART sockets being used"
    default 1

config CK_IFACE_UART_STACK_HEAP_SIZE
    int "Heap size for packets heap"
    default 2128

config CK_IFACE_NUM_PACKET_BUFFERS
    int "Number of recv buffer pointers available to the packet assembler"
    default 5

config CK_IFACE_RECV_RING_BUFER_SIZE
    int "Packet assembler ring buffer size"
    default 2072

config CK_IFACE_RECV_CB_BUFFER_SIZE
    int "Buffer used by uart async API to hold newly received data on a bus"
    default 32

config CK_IFACE_SEND_BUFFER_COUNT
    int "Packet assembler ring buffer size"
    default 1

config CK_IFACE_PROTOCOL_MAX_PAYLOAD_SIZE
    int "Maximum usable payload for a single UART packet"
    default 1068

# 
config CK_IFACE_UART_STACK_THREAD_PRIORITY
    int "Thread priority for the UART transport stack"
    default 100

config CK_IFACE_UART_STACK_THREAD_STACK_SIZE
    int "Thread memory stack size for the UART transport stack"
    default 1024

# WiFi connectivity backend for the Zephyr connection manager. Implements
# CONNECTIVITY_WIFI_MGMT so conn_mgr (not the app) owns WiFi: associate from NVS
# credentials + disable power-save. Keeps the application transport-agnostic.
config CK_IFACE_WIFI_CONNECTIVITY
    bool "Provide the conn_mgr WiFi connectivity backend"
    depends on NET_CONNECTION_MANAGER_CONNECTIVITY_WIFI_MGMT && WIFI_CREDENTIALS
    default y if NET_CONNECTION_MANAGER_CONNECTIVITY_WIFI_MGMT && WIFI_CREDENTIALS

config CK_IFACE_WIFI_CONNECTIVITY_LOG_LEVEL
    int "Log level for the WiFi connectivity backend"
    default 3

config CK_IFACE_WIFI_MAX_BINDINGS
    int "Maximum conn_mgr WiFi bindings (per-binding contexts to allocate)"
    default 1
    help
      One connectivity context is allocated per conn_mgr binding from a static
      pool of this size. Each WiFi station iface that binds CONNECTIVITY_WIFI_MGMT
      claims one slot, with its own work items and its own net_mgmt callback
      nodes (a shared node registered twice would form an slist cycle and hang
      the net_mgmt event thread). The usual single-STA case needs 1; raise it
      only for boards that bind more than one WiFi station iface.

config CK_IFACE_WIFI_CONNECT_TIMEOUT_SEC
    int "Seconds a connect attempt (association + DHCP) may take before retry"
    default 25

config CK_IFACE_WIFI_WQ_STACK_SIZE
    int "Stack for the dedicated WiFi workqueue (net_mgmt blocks on ESP32)"
    default 3072

config CK_IFACE_WIFI_WQ_PRIORITY
    int "Priority for the dedicated WiFi workqueue"
    default 8

# ---------------------------------------------------------------------------
# Networking memory <-> throughput profile.
#
# Bundles the net-stack tuning that trades RAM for throughput (per Espressif's
# "max WiFi throughput in Zephyr" guidance + measured A/B on ESP32). Optional:
# with no profile selected the stack keeps its Zephyr defaults, so this never
# changes an existing build silently. A board just adds e.g.
# CONFIG_CK_IFACE_NET_THROUGHPUT=y to opt in.
# ---------------------------------------------------------------------------
choice CK_IFACE_NET_PROFILE
    prompt "Networking memory/throughput profile"
    optional
    depends on CK_IFACE_LIB_SOCKETS

config CK_IFACE_NET_THROUGHPUT
    bool "Throughput (more RAM; ~4 Mbps WiFi TCP ceiling on ESP32)"

config CK_IFACE_NET_BALANCED
    bool "Balanced"

config CK_IFACE_NET_FOOTPRINT
    bool "Footprint (least RAM, functional)"

endchoice

# TCP receive window is the single biggest throughput lever (default is tiny ->
# no in-flight pipelining). Espressif's guidance suggests 50000, but the window
# MUST NOT exceed what the RX buffer pool can actually hold or the stack drops
# in-flight segments under load and throughput collapses. The THROUGHPUT RX pool
# is NET_BUF_RX_COUNT(24) * NET_BUF_DATA_SIZE(1500) = 36 KB, so cap the advertised
# window at 32000 (under the pool, with headroom for headers/reassembly). This is
# the RAM-safe choice: covering a full 50 KB window instead would need
# NET_BUF_RX_COUNT ~34, ~15 KB more RAM the ESP32 can't spare.
configdefault NET_TCP_MAX_RECV_WINDOW_SIZE
    default 32000 if CK_IFACE_NET_THROUGHPUT
    default 16384 if CK_IFACE_NET_BALANCED

configdefault NET_TCP_MAX_SEND_WINDOW_SIZE
    default 50000 if CK_IFACE_NET_THROUGHPUT
    default 16384 if CK_IFACE_NET_BALANCED

# Full-MTU net buffers: at the 128 B default a 1500 B packet shreds across ~12
# buffers. One buffer per packet removes that fragmentation tax.
configdefault NET_BUF_DATA_SIZE
    default 1500 if CK_IFACE_NET_THROUGHPUT
    default 512 if CK_IFACE_NET_BALANCED
    default 256 if CK_IFACE_NET_FOOTPRINT

configdefault NET_PKT_RX_COUNT
    default 16 if CK_IFACE_NET_THROUGHPUT
    default 12 if CK_IFACE_NET_BALANCED

configdefault NET_PKT_TX_COUNT
    default 16 if CK_IFACE_NET_THROUGHPUT
    default 12 if CK_IFACE_NET_BALANCED

configdefault NET_BUF_RX_COUNT
    default 24 if CK_IFACE_NET_THROUGHPUT
    default 16 if CK_IFACE_NET_BALANCED

configdefault NET_BUF_TX_COUNT
    default 24 if CK_IFACE_NET_THROUGHPUT
    default 16 if CK_IFACE_NET_BALANCED

# ESP32-only knobs (ignored on other boards): run WiFi from IRAM, not flash.
configdefault ESP32_WIFI_IRAM_OPT
    default y if CK_IFACE_NET_THROUGHPUT

configdefault ESP32_WIFI_RX_IRAM_OPT
    default y if CK_IFACE_NET_THROUGHPUT
