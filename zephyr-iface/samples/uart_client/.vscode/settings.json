{
    // Hush CMake
    "cmake.configureOnOpen": false,
    // IntelliSense
    "C_Cpp.default.compilerPath": "/usr/home/zephyr-sdk-0.16.1/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    // File Associations
    "files.associations": {
        "*.overlay": "dts",
        "dma.h": "c",
        "uart.h": "c"
    },
    // Editor actions
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "editor.formatOnSave": true,
    // Update and auto-format on save
    "mcu-debug.rtos-views.showRTOS": false
}