config CK_CIPHER_LIB
    bool "Cipher Protocol Library"
    # The transport comes from the iface library (the old CK_TAL_LIB is gone —
    # TAL was renamed/absorbed into iface). The application picks the flavor.
    depends on CK_IFACE_LIB_SOCKETS || CK_IFACE_LIB_UART

# Log Levels
# LOG_LEVEL_NONE 0U
# LOG_LEVEL_ERR  1U
# LOG_LEVEL_WRN  2U
# LOG_LEVEL_INF  3U
# LOG_LEVEL_DBG  4U

config CK_CIPHER_REGISTRY_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_ROUTER_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_SD_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_EVENT_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_RPC_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_STREAM_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_DAEMON_LOG_LEVEL
    int "Log level for registry"
    default 2

config CK_CIPHER_IFACE_LOG_LEVEL    
    int "Log level for registry"
    default 2

# Interfaces
config CK_CIPHER_CLIENT_IFACE_COUNT
    int "Number of client interfaces in host"
    default 1

config CK_CIPHER_SERVER_IFACE_COUNT
    int "Number of server interfaces in host"
    default 1

# Other 
config CK_CIPHER_SERVICE_MAX_NAME_LEN
    int "Maximum length of a cipher service"
    default 32
    
# Thread Info
config CK_CIPHER_IFACE_THREAD_STACK_SIZE
    int "Interface thread stack size"
    default 2048

config CK_CIPHER_MAX_NUM_DEVICES_PER_IFACE
    int "Number of allowed devices on an interface"
    default 3

# Services
config CK_MAX_END_POINTS_PER_SERVICE
    int "List of all end points for a service"
    default 5

config CK_MAX_NUM_SERVICES
    int "The maximum number of services a host knows of"
    default 10

# RPC
config CK_MAX_NUM_CONCURRENT_RPCS
    int "Max Number of RPC entries in daemon"
    default 3