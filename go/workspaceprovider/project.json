{
  "name": "workspaceprovider",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:libs", "type:go"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh build", "cwd": "{projectRoot}" },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh test", "cwd": "{projectRoot}" },
      "cache": false
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh integration", "cwd": "{projectRoot}" },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh lint", "cwd": "{projectRoot}" },
      "cache": false
    },
    "vet": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh vet", "cwd": "{projectRoot}" },
      "cache": false
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh fmt", "cwd": "{projectRoot}" },
      "cache": false
    },
    "cover": {
      "executor": "nx:run-commands",
      "options": { "command": "bash ./ctl.sh cover", "cwd": "{projectRoot}" },
      "cache": false
    }
  }
}
