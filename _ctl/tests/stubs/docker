#!/usr/bin/env bash
#
# _ctl/tests/stubs/docker — the stub `docker` the hermetic ctl tests put first
# on PATH.
#
# It contacts no daemon, opens no socket and resolves no registry. Every answer
# it gives is chosen by an environment variable, so a test states the world it
# wants in 1 line and reads the guard's reaction.
#
# An unhandled subcommand exits 64 and says so. That matters: if a verb under
# test starts calling docker in a way this stub does not model, the run must
# stop loudly instead of receiving a cheerful exit 0 from a stub that
# understood nothing.
#
#   STUB_DOCKER_LOG             append every argv line to this file
#   STUB_BUILD_STATUS           exit status of `docker build`            (0)
#   STUB_BUILDX_VERSION_STATUS  exit status of `docker buildx version`   (0)
#   STUB_BUILDX_INSPECT_STATUS  exit status of `docker buildx inspect`   (0)
#   STUB_BUILDER_PLATFORMS      the Platforms: line of `buildx inspect`  (linux/amd64)
#   STUB_BUILDX_BUILD_STATUS    exit status of `docker buildx build`     (0)
#   STUB_MANIFEST_STATUS        exit status of the manifest readers      (0)
#   STUB_MANIFEST_ERROR         stderr text when that status is non-zero
#   STUB_MANIFEST_JSON          file whose contents the manifest readers print
#
# The currency path, which asks "what digest does this tag hold NOW":
#
#   STUB_REGISTRY_DIGEST        the digest the stub registry holds for the tag
#   STUB_REGISTRY_REFERENCE     the tag it holds it for      (ubuntu:24.04)
#
# 3 clients can answer that question and the stub models all 3, so a reader is
# judged on the digest it PRINTS and not on the command it picked:
#
#   docker buildx imagetools inspect <ref> --format '{{.Manifest.Digest}}'
#   docker buildx imagetools inspect <ref>          (the Digest: line of the block)
#   docker manifest inspect -v <ref>                (.Descriptor.digest)
#   docker pull <ref> && docker image inspect --format '{{index .RepoDigests 0}}'
#
# Every one of them stays inside STUB_MANIFEST_STATUS, so a registry read that
# FAILS is as testable as one that succeeds. A reader that answers a digest on a
# failed read is the defect worth catching: it would report the base OS as
# current on a night when nothing could be read at all.
#
# The smoke path, which drives a container instead of a builder:
#
#   STUB_VERSION_STATUS         exit status of `docker version`          (0)
#   STUB_DAEMON_PLATFORM        what `docker version --format` answers   (linux/amd64)
#   STUB_IMAGE_INSPECT_STATUS   exit status of `docker image inspect`    (0)
#   STUB_IMAGE_PLATFORM         the Os/Architecture of the stored image  (linux/amd64)
#   STUB_IMAGE_SIZE             the UNPACKED size of the stored image,
#                               in bytes — the sum `docker history` reports
#                               and the number the size gate compares
#                                                                        (4000000000)
#   STUB_IMAGE_LAYER_SIZES      the exact lines `docker history` prints, 1 per
#                               layer; the default is the single line
#                               STUB_IMAGE_SIZE
#   STUB_IMAGE_CONTENT_SIZE     what `docker image inspect --format
#                               '{{.Size}}'` answers                     (1647731708)
#   STUB_HISTORY_STATUS         exit status of `docker history`          (0)
#   STUB_PULL_STATUS            exit status of `docker pull`             (0)
#   STUB_RUN_STATUS             exit status of `docker run`              (0)
#   STUB_DOCKER_STDIN           write the stdin of `docker run` to this file
#
# THE 2 SIZES ARE DIFFERENT NUMBERS, AND THAT IS THE POINT (ledger #119).
#
# A real daemon running the CONTAINERD image store — the default of Docker 29,
# which is what the daemon the CI smoke talks to runs — answers
# `docker image inspect --format '{{.Size}}'` with the CONTENT size: the sum of
# the COMPRESSED layer blobs. `docker history --human=false` answers the
# UNPACKED size of each layer. Measured on this mac (docker 29.5.3, containerd
# store) against an image holding 400,000,000 bytes of zeros: inspect said
# 4,483,568 and the history lines summed to 409,493,504.
#
# So the default of STUB_IMAGE_CONTENT_SIZE is 1,647,731,708 — the compressed
# figure cloud's gate really read in run 32151769443 — and it is deliberately
# NOT derived from STUB_IMAGE_SIZE. A gate that goes back to reading the inspect
# template gets a number no budget in images.yaml can fail, and every size case
# of this suite turns red instead of quietly agreeing.
#
# STUB_DOCKER_STDIN is the one that matters for the smoke contract. The host
# driver feeds the guest script to the container on stdin, so the payload is
# invisible in the argv, and a test that read the argv alone would assert
# nothing about what the container was told to check.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_DOCKER_LOG:-}" ]]; then
  # 1 invocation per line. The scripts under test run with IFS=$'\n\t', so "$*"
  # would join the argv with a newline and log 1 word per line.
  ( IFS=' '; printf 'docker %s\n' "$*" >> "$STUB_DOCKER_LOG" )
fi

# stub_format <argv...> — the value of the `--format` argument, empty when the
# argv carries none. The answer of `inspect` depends on the template it is
# given, so the stub has to read the template rather than guess.
function stub_format() {
  local previous=""
  local argument
  for argument in "$@"; do
    if [[ "$previous" == "--format" ]]; then
      printf '%s' "$argument"
      return 0
    fi
    previous="$argument"
  done
  printf ''
}

# stub_has_argument <needle> <argv...> — whether the argv carries this exact
# word. `docker history` prints HUMAN-READABLE sizes unless `--human=false` is
# given, so the stub has to read the flag rather than assume the caller passed
# it: a reader that drops the flag must get "4GB" here, exactly as it would from
# a daemon, and fail on it.
function stub_has_argument() {
  local needle="$1"
  shift
  local argument
  for argument in "$@"; do
    if [[ "$argument" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

# stub_registry_read_failed — the 1 gate every registry reader passes through.
# Called before any of them answers, so no client shape can report a digest on a
# read that did not happen.
function stub_registry_read_failed() {
  local status="${STUB_MANIFEST_STATUS:-0}"
  if [[ "$status" -ne 0 ]]; then
    printf '%s\n' "${STUB_MANIFEST_ERROR:-stub: the manifest read failed}" >&2
    exit "$status"
  fi
}

# `docker buildx imagetools inspect`. --raw hands back the manifest document,
# which is what verify-published reads; a --format naming a digest, or no
# argument at all, is the currency read.
function stub_imagetools_inspect() {
  stub_registry_read_failed
  local template
  template="$(stub_format "$@")"
  case "$template" in
    *Digest*|*digest*)
      if [[ -z "${STUB_REGISTRY_DIGEST:-}" ]]; then
        printf 'stub docker: a digest was asked for and STUB_REGISTRY_DIGEST is not set\n' >&2
        exit 64
      fi
      printf '%s\n' "$STUB_REGISTRY_DIGEST"
      exit 0
      ;;
  esac
  if [[ -n "${STUB_MANIFEST_JSON:-}" ]]; then
    cat "$STUB_MANIFEST_JSON"
    exit 0
  fi
  if [[ -n "${STUB_REGISTRY_DIGEST:-}" ]]; then
    printf 'Name:      docker.io/library/%s\n' "${STUB_REGISTRY_REFERENCE:-ubuntu:24.04}"
    printf 'MediaType: application/vnd.oci.image.index.v1+json\n'
    printf 'Digest:    %s\n' "$STUB_REGISTRY_DIGEST"
    exit 0
  fi
  printf 'stub docker: neither STUB_MANIFEST_JSON nor STUB_REGISTRY_DIGEST is set\n' >&2
  exit 64
}

# `docker manifest inspect`. -v carries the descriptor, so the digest reader
# gets a document jq can walk; without a document to print, the stub says so.
function stub_manifest() {
  stub_registry_read_failed
  if [[ -n "${STUB_MANIFEST_JSON:-}" ]]; then
    cat "$STUB_MANIFEST_JSON"
    exit 0
  fi
  if [[ -n "${STUB_REGISTRY_DIGEST:-}" ]]; then
    printf '{"Descriptor":{"digest":"%s"}}\n' "$STUB_REGISTRY_DIGEST"
    exit 0
  fi
  printf 'stub docker: STUB_MANIFEST_JSON is not set\n' >&2
  exit 64
}

case "${1:-}" in
  build)
    printf 'stub: docker build — no daemon was contacted\n'
    exit "${STUB_BUILD_STATUS:-0}"
    ;;
  buildx)
    case "${2:-}" in
      version)
        printf 'github.com/docker/buildx v0.20.0 stub\n'
        exit "${STUB_BUILDX_VERSION_STATUS:-0}"
        ;;
      inspect)
        if [[ "${STUB_BUILDX_INSPECT_STATUS:-0}" -ne 0 ]]; then
          printf 'ERROR: no builder "stub" found\n' >&2
          exit "${STUB_BUILDX_INSPECT_STATUS}"
        fi
        printf 'Name:          stub\n'
        printf 'Driver:        docker-container\n'
        printf '\n'
        printf 'Nodes:\n'
        printf 'Name:          stub0\n'
        printf 'Endpoint:      unix:///var/run/docker.sock\n'
        printf 'Status:        running\n'
        printf 'Platforms:     %s\n' "${STUB_BUILDER_PLATFORMS:-linux/amd64}"
        exit 0
        ;;
      imagetools)
        if [[ "${3:-}" == "inspect" ]]; then
          stub_imagetools_inspect "$@"
        fi
        printf 'stub docker: unhandled buildx imagetools subcommand: %s\n' "${3:-}" >&2
        exit 64
        ;;
      build)
        printf 'stub: buildx build — no daemon was contacted\n'
        exit "${STUB_BUILDX_BUILD_STATUS:-0}"
        ;;
      *)
        printf 'stub docker: unhandled buildx subcommand: %s\n' "${2:-}" >&2
        exit 64
        ;;
    esac
    ;;
  manifest)
    if [[ "${2:-}" == "inspect" ]]; then
      stub_manifest "$@"
    fi
    printf 'stub docker: unhandled manifest subcommand: %s\n' "${2:-}" >&2
    exit 64
    ;;
  version)
    if [[ "${STUB_VERSION_STATUS:-0}" -ne 0 ]]; then
      printf 'stub: the daemon did not answer\n' >&2
      exit "${STUB_VERSION_STATUS}"
    fi
    printf '%s\n' "${STUB_DAEMON_PLATFORM:-linux/amd64}"
    exit 0
    ;;
  image)
    if [[ "${2:-}" == "inspect" ]]; then
      if [[ "${STUB_IMAGE_INSPECT_STATUS:-0}" -ne 0 ]]; then
        printf 'Error: No such image\n' >&2
        exit "${STUB_IMAGE_INSPECT_STATUS}"
      fi
      STUB_TEMPLATE="$(stub_format "$@")"
      case "$STUB_TEMPLATE" in
        *Size*)         printf '%s\n' "${STUB_IMAGE_CONTENT_SIZE:-1647731708}" ;;
        *Architecture*) printf '%s\n' "${STUB_IMAGE_PLATFORM:-linux/amd64}" ;;
        *RepoDigests*)
          if [[ -z "${STUB_REGISTRY_DIGEST:-}" ]]; then
            printf 'stub docker: a digest was asked for and STUB_REGISTRY_DIGEST is not set\n' >&2
            exit 64
          fi
          printf '%s@%s\n' "${STUB_REGISTRY_REFERENCE:-ubuntu:24.04}" "$STUB_REGISTRY_DIGEST"
          ;;
        *)
          printf 'stub docker: unhandled image inspect format: %s\n' "${STUB_TEMPLATE}" >&2
          exit 64
          ;;
      esac
      exit 0
    fi
    printf 'stub docker: unhandled image subcommand: %s\n' "${2:-}" >&2
    exit 64
    ;;
  history)
    if [[ "${STUB_HISTORY_STATUS:-0}" -ne 0 ]]; then
      printf 'Error response from daemon: No such image: %s\n' "${*: -1}" >&2
      exit "${STUB_HISTORY_STATUS}"
    fi
    if ! stub_has_argument "--human=false" "$@"; then
      # What a daemon answers a caller that did not ask for bytes.
      printf '4GB\n'
      exit 0
    fi
    # `-` and not `:-`: an explicitly EMPTY value is the image whose history
    # reports no layer at all, which is a world a test has to be able to state.
    # A sum over nothing is 0, and 0 is under every budget ever written.
    printf '%s\n' "${STUB_IMAGE_LAYER_SIZES-${STUB_IMAGE_SIZE:-4000000000}}"
    exit 0
    ;;
  pull)
    if [[ "${STUB_PULL_STATUS:-0}" -ne 0 ]]; then
      printf 'stub: the pull failed\n' >&2
      exit "${STUB_PULL_STATUS}"
    fi
    printf 'stub: docker pull — no registry was contacted\n'
    exit 0
    ;;
  run)
    # The payload the host driver sends to the guest. It is kept whole, because
    # a test asserts on the TEXT the container would run.
    if [[ -n "${STUB_DOCKER_STDIN:-}" ]]; then
      cat > "$STUB_DOCKER_STDIN"
    fi
    printf 'stub: docker run — no container was started\n'
    exit "${STUB_RUN_STATUS:-0}"
    ;;
  *)
    printf 'stub docker: unhandled subcommand: %s\n' "${1:-}" >&2
    exit 64
    ;;
esac
