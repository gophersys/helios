#!/usr/bin/env bash
#
# _ctl/tests/stubs/entrypoint/chmod — a TRIPWIRE stub, not a model.
#
# See the ssh-keygen stub beside it for why this group returns 0 and asserts
# through the LOG. The pod preparation in embedded/embedded-entrypoint.sh runs
# `chmod` over the hostkey directory and over the mounted volumes, and every
# one of those paths is outside any temporary tree a host test could own.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_ENTRYPOINT_LOG:-}" ]]; then
  ( IFS=' '; printf 'chmod %s\n' "$*" ) >> "${STUB_ENTRYPOINT_LOG}"
fi
exit 0
