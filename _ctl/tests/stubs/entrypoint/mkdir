#!/usr/bin/env bash
#
# _ctl/tests/stubs/entrypoint/mkdir — a TRIPWIRE stub, not a model.
#
# See the ssh-keygen stub beside it for why this group returns 0 and asserts
# through the LOG. `mkdir -p /etc/ssh/hostkeys` is the FIRST statement of the
# pod preparation in embedded/embedded-entrypoint.sh, so it is the first line
# that a default mode which fell through would write here — and it is a
# directory a root CI runner would really create.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_ENTRYPOINT_LOG:-}" ]]; then
  ( IFS=' '; printf 'mkdir %s\n' "$*" ) >> "${STUB_ENTRYPOINT_LOG}"
fi
exit 0
