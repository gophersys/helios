#!/usr/bin/env bash
#
# _ctl/tests/stubs/entrypoint/id — the stub `id` the entrypoint test puts first
# on PATH.
#
# It models ONE property, and it is the whole property the mode dispatch of
# embedded/embedded-entrypoint.sh turns on: **what `id -u` prints**. The real
# `id` reports the uid of the process running it, so a host test could only ever
# see the uid of the person running the suite — one arm of a 2-arm branch, and
# never the other. That branch decides whether the entrypoint reaches `runuser`,
# and `runuser` at a non-zero euid REFUSES with "may not be used by non-root
# users", which would turn a working `docker run --user dev` into an error.
#
#   STUB_ID_UID   what `id -u` prints   (no default — an unset value is a FAILURE)
#
# There is deliberately NO default. A default would let a case that forgot to
# state its uid run against the other arm and report a pass about a branch it
# never entered, which is the believed-and-empty check this suite refuses.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_ENTRYPOINT_LOG:-}" ]]; then
  ( IFS=' '; printf 'id %s\n' "$*" ) >> "${STUB_ENTRYPOINT_LOG}"
fi

if [[ -z "${STUB_ID_UID:-}" ]]; then
  printf 'stub id: STUB_ID_UID is unset, so this case never chose a euid arm\n' >&2
  exit 64
fi

case "${1:-}" in
  -u)
    printf '%s\n' "${STUB_ID_UID}"
    ;;
  *)
    printf 'stub id: unhandled argv: %s\n' "$*" >&2
    exit 64
    ;;
esac
