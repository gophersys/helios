#!/usr/bin/env bash
#
# _ctl/tests/stubs/entrypoint/ssh-keygen — a TRIPWIRE stub, not a model.
#
# The default mode of embedded/embedded-entrypoint.sh must never reach the pod
# preparation, and generating SSH host keys is the first thing that preparation
# does. This stub exists so that reaching it is RECORDED rather than merely
# failing: it writes its argv to the shared log, creates nothing, and returns 0.
#
# Returning 0 is deliberate. A tripwire that failed would end the entrypoint at
# the first wrong step, and the case would then read a generic non-zero status
# instead of a log line naming the step. The assertion is the LOG, and the log
# has to survive far enough to be read.
#
# It also keeps a wrong branch off the real filesystem. Without it an inverted
# default would run the host's ssh-keygen against /etc/ssh/hostkeys, which needs
# root — and on a root CI runner it would SUCCEED and write keys into the image
# the suite is running in.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_ENTRYPOINT_LOG:-}" ]]; then
  ( IFS=' '; printf 'ssh-keygen %s\n' "$*" ) >> "${STUB_ENTRYPOINT_LOG}"
fi
exit 0
