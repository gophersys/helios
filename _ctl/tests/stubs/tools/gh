#!/usr/bin/env bash
#
# _ctl/tests/stubs/tools/gh — a stub `gh` for the guest comparator tests.
#
# .ci/image-checks.sh runs each tool and compares the version it reports. To
# test that comparator on the HOST, the tools it runs have to be controllable,
# so this stub answers with whatever version the test asks for.
#
#   STUB_TOOL_GH_VERSION   the version this stub reports   (2.90.0)
#
# The 2-line shape is the shape of the real `gh --version`. A comparator that
# reads the whole output instead of the first version token would pass on a
# 1-line answer and fail on the real one, so the stub gives it the real one.
#
set -Eeuo pipefail
IFS=$'\n\t'

printf 'gh version %s (2026-04-19)\n' "${STUB_TOOL_GH_VERSION:-2.90.0}"
printf 'https://github.com/cli/cli/releases/latest\n'
