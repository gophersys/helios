#!/usr/bin/env bash
#
# _ctl/tests/stubs/tools/hnslint — a stub `hnslint` for the guest comparator
# tests.
#
#   STUB_TOOL_HNSLINT_VERSION   the version this stub reports   (0.1.0)
#
# 1 line, and no `v` prefix. The 2 stub tools answer in 2 different shapes on
# purpose: a comparator that reads only 1 shape passes 1 tool and lies about
# every other one.
#
set -Eeuo pipefail
IFS=$'\n\t'

printf 'hnslint %s\n' "${STUB_TOOL_HNSLINT_VERSION:-0.1.0}"
