#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/gofumpt — the stub `gofumpt` for the go-gate group.
#
#   STUB_GOFUMPT_UNFORMATTED   the file list this stub prints   (empty)
#
# There is deliberately NO STUB_FAIL_GOFUMPT, and that is the one exception in
# this directory. checks_go_gate reads the OUTPUT of `gofumpt -l .` and not its
# status, because gofumpt reports by PRINTING the files it would change and
# exiting 0. It reads that output through `unformatted="$(...)"`, so a gofumpt
# that exited non-zero would abort the guest under `set -e` with no message at
# all — a knob whose only effect is an unexplained empty run is a trap. Printing
# a file name is how this step honestly fails.
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ -n "${STUB_GOFUMPT_UNFORMATTED:-}" ]]; then
  printf '%s\n' "$STUB_GOFUMPT_UNFORMATTED"
fi
exit 0
