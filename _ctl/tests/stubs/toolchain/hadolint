#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/hadolint — the stub Dockerfile linter for the
# dockerfile-lint group.
#
#   STUB_FAIL_HADOLINT   exit 1 instead of answering   (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${STUB_FAIL_HADOLINT:-}" == "1" ]]; then
  printf 'stub hadolint: DL0000 this lint was told to fail (STUB_FAIL_HADOLINT)\n' >&2
  exit 1
fi
exit 0
