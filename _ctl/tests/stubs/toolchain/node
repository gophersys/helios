#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/node — the Node runtime cloud installs under the dev profile, stubbed for the content-ui group.
#
# The group runs it TWICE, once as this user and once through sudo, and the only
# thing either run has to answer is "did the name resolve at all". So this stub
# prints a version and exits 0: the asymmetry the case drives comes from the PATH
# sudo hands it, never from this file.
#
#   STUB_FAIL_NODE   exit 1 instead of answering   (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${STUB_FAIL_NODE:-}" == "1" ]]; then
  printf 'stub node: this run was told to fail (STUB_FAIL_NODE)\n' >&2
  exit 1
fi

printf 'v24.11.1\n'
exit 0
