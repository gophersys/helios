#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/buf — the stub proto compiler for the protocols
# group.
#
# `buf build --output <path>` WRITES that path, because grpcurl reads it in the
# very next step and a stub that skipped the write would make that step fail for
# a reason the test never chose.
#
#   STUB_FAIL_BUF   exit 1 instead of writing the descriptor set   (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${STUB_FAIL_BUF:-}" == "1" ]]; then
  printf 'stub buf: this build was told to fail (STUB_FAIL_BUF)\n' >&2
  exit 1
fi

case "${1:-}" in
  build)
    output=""
    previous=""
    for argument in "$@"; do
      if [[ "$previous" == "--output" ]]; then
        output="$argument"
        break
      fi
      previous="$argument"
    done
    if [[ -z "$output" ]]; then
      printf 'stub buf: build with no --output <path>\n' >&2
      exit 64
    fi
    printf 'stub descriptor set\n' > "$output"
    exit 0
    ;;
  --version)
    printf '1.60.0\n'
    exit 0
    ;;
  *)
    printf 'stub buf: unhandled subcommand: %s\n' "${1:-}" >&2
    exit 64
    ;;
esac
