#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/docker — the stub `docker` for the compose group.
#
# It is NOT _ctl/tests/stubs/docker. That one models a daemon, a builder and a
# registry for the host driver; this one models the compose cli-plugin only, and
# it lives in the toolchain directory because the functional groups run with the
# toolchain first on PATH and nothing else.
#
#   STUB_FAIL_DOCKER_COMPOSE   exit 1 instead of printing the model   (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

case "${1:-}" in
  compose)
    if [[ "${STUB_FAIL_DOCKER_COMPOSE:-}" == "1" ]]; then
      printf 'stub docker compose: this config was told to fail (STUB_FAIL_DOCKER_COMPOSE)\n' >&2
      exit 1
    fi
    printf 'name: smoke\nservices:\n  smoke:\n    image: stub\n'
    exit 0
    ;;
  *)
    printf 'stub docker: unhandled subcommand: %s\n' "${1:-}" >&2
    exit 64
    ;;
esac
