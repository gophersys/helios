#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/hnslint — the stub naming gate for the go-gate
# group, and the 1 tool the comparator row of these tests reads.
#
# It answers 2 shapes because the guest calls it 2 ways: `hnslint --version` for
# the PIN_TABLE row that proves the comparator ran, and `hnslint <module>` for
# the go-gate step.
#
#   STUB_TOOL_HNSLINT_VERSION   the version this stub reports   (0.1.0)
#   STUB_FAIL_HNSLINT           exit 1 on the <module> form     (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${1:-}" == "--version" ]]; then
  printf 'hnslint %s\n' "${STUB_TOOL_HNSLINT_VERSION:-0.1.0}"
  exit 0
fi

if [[ "${STUB_FAIL_HNSLINT:-}" == "1" ]]; then
  printf 'stub hnslint: this run was told to fail (STUB_FAIL_HNSLINT)\n' >&2
  exit 1
fi
exit 0
