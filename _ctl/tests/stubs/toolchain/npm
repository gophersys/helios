#!/usr/bin/env bash
#
# _ctl/tests/stubs/toolchain/npm — the package manager that travels with that Node, stubbed for the content-ui group.
#
# The group runs it TWICE, once as this user and once through sudo, and the only
# thing either run has to answer is "did the name resolve at all". So this stub
# prints a version and exits 0: the asymmetry the case drives comes from the PATH
# sudo hands it, never from this file.
#
#   STUB_FAIL_NPM   exit 1 instead of answering   (unset)
#
set -Eeuo pipefail
IFS=$'\n\t'

if [[ "${STUB_FAIL_NPM:-}" == "1" ]]; then
  printf 'stub npm: this run was told to fail (STUB_FAIL_NPM)\n' >&2
  exit 1
fi

printf '11.6.2\n'
exit 0
