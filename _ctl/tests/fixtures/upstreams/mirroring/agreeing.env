# Counter-stimulus fixture for _ctl/tests/pin-mirroring.test.sh — the QUIET
# half of the mirroring rule, in the versions.env shape.
#
# Nothing sources this file. It pairs with agreeing.Dockerfile, which declares
# the same 2 pins at the same 2 values, so every detector of the rule must stay
# silent here. A detector that reports a pair which agrees reports all 38
# dual-home pins of the real tree, which is as useless as one that reports
# nothing.
#
# SOLEHOME_VERSION lives only here. A single-home pin has nothing to disagree
# with, so the rule must pass over it rather than report it as a home that is
# missing a copy.
#
# The digest row is not a pin. Whether 2 homes carry the same DIGEST is
# download-coverage.test.sh's rule, and counting it here would make this file a
# second, weaker copy of that one.

MIRRORTOOL_VERSION=1.4.2                                               # latest LTS as of 2026-08-17
MIRRORTOOL_SHA256_AMD64=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  # computed-at-pin: 2026-08-17

MIRRORPLAIN_VERSION=3.0.0                                              # installed by `go install`, so it carries no digest row
SOLEHOME_VERSION=7.7.7                                                 # declared in this home only
