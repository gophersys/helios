# Counter-stimulus fixture for _ctl/tests/runner-residue-mirroring.test.sh —
# the QUIET half of the mirroring rule, in the versions.env shape.
#
# Nothing sources this file. It pairs with agreeing.Dockerfile, which declares
# the same 2 pins at the same 2 values and the same digest, so every detector of
# the rule must stay silent here. A detector that reports a pair which agrees
# reports every dual-home pin of the real tree, which is as useless as one that
# reports nothing.
#
# SOLEHOME_VERSION lives only here. A single-home pin has nothing to disagree
# with, so the rule must pass over it rather than report it as a home that is
# missing a copy.
#
# The digest row IS read, and it is judged separately from the version. The
# version equality is this file's rule; the digest equality is
# download-coverage.test.sh's for the pins whose versions already agree, and
# that rule SKIPS a pair whose versions differ. The 2 halves of a drifted bump
# are therefore both reported here, and neither reader has a regular expression
# of its own — both call _ctl/lib.sh.

MIRRORTOOL_VERSION=1.4.2                                               # latest LTS as of 2026-08-17
MIRRORTOOL_SHA256_AMD64=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  # computed-at-pin: 2026-08-17

MIRRORPLAIN_VERSION=3.0.0                                              # installed by `go install`, so it carries no digest row
SOLEHOME_VERSION=7.7.7                                                 # declared in this home only
