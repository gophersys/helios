# Counter-stimulus fixture for _ctl/tests/upstream-coverage.test.sh — the
# versions.env-shaped half of a pin home pair that the table covers EXACTLY.
#
# Nothing sources this file and no build reads it. It exists so the readers of
# the coverage rule are watched on a small world before they are believed on
# the real one: the test mutates copies of this pair to prove each detector
# fires, and it reads the pair unmutated to prove each detector stays quiet.
#
# 3 pins live here, and the reader must find exactly those 3:
#
#   COVERTOOL_VERSION   also declared in pins.Dockerfile — a dual-home pin
#   COVERPKG            an apt package name, which is a pin with no semver
#   COVERREF            a *_REF pin
#
# The digest row is NOT a pin. It is the answer to "which bytes", and its own
# rule lives in download-coverage.test.sh. A reader that counted it here would
# report 1 unanswered pin for every verified download in the repository.

COVERTOOL_VERSION=1.0.0                                                # latest LTS as of 2026-08-17
COVERTOOL_SHA256_AMD64=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa  # computed-at-pin: 2026-08-17

COVERPKG=python3.12                                                    # latest LTS as of 2026-08-17
COVERREF=latest                                                        # untagged upstream; track @latest
