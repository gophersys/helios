# Fixture world for _ctl/tests/runner-residue-mirroring.test.sh — the
# versions.env home of a 2-home tree the writer is driven against.
#
# Nothing sources this file. The test copies the tree beside it to a temporary
# directory and runs `bump_pin` on the COPY, so a writer that edits the wrong
# file cannot damage this fixture and the next run starts from the same bytes.
#
# The second home beside it is runner/Dockerfile. It was base/Dockerfile until
# the 2 pin mechanisms collapsed onto versions.env: base declares no value now,
# so it is no longer a home a writer can rewrite.
#
# 3 pins, chosen for what each one proves about the writer:
#
#   WRITERTOOL_VERSION    2 homes AND a digest row — the full bump: version,
#                         digest and the evidence comment that says where the
#                         digest came from
#   WRITERPLAIN_VERSION   2 homes and NO digest row (a `go install` pin, which
#                         about 30 of the real 56 are) — the version alone moves
#   UNTOUCHED_VERSION     2 homes, and this bump is not about it. Every line of
#                         it must read the same afterwards.

WRITERTOOL_VERSION=1.4.2                                               # latest LTS as of 2026-08-17
WRITERTOOL_SHA256_AMD64=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb  # computed-at-pin: 2026-08-17

WRITERPLAIN_VERSION=3.0.0                                              # latest LTS as of 2026-08-17
UNTOUCHED_VERSION=9.9.9                                                # latest LTS as of 2026-08-17
