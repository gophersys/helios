# The pin home of the staged repository root that
# _ctl/tests/dispatcher-mode.test.sh builds.
#
# `validate` reads exactly 1 row of it — HADOLINT_VERSION, through hadolint_pin
# in ctl.sh — and refuses to lint at all when there is none, so the staged root
# cannot go without this file. The value is the version the stub linter under
# _ctl/tests/stubs/validate/ reports about itself, which is what makes
# hadolint_resolve choose its `host` route and keeps the staged run away from a
# docker daemon.
#
# It is NOT the repository's pin, and it must never be edited to follow one. A
# bump of the real HADOLINT_VERSION is a change to what CI lints with; this row
# is a handshake between 2 files of this test and reaches no image.
HADOLINT_VERSION=2.15.1

# Read only on the fallback route of manifest_yq — yq 4.x on PATH answers first.
# It is here because a fixture root that could not name its parser would fail
# for a reason that says nothing about a dispatcher's mode.
YQ_VERSION=4.53.3
