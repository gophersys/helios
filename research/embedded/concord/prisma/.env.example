# =============================================================================
# Prisma CLI — Database URLs
# =============================================================================
# Loaded by libs/python/database/_base_client.py for Prisma Client Python.
# DATABASE_URL     — pooled connection (pgbouncer), used by the app at runtime
# DIRECT_DATABASE_URL — direct connection, used for migrations (prisma migrate)
#
# For local dev, both point to the same port (no pgbouncer in dev compose).
# In staging/production, DATABASE_URL points at pgbouncer.
# =============================================================================

DATABASE_URL=postgresql://concord:concord@localhost:5433/concord
DIRECT_DATABASE_URL=postgresql://concord:concord@localhost:5433/concord
