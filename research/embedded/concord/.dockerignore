# Security: exclude sensitive and unnecessary files from Docker build context
.env
.env.*
**/.env
**/.env.*

# Git metadata
.git
.gitignore
.gitmodules

# Python caches
**/__pycache__
**/*.pyc
**/*.pyo

# Node / Yarn
**/node_modules
.yarn/cache
.yarn/install-state.gz

# IDE / editor
.vscode
.idea
**/*.swp
**/*.swo

# Nx
.nx

# Build artifacts
**/dist
**/.coverage
**/*.egg-info

# DevContainers (not needed in prod images)
.devcontainer

# Documentation internals
docs/_internal
docs/_archive

# Test artifacts
**/.pytest_cache
**/htmlcov
**/playwright-report
**/test-results

# Infrastructure (not needed in app images)
infrastructure

# CI config
.ci

# Claude config
.claude

# Firmware submodules (large, not needed in platform images)
apps/firmware

# Misc
*.zip
*.dump
DESIGN.md
SECURITY.md
