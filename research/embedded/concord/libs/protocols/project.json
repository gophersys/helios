{
  "name": "protocols",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/protocols",
  "projectType": "library",
  "targets": {
    "create": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "chmod +x ./libs/protocols/ctl.sh && ./libs/protocols/ctl.sh generate"
        ],
        "cwd": "{workspaceRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "chmod +x ./libs/protocols/ctl.sh && ./libs/protocols/ctl.sh clean"
        ],
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "chmod +x ./libs/protocols/tests/test_protocols_create.sh && ./libs/protocols/tests/test_protocols_create.sh"
        ],
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
