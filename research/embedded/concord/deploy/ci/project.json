{
  "name": "deploy-ci",
  "projectType": "application",
  "sourceRoot": "deploy/ci",
  "root": "deploy/ci",
  "tags": ["scope:ci"],
  "targets": {
    "start": {
      "command": "bash deploy/ci/ctl.sh start"
    },
    "stop": {
      "command": "bash deploy/ci/ctl.sh stop"
    },
    "update": {
      "command": "bash deploy/ci/ctl.sh update"
    },
    "status": {
      "command": "bash deploy/ci/ctl.sh status"
    },
    "diff": {
      "command": "bash deploy/ci/ctl.sh diff"
    },
    "logs": {
      "command": "bash deploy/ci/ctl.sh logs"
    },
    "trigger-nightly": {
      "command": "kubectl create job -n devops --from=cronjob/concord-ci-nightly ci-manual-nightly-$(date +%s)"
    },
    "trigger-weekly": {
      "command": "kubectl create job -n devops --from=cronjob/concord-ci-weekly ci-manual-weekly-$(date +%s)"
    }
  }
}
