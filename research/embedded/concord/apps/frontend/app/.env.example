# =============================================================================
# Concord Frontend (SvelteKit)
# =============================================================================
# VITE_* is read by vite.config.ts at dev-server / build time.
# PUBLIC_* is inlined into the client bundle via $env/static/public.
# =============================================================================

# Backend proxy target (dev server proxies /v2/* to this URL).
VITE_BACKEND_URL=http://localhost:9001

# App metadata (inlined into bundle at build time).
PUBLIC_APP_VERSION=0.0.1
PUBLIC_APP_ENVIRONMENT=development
