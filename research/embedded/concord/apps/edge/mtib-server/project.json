{
  "name": "mtib-server",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/edge/mtib-server",
  "projectType": "application",
  "tags": [
    "scope:edge",
    "type:app"
  ],
  "implicitDependencies": [
    "protocols"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "nx run mtib-server:containerize -c development"
        },
        "staging": {
          "command": "nx run mtib-server:containerize -c staging"
        },
        "production": {
          "command": "nx run mtib-server:containerize -c production"
        }
      },
      "cache": false
    },
    "containerize": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "dependsOn": [
        "protocols:create"
      ],
      "options": {
        "context": "{workspaceRoot}",
        "cwd": "{workspaceRoot}",
        "file": "apps/edge/mtib-server/deploy/Dockerfile",
        "push": false,
        "builder": "concord-builder",
        "platforms": [
          "linux/arm64"
        ]
      },
      "configurations": {
        "development": {
          "tags": [
            "concord/mtib-server:development"
          ],
          "load": true
        },
        "staging": {
          "tags": [
            "containers.ad.corekinect.com/concord-mtib-server:staging"
          ],
          "push": true
        },
        "production": {
          "tags": [
            "containers.ad.corekinect.com/concord-mtib-server:production"
          ],
          "push": true
        }
      },
      "cache": false
    },
    "push": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping push for development'"
        },
        "staging": {
          "command": "docker push containers.ad.corekinect.com/concord-mtib-server:staging"
        },
        "production": {
          "command": "docker push containers.ad.corekinect.com/concord-mtib-server:production"
        }
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "push"
      ],
      "defaultConfiguration": "development",
      "options": {
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "development": {
          "command": "echo 'Skipping deploy for development'"
        },
        "staging": {
          "command": "./deploy/ctl.sh staging deploy"
        },
        "production": {
          "command": "./deploy/ctl.sh production deploy"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "python3 -m pytest"
      }
    },
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "python3 -m venv .venv"
          },
          {
            "command": "/bin/bash -c 'source .venv/bin/activate && pip install -e .'"
          },
          {
            "command": "cp .env.example .env"
          },
          {
            "command": "cd assets && chmod +x ctl.sh && ./ctl.sh"
          },
          {
            "command": "apt install python3-tk -y"
          },
          {
            "command": "nx run protocols:create"
          }
        ],
        "parallel": false
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "/bin/bash -c 'docker compose -f deploy/docker-compose.yaml up -d'"
          }
        ]
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          {
            "command": "/bin/bash -c 'docker compose -f deploy/docker-compose.yaml down -v --remove-orphans'"
          }
        ]
      }
    }
  }
}
