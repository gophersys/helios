# ICLE Network Control Service
# Ported from Helios runtime netctl module.

config ICLE_NETCTL
    bool "Network Control Service"
    default y
    select NETWORKING
    select NET_MGMT
    select NET_MGMT_EVENT
    select NET_MGMT_EVENT_INFO
    select NET_IPV4
    select NET_SOCKETS
    select NET_UDP
    select NET_TCP
    select DNS_RESOLVER
    imply WIFI if SOC_SERIES_ESP32
    help
      Network interface management (WiFi).
      Automatically enables the Zephyr networking stack, sockets,
      TCP/UDP, DNS, and network management event subsystem.

if ICLE_NETCTL

config ICLE_NETCTL_LOG_LEVEL
    int "netctl log level"
    default 3
    range 0 4
    help
      Set the log level for the netctl module.
      0=OFF 1=ERR 2=WRN 3=INF 4=DBG

config ICLE_NETCTL_THREAD_STACK_SIZE
    int "Thread stack size"
    default 4096
    range 2048 16384
    help
      Stack size in bytes for the netctl worker thread.

config ICLE_NETCTL_THREAD_PRIORITY
    int "Thread priority"
    default 8
    range 0 14
    help
      Zephyr preemptive priority for the netctl thread.

config ICLE_NETCTL_MAX_PROFILES
    int "Max connection profiles"
    default 4

config ICLE_NETCTL_PROFILE_NAME_MAX
    int "Max profile name length"
    default 32

config ICLE_NETCTL_EVENT_QUEUE_SIZE
    int "Event queue size"
    default 16
    help
      Number of events the netctl queue can buffer.

# WiFi
config ICLE_NETCTL_WIFI
    bool "WiFi support"
    default y
    depends on WIFI
    select NET_L2_WIFI_MGMT
    select NET_L2_ETHERNET
    select NET_DHCPV4
    select WIFI_NM

# ESP32 WiFi driver processes events on the system workqueue.
# The default stack (2048) overflows during connect/DHCP.
config SYSTEM_WORKQUEUE_STACK_SIZE
    default 4096 if ICLE_NETCTL_WIFI

config ICLE_NETCTL_WIFI_STA
    bool "WiFi Station mode"
    default y
    depends on ICLE_NETCTL_WIFI

config ICLE_NETCTL_WIFI_SCAN_MAX_RESULTS
    int "Max WiFi scan results"
    default 20
    depends on ICLE_NETCTL_WIFI

config ICLE_NETCTL_WIFI_CONNECT_TIMEOUT_SEC
    int "WiFi connection timeout (seconds)"
    default 30
    depends on ICLE_NETCTL_WIFI
    help
      Time in seconds to wait for WiFi connection + DHCP.

config ICLE_NETCTL_WIFI_CONNECT_RETRIES
    int "WiFi connection retry count"
    default 3
    depends on ICLE_NETCTL_WIFI
    help
      Number of connection attempts before giving up.
      Uses exponential backoff between retries.

config ICLE_NETCTL_WIFI_DISCONNECT_TIMEOUT_SEC
    int "WiFi disconnection timeout (seconds)"
    default 5
    depends on ICLE_NETCTL_WIFI

config ICLE_NETCTL_WIFI_SCAN_TIMEOUT_SEC
    int "WiFi scan timeout (seconds)"
    default 10
    depends on ICLE_NETCTL_WIFI

config ICLE_NETCTL_WIFI_RETRY_BASE_DELAY_MS
    int "WiFi retry base delay (milliseconds)"
    default 1000
    depends on ICLE_NETCTL_WIFI

config ICLE_NETCTL_WIFI_RETRY_MAX_DELAY_MS
    int "WiFi retry max delay (milliseconds)"
    default 10000
    depends on ICLE_NETCTL_WIFI

config ICLE_NETCTL_MAX_SUBSCRIBERS
    int "Max event subscribers"
    default 4

# ---------------------------------------------------------------
# Zephyr networking defaults
# ---------------------------------------------------------------

config NET_IPV6
    default n if ICLE_NETCTL

config NET_LOG
    default y if ICLE_NETCTL

config NET_MAX_CONTEXTS
    default 4 if ICLE_NETCTL

config NET_MGMT_EVENT_QUEUE_SIZE
    default 32 if ICLE_NETCTL

config NET_MGMT_EVENT_QUEUE_TIMEOUT
    default 10000 if ICLE_NETCTL

# DNS defaults
config DNS_RESOLVER_MAX_SERVERS
    default 2 if ICLE_NETCTL

config DNS_SERVER_IP_ADDRESSES
    default y if ICLE_NETCTL

config DNS_SERVER1
    default "8.8.8.8" if ICLE_NETCTL

config DNS_SERVER2
    default "8.8.4.4" if ICLE_NETCTL

config DNS_NUM_CONCUR_QUERIES
    default 2 if ICLE_NETCTL

config NET_SOCKETS_DNS_TIMEOUT
    default 10000 if ICLE_NETCTL

# ESP32 WiFi STA: auto-start DHCPv4 after association
config ESP32_WIFI_STA_AUTO_DHCPV4
    default y if ICLE_NETCTL_WIFI_STA

endif # ICLE_NETCTL
