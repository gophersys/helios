{
  "name": "devcontainer-mtib",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".devcontainer/mtib",
  "projectType": "application",
  "tags": ["type:devcontainer"],
  "implicitDependencies": ["devcontainer-base"],
  "targets": {
    "build": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "context": ".devcontainer/mtib",
        "file": ".devcontainer/mtib/Dockerfile",
        "platforms": ["linux/arm64"],
        "load": true,
        "push": false,
        "tags": ["containers.ad.corekinect.com/concord-devcontainer-mtib:latest"]
      }
    },
    "push": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "context": ".devcontainer/mtib",
        "file": ".devcontainer/mtib/Dockerfile",
        "platforms": ["linux/arm64"],
        "load": false,
        "push": true,
        "tags": ["containers.ad.corekinect.com/concord-devcontainer-mtib:latest"],
        "cache-from": ["type=registry,ref=containers.ad.corekinect.com/concord-devcontainer-mtib:cache"],
        "cache-to": ["type=registry,ref=containers.ad.corekinect.com/concord-devcontainer-mtib:cache,mode=max"]
      }
    }
  }
}
