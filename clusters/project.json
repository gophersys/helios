{
  "name": "clusters",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:infrastructure", "type:meta", "layer:clusters"],
  "targets": {
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh status",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/project.json",
        "{projectRoot}/**/*.sh",
        "{projectRoot}/**/*.yml",
        "{projectRoot}/**/*.yaml"
      ]
    },
    "new-cluster": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh new-cluster",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
