{
    "root": "embedded/test_app",
    "sourceRoot": "embedded/test_app/src",
    "projectType": "application",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "west build -p always -b {args.board} ."
          ],
          "cwd": "embedded/test_app"
        }
      },
      "flash": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "west flash"
          ],
          "cwd": "embedded/test_app"
        }
      },
      "monitor": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "west espressif monitor"
          ],
          "cwd": "embedded/test_app"
        }
      }
    }
  }
  