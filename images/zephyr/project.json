{
  "name": "images-zephyr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "images/zephyr",
  "sourceRoot": "images/zephyr",
  "projectType": "application",
  "tags": ["scope:shared", "type:container-image"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh build",
        "cwd": "images/zephyr"
      },
      "cache": false,
      "dependsOn": [
        { "projects": ["images-base"], "target": "build" }
      ]
    },
    "build-multi-arch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh build-multi-arch",
        "cwd": "images/zephyr"
      },
      "cache": false
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh push",
        "cwd": "images/zephyr"
      },
      "cache": false
    },
    "pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh pull",
        "cwd": "images/zephyr"
      },
      "cache": false
    },
    "inspect": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh inspect",
        "cwd": "images/zephyr"
      },
      "cache": false
    }
  }
}
