package accel_test_fw;

service AccelerometerTest {

    // RPC to initiate the accelerometer test
    rpc BeginTest(TestRequest) returns (TestResult);

}

message TestRequest {
    string testName = 1;             // Name or identifier for the test being run
    uint32 testDuration = 2;       // Duration for which the test should run (in seconds)
}

message TestResult {
    bool success = 1;                // If the test was successful or not
    string testName = 2;             // Name or identifier for the test run
    string detailedReport = 3;       // Verbose test result details
    uint64 timestamp = 4;          c // Timestamp of when the test was concluded
    repeated Fault faults = 5;       // List of detected faults during the test
}

message Fault {
    string description = 1;          // Description of the fault
    uint64 faultTimestamp = 2;       // Timestamp when the fault was detected
}