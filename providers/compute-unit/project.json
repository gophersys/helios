{
  "name": "providers-compute-unit",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "tags": ["scope:infrastructure", "type:provider", "layer:providers", "provider:contract"],
  "targets": {
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh status",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "info": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh info",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/ctl.sh",
        "{projectRoot}/contract.yaml",
        "{projectRoot}/README.md"
      ]
    }
  }
}
