{
  "name": "repository-scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": [
    "scope:monorepo",
    "type:shell"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh lint",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh test",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/**/*.sh",
        "{workspaceRoot}/**/*.bash",
        "{workspaceRoot}/.githooks/**",
        "{workspaceRoot}/.nxignore",
        "{workspaceRoot}/.ci/graph-roster.txt",
        "{workspaceRoot}/.ci/ctl.sh"
      ],
      "cache": false
    }
  }
}
