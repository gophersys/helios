{
  "name": "ci-devcontainer",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:shared", "type:ci-orchestration"],
  "targets": {
    "ci-.devcontainer-validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/ctl.sh",
        "{projectRoot}/smoke.sh",
        "{projectRoot}/project.json",
        "{projectRoot}/../ctl.sh",
        "{projectRoot}/../project.json",
        "{projectRoot}/../images/*/ctl.sh",
        "{projectRoot}/../images/*/Dockerfile",
        "{projectRoot}/../images/*/project.json"
      ]
    },
    "ci-.devcontainer-build-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh build-all",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "ci-.devcontainer-build-all-multi-arch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh build-all-multi-arch",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "ci-.devcontainer-push-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh push-all",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "ci-.devcontainer-smoke-test-all": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh smoke-test-all",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
