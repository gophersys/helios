{
  "name": "ci-libs",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:libs", "type:ci"],
  "targets": {
    "affected-gate-fast": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh affected-gate-fast",
