{
  "name": "ci",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".ci",
  "projectType": "application",
  "targets": {
    "apply": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl apply -f .ci/k8s/configmap.yaml",
          "kubectl apply -f .ci/k8s/nightly-cronjob.yaml"
        ]
      }
    },

    "delete": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl delete -f .ci/k8s/nightly-cronjob.yaml --ignore-not-found",
          "kubectl delete -f .ci/k8s/configmap.yaml --ignore-not-found"
        ]
      }
    },

    "status": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "echo '=== CronJobs ===' && kubectl get cronjobs -n devops -l app.kubernetes.io/component=ci -o wide",
          "echo '' && echo '=== Recent Jobs ===' && kubectl get jobs -n devops -l app.kubernetes.io/component=ci --sort-by=.metadata.creationTimestamp -o wide",
          "echo '' && echo '=== Pods ===' && kubectl get pods -n devops -l app.kubernetes.io/component=ci --sort-by=.metadata.creationTimestamp -o wide"
        ]
      }
    },

    "trigger": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl create job -n devops --from=cronjob/concord-ci-nightly ci-manual-$(date +%s)"
        ]
      }
    },

    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "kubectl logs -n devops -l app.kubernetes.io/component=ci -c ci-runner --tail=200 -f"
        ]
      }
    }
  },
  "tags": ["scope:ci"]
}
