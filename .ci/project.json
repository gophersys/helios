{
  "name": "ci-infrastructure",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["scope:infrastructure", "type:ci"],
  "targets": {
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh validate",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh status",
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "release-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./ctl.sh release-check",
        "cwd": "{projectRoot}"
      },
      "cache": false
    }
  }
}
