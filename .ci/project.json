{
  "name": "ci",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".ci",
  "projectType": "application",
  "targets": {
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["bash .ci/run pr"]
      }
    },

    "status": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["bash deploy/ci/ctl.sh status"]
      }
    },

    "logs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["bash deploy/ci/ctl.sh logs"]
      }
    }
  },
  "tags": ["scope:ci"]
}
