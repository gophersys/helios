#!/usr/bin/env bash
# .ci/run — Concord CI entry point.
#
# Usage:
#   ./.ci/run <pipeline>                    Run a full pipeline
#   ./.ci/run stage <stage> [args...]       Run a single stage
#   ./.ci/run list                          Show available pipelines/stages
#   ./.ci/run dry-run <pipeline>            Show what would run
#
# Pipelines:  pr, main, release, nightly
# Stages:     env-check, lint, typecheck, test, build, push, deploy, smoke
#
# This script works identically locally and in CI.
# CI providers just call: ./.ci/run <pipeline>
set -euo pipefail

CI_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$CI_DIR/.." && pwd)"
cd "$REPO_ROOT"

source "$CI_DIR/lib/log.sh"
source "$CI_DIR/lib/context.sh"

ACTION="${1:-help}"
shift || true

case "$ACTION" in

  # ── Run a pipeline ───────────────────────────────────────────────────────
  pr|main|release|nightly)
    log_stage "pipeline: $ACTION"
    ci_summary
    bash "$CI_DIR/pipelines/${ACTION}.sh" "$@"
    echo ""
    log_ok "pipeline '$ACTION' completed"
    ;;

  # ── Run a single stage ──────────────────────────────────────────────────
  stage)
    STAGE="${1:-}"
    shift || true
    if [[ -z "$STAGE" ]]; then
      log_err "Usage: ./.ci/run stage <name> [args...]"
      log_err "Stages: $(ls "$CI_DIR/stages/" | sed 's/.sh//g' | tr '\n' ' ')"
      exit 1
    fi
    if [[ ! -f "$CI_DIR/stages/${STAGE}.sh" ]]; then
      log_err "Unknown stage: $STAGE"
      log_err "Available: $(ls "$CI_DIR/stages/" | sed 's/.sh//g' | tr '\n' ' ')"
      exit 1
    fi
    ci_summary
    bash "$CI_DIR/stages/${STAGE}.sh" "$@"
    ;;

  # ── List everything ─────────────────────────────────────────────────────
  list)
    echo ""
    bold "Pipelines:"
    for f in "$CI_DIR"/pipelines/*.sh; do
      name=$(basename "$f" .sh)
      desc=$(head -3 "$f" | grep "^# Pipeline:" | sed 's/^# Pipeline: //' || echo "")
      printf "  %-12s %s\n" "$name" "$desc"
    done
    echo ""
    bold "Stages:"
    for f in "$CI_DIR"/stages/*.sh; do
      name=$(basename "$f" .sh)
      desc=$(head -3 "$f" | grep "^#" | tail -1 | sed 's/^# //' || echo "")
      printf "  %-12s %s\n" "$name" "$desc"
    done
    echo ""
    ;;

  # ── Dry run (show pipeline steps without executing) ─────────────────────
  dry-run)
    PIPELINE="${1:-pr}"
    if [[ ! -f "$CI_DIR/pipelines/${PIPELINE}.sh" ]]; then
      log_err "Unknown pipeline: $PIPELINE"
      exit 1
    fi
    bold "Dry run: $PIPELINE"
    ci_summary
    echo ""
    grep 'bash.*stages/' "$CI_DIR/pipelines/${PIPELINE}.sh" \
      | sed 's|.*stages/||; s|\.sh.*||; s|"||g' \
      | while read -r step; do
          echo "  → $step"
        done || true
    # If it calls other pipelines, show those too
    grep 'bash.*pipelines/' "$CI_DIR/pipelines/${PIPELINE}.sh" \
      | grep -v "^#" \
      | sed 's|.*pipelines/||; s|\.sh.*||; s|"||g' \
      | while read -r sub; do
          echo "  ↳ includes pipeline: $sub"
        done || true
    echo ""
    ;;

  # ── Help ────────────────────────────────────────────────────────────────
  help|--help|-h)
    echo "Usage: ./.ci/run <command>"
    echo ""
    echo "Commands:"
    echo "  pr             Run PR pipeline (lint, typecheck, test, build)"
    echo "  main           Run main-branch pipeline (PR + push + deploy staging)"
    echo "  release        Run release pipeline (promote staging → production)"
    echo "  nightly        Run full nightly sweep"
    echo "  stage <name>   Run a single stage"
    echo "  list           Show all pipelines and stages"
    echo "  dry-run <p>    Show what a pipeline would do"
    echo ""
    echo "Run locally: ./.ci/run pr"
    echo "Run in CI:   CI=true ./.ci/run main"
    ;;

  *)
    log_err "Unknown command: $ACTION"
    echo "Run './.ci/run help' for usage."
    exit 1
    ;;
esac
