# =============================================================================
# Concord — Repo-Level Dev Config
# =============================================================================
# This file is ONLY for repo-level dev concerns (devcontainer, host paths).
# It is NOT loaded by any service.
#
# Per-service config lives in each app's own .env:
#   apps/backend/http-api/.env
#   apps/backend/build-service/.env
#   apps/backend/git-poller/.env
#   apps/edge/mtib-server/.env
#   apps/frontend/app/.env
#   apps/validation/alpha/.env
#   apps/manufacturing/alpha/.env
#
# For running the dev compose stack (`nx start platform`), see:
#   deploy/development/.env.example
# =============================================================================

# Absolute host path to this repo. Docker-in-Docker needs the host path
# (not the container path) to bind-mount volumes correctly.
CONCORD_MONOREPO_ROOT=/path/to/concord

# Devcontainer sandbox mode (1 = enabled)
IS_SANDBOX=1
