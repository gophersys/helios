# Eden environment template — copy to `.env.<environment>` (e.g. `.env.development`) and fill in.
#
#   cp .env.example .env.development   # then edit; the real file is gitignored and NEVER committed
#
# `deploy local` loads `.env.development` into the process env AND seeds the values into the local
# REAL Vault (IOTEA-style), from which spawned agents resolve their credentials. The .example
# files (this one + `.env.<environment>.example`) are the ONLY env files tracked in git — they
# carry placeholders, never real values. See ADR-0022 + the secrets lib.

# ── Harness credentials (the agents authenticate with these) ────────────────────────────────
# Claude Code OAuth / setup token. CLAUDEADAPTER_LIVE_TOKEN is the same value, read by the
# agentsession claude adapter's gated live test.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDEADAPTER_LIVE_TOKEN=
# OpenRouter key for the Oh My Pi (omp) harness (model openrouter/deepseek/deepseek-v4-flash).
OPENROUTER_API_KEY=
# OpenAI / Codex key — add to enable the codex harness (currently parked, no adapter live test).
# OPENAI_API_KEY=

# ── Vault (the secrets backend; real Vault locally — official image, not -dev) ───────────────
VAULT_ADDR=http://127.0.0.1:8200
# Local bootstrap (userpass mode). Production uses a Kubernetes ServiceAccount + the Vault sidecar
# token at /vault/secrets/token instead of these.
VAULT_DEV_USERNAME=eden
VAULT_DEV_PASSWORD=

# ── Supporting services (stood up out-of-band by deploy-local) ───────────────────────────────
NATS_URL=nats://127.0.0.1:4222
# DATABASE_URL=postgres://eden:eden@127.0.0.1:5432/eden?sslmode=disable   # if Postgres DesiredStore is used

# ── Gateway (behind auth even locally) ───────────────────────────────────────────────────────
# Dev JWT signing secret for the gateway's auth (a real secret in .env.development; placeholder here).
EDEN_GATEWAY_JWT_SECRET=
