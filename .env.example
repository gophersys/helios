# =============================================================================
# Concord Platform — Environment Variables
# =============================================================================
# Copy to .env and fill in your values. This file is .gitignored.
# Docker Compose reads these for all development services.
# =============================================================================

# ── Git / Bitbucket ──────────────────────────────────────────────────────────
# SSH key for cloning firmware repos (base64-encoded private key)
# Generate: cat ~/.ssh/id_rsa | base64 -w0
# Leave empty if using SSH agent forwarding (recommended for dev)
BITBUCKET_SSH_KEY=
BITBUCKET_API_TOKEN=
BITBUCKET_EMAIL=you@corekinect.com

# ── Signing Keys (base64-encoded PEM) ────────────────────────────────────────
# Used by the build service to sign firmware. Leave empty to use
# the bench keys from the repo (seeded by prisma/seed.py).
BENCH_SIGNING_KEY=
ENGINEERING_SIGNING_KEY=
PRODUCTION_SIGNING_KEY=

# ── CoreCloud (Validation API) ───────────────────────────────────────────────
# Required for FUOTA testing and device validation against CoreCloud.
# Not needed for local development of the Concord platform itself.
VAL_1_0_API_KEY=
VAL_1_0_API_AUTH_SERVER_HOST_NAME=https://auth.office.corekinect.cloud:2013
VAL_1_0_API_REST_SERVER_HOST_NAME=https://val.office.corekinect.cloud:2018/api
VAL_1_0_API_AUTH_USERNAME=
VAL_1_0_API_AUTH_PASSWORD=

# ── CoreCloud (Validation DB — SSH tunnel) ───────────────────────────────────
# Only needed for direct DB queries during validation tests.
CORECLOUD_DB_ENV=VAL_1_0
VAL_1_0_DB_DRIVER=postgresql+psycopg2
VAL_1_0_DB_USER=concord_val
VAL_1_0_DB_PASS=
VAL_1_0_DB_HOST=validation.ad.corekinect.com
VAL_1_0_DB_PORT=5432
VAL_1_0_DB_NAME=test
VAL_1_0_SSH_HOST=concordserver01.ad.corekinect.com
VAL_1_0_SSH_PORT=22
VAL_1_0_SSH_USER=

# ── CoreCloud Auth (for user login) ─────────────────────────────────────────
AUTH_SERVER_URL=https://auth.office.corekinect.cloud:2013
AUTH_SERVER_API_KEY=

# ── MTIB Hardware (for validation test runs) ─────────────────────────────────
MTIB_HOST=10.4.45.33
MTIB_PORT=50053
DEVICE_ID=70B3D584C01E1FCC
DEVICE_SNR=0964
